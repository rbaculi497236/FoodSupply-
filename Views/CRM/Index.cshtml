@{
    ViewData["Title"] = "CRM";
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">
                <i class="bi bi-people"></i> Customer Relationship Management
            </h1>

            <p class="text-muted">
                Manage customers, sales orders, and billing.
            </p>
        </div>
    </div>

    <div class="row g-4">

        <!-- Customers -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h4>
                        <i class="bi bi-person-lines-fill"></i>
                        Customers
                    </h4>

                    <p class="text-muted">
                        Manage customer records.
                    </p>

                    <a asp-controller="Customers"
                       asp-action="Index"
                       class="btn btn-primary">
                        View Customers
                    </a>
                </div>
            </div>
        </div>

        <!-- Sales Orders -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h4>
                        <i class="bi bi-cart-check"></i>
                        Sales Orders
                    </h4>

                    <p class="text-muted">
                        Manage customer sales orders.
                    </p>

                    <a asp-controller="SalesOrders"
                       asp-action="Index"
                       class="btn btn-primary">
                        View Sales Orders
                    </a>
                </div>
            </div>
        </div>

        <!-- Billing -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h4>
                        <i class="bi bi-receipt"></i>
                        Billing
                    </h4>

                    <p class="text-muted">
                        Manage invoices and billing.
                    </p>

                    <a asp-controller="Billings"
                       asp-action="Index"
                       class="btn btn-primary">
                        View Billing
                    </a>
                </div>
            </div>
        </div>

    </div>

</div>