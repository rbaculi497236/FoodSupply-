@model IEnumerable<FoodSupply.Models.SalesOrder>

@{
ViewData["Title"] = "Archived Sales Orders";
}

<div class="container-fluid">

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h1 class="fw-bold mb-1">
            <i class="bi bi-archive-fill text-warning me-2"></i>
            Archived Sales Orders
        </h1>

        <p class="text-muted mb-0">
            View and restore archived sales orders
        </p>
    </div>

    <a asp-action="Index"
       class="btn btn-primary">
        <i class="bi bi-arrow-left me-1"></i>
        Back to Sales Orders
    </a>

</div>

<!-- Archived Orders Table -->
<div class="card shadow-sm border-0">

    <div class="card-header bg-warning text-dark">
        <h5 class="mb-0">
            <i class="bi bi-archive me-2"></i>
            Archived Orders
        </h5>
    </div>

    <div class="card-body p-0">

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Order #</th>
                            <th>Customer</th>
                            <th>Order Date</th>
                            <th>Status</th>
                            <th>Items</th>
                            <th>Total Amount</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var order in Model)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        #@order.Id
                                    </strong>
                                </td>

                                <td>
                                    @if (order.Customer != null)
                                    {
                                        @order.Customer.CustomerName
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Unknown Customer
                                        </span>
                                    }
                                </td>

                                <td>
                                    @order.OrderDate.ToString("MMM dd, yyyy")
                                    <br />
                                    <small class="text-muted">
                                        @order.OrderDate.ToString("hh:mm tt")
                                    </small>
                                </td>

                                <td>
                                    @if (order.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Pending
                                        </span>
                                    }
                                    else if (order.Status == "Completed")
                                    {
                                        <span class="badge bg-success">
                                            Completed
                                        </span>
                                    }
                                    else if (order.Status == "Cancelled")
                                    {
                                        <span class="badge bg-danger">
                                            Cancelled
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @order.Status
                                        </span>
                                    }
                                </td>

                                <td>
                                    <span class="badge bg-secondary">
                                        @(order.SalesOrderItems?.Count ?? 0)
                                    </span>
                                </td>

                                <td>
                                    <strong>
                                        ₱@order.TotalAmount.ToString("N2")
                                    </strong>
                                </td>

                                <td class="text-center">

                                    <div class="d-flex justify-content-center gap-2">

                                        <!-- Details -->
                                        <a asp-action="Details"
                                           asp-route-id="@order.Id"
                                           class="btn btn-sm btn-outline-primary"
                                           title="View Details">
                                            <i class="bi bi-eye"></i>
                                            Details
                                        </a>

                                        <!-- Restore -->
                                        <form asp-action="Restore"
                                              asp-route-id="@order.Id"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-success"
                                                    onclick="return confirm('Are you sure you want to restore Sales Order #@order.Id?');"
                                                    title="Restore Order">

                                                <i class="bi bi-arrow-counterclockwise"></i>
                                                Restore

                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="text-center py-5">

                <i class="bi bi-archive display-4 text-muted"></i>

                <h4 class="mt-3">
                    No Archived Sales Orders
                </h4>

                <p class="text-muted">
                    There are currently no archived sales orders.
                </p>

                <a asp-action="Index"
                   class="btn btn-primary">
                    <i class="bi bi-arrow-left me-1"></i>
                    Back to Sales Orders
                </a>

            </div>
        }

    </div>

</div>`

</div>
