@model FoodSupply.Models.SalesOrder

@{
    ViewData["Title"] = "Archive Sales Order";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">
                <i class="bi bi-archive-fill text-warning me-2"></i>
                Archive Sales Order
            </h1>

            <p class="text-muted mb-0">
                Confirm that you want to archive this sales order.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Sales Orders
        </a>
    </div>

    <div class="card shadow-sm border-0">

        <div class="card-header bg-warning text-dark">
            <h5 class="mb-0">
                <i class="bi bi-archive me-2"></i>
                Sales Order #@Model.Id
            </h5>
        </div>

        <div class="card-body">

            <div class="row mb-4">

                <div class="col-md-6">
                    <strong>Customer:</strong>
                    <p class="mb-0">
                        @(Model.Customer?.CustomerName ?? "Unknown Customer")
                    </p>
                </div>

                <div class="col-md-6">
                    <strong>Order Date:</strong>
                    <p class="mb-0">
                        @Model.OrderDate.ToString("MMM dd, yyyy hh:mm tt")
                    </p>
                </div>

            </div>

            <div class="row mb-4">

                <div class="col-md-6">
                    <strong>Status:</strong>
                    <p class="mb-0">
                        <span class="badge bg-secondary">
                            @Model.Status
                        </span>
                    </p>
                </div>

                <div class="col-md-6">
                    <strong>Total Amount:</strong>
                    <p class="mb-0">
                        <strong>
                            ₱@Model.TotalAmount.ToString("N2")
                        </strong>
                    </p>
                </div>

            </div>

            <hr />

            <h5 class="mb-3">
                <i class="bi bi-cart me-2"></i>
                Order Items
            </h5>

            @if (Model.SalesOrderItems != null && Model.SalesOrderItems.Any())
            {
                <div class="table-responsive">

                    <table class="table table-bordered table-hover">

                        <thead class="table-dark">
                            <tr>
                                <th>Product</th>
                                <th>Quantity</th>
                                <th>Unit Price</th>
                                <th>Subtotal</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model.SalesOrderItems)
                            {
                                <tr>
                                    <td>
                                        @(item.Product?.ProductName ?? "Unknown Product")
                                    </td>

                                    <td>
                                        @item.Quantity
                                    </td>

                                    <td>
                                        ₱@item.UnitPrice.ToString("N2")
                                    </td>

                                    <td>
                                        ₱@item.Subtotal.ToString("N2")
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="alert alert-info">
                    No order items found.
                </div>
            }

            <div class="alert alert-warning mt-4">

                <i class="bi bi-exclamation-triangle-fill me-2"></i>

                <strong>Are you sure?</strong>

                <p class="mb-0 mt-1">
                    This will archive Sales Order #@Model.Id.
                    The sales order will not be deleted and can be restored
                    from the Archived Sales Orders page.
                </p>

            </div>

            <div class="d-flex gap-2">

                <form asp-action="ArchiveConfirmed"
                      asp-route-id="@Model.Id"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-warning"
                            onclick="return confirm('Are you sure you want to archive Sales Order #@Model.Id?');">

                        <i class="bi bi-archive me-1"></i>
                        Confirm Archive

                    </button>

                </form>

                <a asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="btn btn-info">

                    <i class="bi bi-eye me-1"></i>
                    View Details

                </a>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    <i class="bi bi-x-circle me-1"></i>
                    Cancel

                </a>

            </div>

        </div>

    </div>

</div>