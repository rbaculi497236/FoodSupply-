@model FoodSupply.Models.SalesOrder

@{
    ViewData["Title"] = "Sales Order Details";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">
                <i class="bi bi-receipt text-primary me-2"></i>
                Sales Order Details
            </h1>

            <p class="text-muted mb-0">
                Sales Order #@Model.Id
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">

                <i class="bi bi-pencil me-1"></i>
                Edit

            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-1"></i>
                Back to Sales Orders

            </a>

        </div>

    </div>


    <!-- Order Information -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white py-3">

            <h5 class="mb-0 fw-semibold">

                <i class="bi bi-file-earmark-text me-2"></i>
                Order Information

            </h5>

        </div>


        <div class="card-body">

            <div class="row g-4">

                <!-- Order Number -->
                <div class="col-md-3">

                    <div class="text-muted small">
                        Sales Order
                    </div>

                    <div class="fw-bold fs-5">
                        #@Model.Id
                    </div>

                </div>


                <!-- Customer -->
                <div class="col-md-3">

                    <div class="text-muted small">
                        Customer
                    </div>

                    <div class="fw-semibold">

                        @if (Model.Customer != null)
                        {
                            @Model.Customer.CustomerName
                        }
                        else
                        {
                            <span class="text-muted">
                                No Customer
                            </span>
                        }

                    </div>

                </div>


                <!-- Order Date -->
                <div class="col-md-3">

                    <div class="text-muted small">
                        Order Date
                    </div>

                    <div class="fw-semibold">

                        @Model.OrderDate.ToString("MMM dd, yyyy")

                        <br />

                        <small class="text-muted">
                            @Model.OrderDate.ToString("hh:mm tt")
                        </small>

                    </div>

                </div>


                <!-- Status -->
                <div class="col-md-3">

                    <div class="text-muted small mb-1">
                        Status
                    </div>

                    @if (Model.Status == "Pending")
                    {
                        <span class="badge bg-warning text-dark fs-6">
                            Pending
                        </span>
                    }
                    else if (Model.Status == "Confirmed")
                    {
                        <span class="badge bg-primary fs-6">
                            Confirmed
                        </span>
                    }
                    else if (Model.Status == "Completed")
                    {
                        <span class="badge bg-success fs-6">
                            Completed
                        </span>
                    }
                    else if (Model.Status == "Cancelled")
                    {
                        <span class="badge bg-danger fs-6">
                            Cancelled
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary fs-6">
                            @Model.Status
                        </span>
                    }

                </div>

            </div>


            @if (!string.IsNullOrWhiteSpace(Model.Remarks))
            {
                <hr class="my-4" />

                <div>

                    <div class="text-muted small mb-1">
                        Remarks
                    </div>

                    <div>
                        @Model.Remarks
                    </div>

                </div>
            }

        </div>

    </div>


    <!-- Products -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white py-3">

            <h5 class="mb-0 fw-semibold">

                <i class="bi bi-box-seam me-2"></i>
                Ordered Products

            </h5>

        </div>


        <div class="card-body p-0">

            @if (Model.SalesOrderItems != null &&
                 Model.SalesOrderItems.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="px-4">
                                    #
                                </th>

                                <th>
                                    Product
                                </th>

                                <th>
                                    Product Code
                                </th>

                                <th class="text-center">
                                    Quantity
                                </th>

                                <th class="text-end">
                                    Unit Price
                                </th>

                                <th class="text-end px-4">
                                    Subtotal
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @{
                                var itemNumber = 1;
                            }

                            @foreach (var item in Model.SalesOrderItems)
                            {
                                <tr>

                                    <!-- Number -->
                                    <td class="px-4 fw-semibold">
                                        @itemNumber
                                    </td>


                                    <!-- Product -->
                                    <td>

                                        @if (item.Product != null)
                                        {
                                            <div class="fw-semibold">
                                                @item.Product.ProductName
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(
                                                item.Product.Unit))
                                            {
                                                <small class="text-muted">
                                                    Unit:
                                                    @item.Product.Unit
                                                </small>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Product unavailable
                                            </span>
                                        }

                                    </td>


                                    <!-- Product Code -->
                                    <td>

                                        @if (item.Product != null)
                                        {
                                            <span class="badge bg-light text-dark border">
                                                @item.Product.ProductCode
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>


                                    <!-- Quantity -->
                                    <td class="text-center">

                                        <span class="badge bg-secondary">
                                            @item.Quantity
                                        </span>

                                    </td>


                                    <!-- Unit Price -->
                                    <td class="text-end">

                                        ₱@item.UnitPrice.ToString("N2")

                                    </td>


                                    <!-- Subtotal -->
                                    <td class="text-end px-4 fw-semibold">

                                        ₱@item.Subtotal.ToString("N2")

                                    </td>

                                </tr>

                                itemNumber++;
                            }

                        </tbody>


                        <!-- Total -->
                        <tfoot>

                            <tr>

                                <th colspan="5"
                                    class="text-end py-3">

                                    Total Amount

                                </th>

                                <th class="text-end px-4 py-3 text-primary fs-5">

                                    ₱@Model.TotalAmount.ToString("N2")

                                </th>

                            </tr>

                        </tfoot>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-box-seam display-4 text-muted"></i>

                    <h5 class="mt-3">
                        No Products
                    </h5>

                    <p class="text-muted mb-0">
                        This sales order does not contain any products.
                    </p>

                </div>
            }

        </div>

    </div>


    <!-- Summary -->
    <div class="row justify-content-end">

        <div class="col-md-5 col-lg-4">

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <div class="d-flex justify-content-between mb-2">

                        <span class="text-muted">
                            Number of Products
                        </span>

                        <strong>
                            @(Model.SalesOrderItems?.Count ?? 0)
                        </strong>

                    </div>


                    <div class="d-flex justify-content-between mb-2">

                        <span class="text-muted">
                            Total Quantity
                        </span>

                        <strong>
                            @(Model.SalesOrderItems?
                                .Sum(i => i.Quantity) ?? 0)
                        </strong>

                    </div>


                    <hr />


                    <div class="d-flex justify-content-between align-items-center">

                        <span class="fw-semibold">
                            Total Amount
                        </span>

                        <span class="fw-bold fs-4 text-primary">
                            ₱@Model.TotalAmount.ToString("N2")
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>