@model IEnumerable<FoodSupply.Models.SalesOrder>

@{
    ViewData["Title"] = "Sales Orders";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">
                <i class="bi bi-cart-check-fill text-primary me-2"></i>
                Sales Orders
            </h1>

            <p class="text-muted mb-0">
                Manage customer sales orders
            </p>
        </div>

        <!-- Header Buttons -->
        <div class="d-flex gap-2">

            <!-- Archived -->
            <a asp-action="Archived"
               class="btn btn-outline-warning">
                <i class="bi bi-archive me-1"></i>
                Archived
            </a>

            <!-- Create -->
            <a asp-action="Create"
               class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i>
                Create Sales Order
            </a>

        </div>
    </div>

    @await Html.PartialAsync("_TableTools")

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle me-2"></i>

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    <!-- Sales Orders Table -->
    <div class="card shadow-sm border-0">

        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-semibold">
                Sales Order List
            </h5>
        </div>

        <div class="card-body p-0">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th class="px-4">#</th>
                                <th>Customer</th>
                                <th>Order Date</th>
                                <th>Items</th>
                                <th>Total Amount</th>
                                <th>Status</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var order in Model)
                            {
                                <tr>

                                    <!-- Order ID -->
                                    <td class="px-4 fw-semibold">
                                        #@order.Id
                                    </td>

                                    <!-- Customer -->
                                    <td>
                                        @if (order.Customer != null)
                                        {
                                            <span>
                                                @order.Customer.CustomerName
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No Customer
                                            </span>
                                        }
                                    </td>

                                    <!-- Order Date -->
                                    <td>
                                        @order.OrderDate.ToString("MMM dd, yyyy")
                                        <br />
                                        <small class="text-muted">
                                            @order.OrderDate.ToString("hh:mm tt")
                                        </small>
                                    </td>

                                    <!-- Items -->
                                    <td>
                                        <span class="badge bg-secondary">
                                            @(order.SalesOrderItems?.Count ?? 0)
                                            item(s)
                                        </span>
                                    </td>

                                    <!-- Total Amount -->
                                    <td class="fw-semibold">
                                        ₱@order.TotalAmount.ToString("N2")
                                    </td>

                                    <!-- Status -->
                                    <td>
                                        @if (order.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }
                                        else if (order.Status == "Confirmed")
                                        {
                                            <span class="badge bg-primary">
                                                Confirmed
                                            </span>
                                        }
                                        else if (order.Status == "Completed")
                                        {
                                            <span class="badge bg-success">
                                                Completed
                                            </span>
                                        }
                                        else if (order.Status == "Cancelled")
                                        {
                                            <span class="badge bg-danger">
                                                Cancelled
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @order.Status
                                            </span>
                                        }
                                    </td>

                                    <!-- Actions -->
                                    <td class="text-center">

                                        <div class="btn-group" role="group">

                                            <!-- View Details -->
                                            <a asp-action="Details"
                                               asp-route-id="@order.Id"
                                               class="btn btn-sm btn-outline-info"
                                               title="View Details">

                                                <i class="bi bi-eye"></i>

                                            </a>

                                            <!-- Edit -->
                                            <a asp-action="Edit"
                                               asp-route-id="@order.Id"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Edit">

                                                <i class="bi bi-pencil"></i>

                                            </a>

                                            <!-- Archive -->
                                            <a asp-action="Archive"
                                               asp-route-id="@order.Id"
                                               class="btn btn-sm btn-outline-warning"
                                               title="Archive">

                                                <i class="bi bi-archive"></i>

                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-cart-x display-4 text-muted"></i>

                    <h5 class="mt-3">
                        No Sales Orders Found
                    </h5>

                    <p class="text-muted">
                        There are currently no active sales orders.
                    </p>

                    <div class="d-flex justify-content-center gap-2">

                        <a asp-action="Archived"
                           class="btn btn-outline-warning">

                            <i class="bi bi-archive me-1"></i>
                            View Archived

                        </a>

                        <a asp-action="Create"
                           class="btn btn-primary">

                            <i class="bi bi-plus-circle me-1"></i>
                            Create Sales Order

                        </a>

                    </div>

                </div>
            }

        </div>
    </div>

</div>