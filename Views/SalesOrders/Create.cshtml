@model FoodSupply.Models.SalesOrder

@{
    ViewData["Title"] = "Create Sales Order";

    var products = ViewBag.Products as List<FoodSupply.Models.Product>
                   ?? new List<FoodSupply.Models.Product>();
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">
                <i class="bi bi-cart-plus text-primary me-2"></i>
                Create Sales Order
            </h1>

            <p class="text-muted mb-0">
                Create a new customer sales order
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Sales Orders

        </a>

    </div>


    <form asp-action="Create" method="post">

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger"></div>


        <!-- Order Information -->
        <div class="card shadow-sm border-0 mb-4">

            <div class="card-header bg-white py-3">

                <h5 class="mb-0 fw-semibold">
                    <i class="bi bi-file-earmark-text me-2"></i>
                    Order Information
                </h5>

            </div>

            <div class="card-body">

                <div class="row">

                    <!-- Customer -->
                    <div class="col-md-6">

                        <label asp-for="CustomerId"
                               class="form-label fw-semibold">
                            Customer
                        </label>

                        <select asp-for="CustomerId"
                                class="form-select"
                                asp-items="ViewBag.CustomerId">

                            <option value="">
                                -- Select Customer --
                            </option>

                        </select>

                        <span asp-validation-for="CustomerId"
                              class="text-danger"></span>

                    </div>


                    <!-- Status -->
                    <div class="col-md-6">

                        <label asp-for="Status"
                               class="form-label fw-semibold">
                            Status
                        </label>

                        <select asp-for="Status"
                                class="form-select">

                            <option value="Pending">
                                Pending
                            </option>

                            <option value="Confirmed">
                                Confirmed
                            </option>

                            <option value="Completed">
                                Completed
                            </option>

                            <option value="Cancelled">
                                Cancelled
                            </option>

                        </select>

                    </div>

                </div>


                <!-- Remarks -->
                <div class="mt-4">

                    <label asp-for="Remarks"
                           class="form-label fw-semibold">
                        Remarks
                    </label>

                    <textarea asp-for="Remarks"
                              class="form-control"
                              rows="3"
                              placeholder="Optional remarks..."></textarea>

                </div>

            </div>

        </div>


        <!-- Order Items -->
        <div class="card shadow-sm border-0 mb-4">

            <div class="card-header bg-white py-3">

                <div class="d-flex justify-content-between align-items-center">

                    <h5 class="mb-0 fw-semibold">
                        <i class="bi bi-box-seam me-2"></i>
                        Order Items
                    </h5>

                    <button type="button"
                            class="btn btn-primary btn-sm"
                            onclick="addItem()">

                        <i class="bi bi-plus-circle me-1"></i>
                        Add Product

                    </button>

                </div>

            </div>


            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-bordered align-middle"
                           id="itemsTable">

                        <thead class="table-light">

                            <tr>

                                <th style="width: 30%;">
                                    Product
                                </th>

                                <th style="width: 12%;">
                                    Available
                                </th>

                                <th style="width: 12%;">
                                    Quantity
                                </th>

                                <th style="width: 15%;">
                                    Unit Price
                                </th>

                                <th style="width: 15%;">
                                    Subtotal
                                </th>

                                <th style="width: 8%;"
                                    class="text-center">
                                    Action
                                </th>

                            </tr>

                        </thead>

                        <tbody id="itemsBody">

                        </tbody>

                    </table>

                </div>


                <!-- Empty message -->
                <div id="emptyMessage"
                     class="text-center text-muted py-4">

                    <i class="bi bi-cart-x fs-1"></i>

                    <p class="mb-0 mt-2">
                        No products added yet.
                    </p>

                    <small>
                        Click "Add Product" to add products.
                    </small>

                </div>


                <!-- Total -->
                <div class="d-flex justify-content-end mt-4">

                    <div class="text-end">

                        <div class="text-muted">
                            Total Amount
                        </div>

                        <h2 class="fw-bold text-primary mb-0">
                            ₱<span id="totalAmount">0.00</span>
                        </h2>

                    </div>

                </div>

            </div>

        </div>


        <!-- Buttons -->
        <div class="d-flex justify-content-end gap-2">

            <a asp-action="Index"
               class="btn btn-secondary">

                <i class="bi bi-x-circle me-1"></i>
                Cancel

            </a>

            <button type="submit"
                    class="btn btn-primary">

                <i class="bi bi-check-circle me-1"></i>
                Create Sales Order

            </button>

        </div>

    </form>

</div>


<script>

    let itemIndex = 0;

    const products = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(products.Select(p => new
        {
            id = p.Id,
            code = p.ProductCode,
            name = p.ProductName,
            price = p.Price,
            stock = p.StockQuantity
        }))
    );


    function addItem() {

        document.getElementById("emptyMessage").style.display = "none";

        const tbody = document.getElementById("itemsBody");

        const row = document.createElement("tr");

        row.setAttribute("data-index", itemIndex);

        let productOptions =
            '<option value="">-- Select Product --</option>';

        products.forEach(product => {

            productOptions += `
                <option value="${product.id}"
                        data-price="${product.price}"
                        data-stock="${product.stock}">
                    ${product.code} - ${product.name}
                </option>
            `;

        });


        row.innerHTML = `

            <td>

                <select name="SalesOrderItems[${itemIndex}].ProductId"
                        class="form-select product-select"
                        onchange="productChanged(this)"
                        required>

                    ${productOptions}

                </select>

            </td>


            <td>

                <span class="available-stock badge bg-secondary">
                    -
                </span>

            </td>


            <td>

                <input type="number"
                       name="SalesOrderItems[${itemIndex}].Quantity"
                       class="form-control quantity-input"
                       min="1"
                       value="1"
                       onchange="calculateRow(this)"
                       oninput="calculateRow(this)"
                       required />

            </td>


            <td>

                <input type="text"
                       class="form-control unit-price"
                       value="₱0.00"
                       readonly />

            </td>


            <td>

                <input type="text"
                       class="form-control subtotal"
                       value="₱0.00"
                       readonly />

            </td>


            <td class="text-center">

                <button type="button"
                        class="btn btn-sm btn-outline-danger"
                        onclick="removeItem(this)"
                        title="Remove Product">

                    <i class="bi bi-trash"></i>

                </button>

            </td>

        `;


        tbody.appendChild(row);

        itemIndex++;

    }


    function productChanged(select) {

        const row = select.closest("tr");

        const selectedOption =
            select.options[select.selectedIndex];

        const price =
            parseFloat(selectedOption.dataset.price || 0);

        const stock =
            parseInt(selectedOption.dataset.stock || 0);


        row.querySelector(".available-stock").textContent =
            stock;


        if (stock <= 0) {

            row.querySelector(".available-stock")
                .className = "available-stock badge bg-danger";

        }
        else {

            row.querySelector(".available-stock")
                .className = "available-stock badge bg-success";

        }


        row.querySelector(".unit-price").value =
            "₱" + price.toLocaleString(
                "en-PH",
                {
                    minimumFractionDigits: 2
                }
            );


        calculateRow(
            row.querySelector(".quantity-input")
        );

    }


    function calculateRow(input) {

        const row = input.closest("tr");

        const select =
            row.querySelector(".product-select");

        const selectedOption =
            select.options[select.selectedIndex];

        const price =
            parseFloat(selectedOption.dataset.price || 0);

        const quantity =
            parseInt(input.value || 0);


        const subtotal =
            price * quantity;


        row.querySelector(".subtotal").value =
            "₱" + subtotal.toLocaleString(
                "en-PH",
                {
                    minimumFractionDigits: 2
                }
            );


        calculateTotal();

    }


    function calculateTotal() {

        let total = 0;

        document
            .querySelectorAll("#itemsBody tr")
            .forEach(row => {

                const select =
                    row.querySelector(".product-select");

                const input =
                    row.querySelector(".quantity-input");

                if (!select || !input) {
                    return;
                }

                const selectedOption =
                    select.options[select.selectedIndex];

                const price =
                    parseFloat(
                        selectedOption.dataset.price || 0
                    );

                const quantity =
                    parseInt(input.value || 0);


                total += price * quantity;

            });


        document.getElementById("totalAmount")
            .textContent =
            total.toLocaleString(
                "en-PH",
                {
                    minimumFractionDigits: 2
                }
            );

    }


    function removeItem(button) {

        const row = button.closest("tr");

        row.remove();

        calculateTotal();


        if (
            document.querySelectorAll("#itemsBody tr").length === 0
        ) {

            document.getElementById("emptyMessage")
                .style.display = "block";

        }

    }

</script>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}