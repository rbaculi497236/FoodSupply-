@model FoodSupply.Models.Delivery

@{
    ViewData["Title"] = "Delivery Details";
}

<div class="container">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">
                <i class="bi bi-truck text-primary me-2"></i>
                Delivery #@Model.Id
            </h1>

            <p class="text-muted mb-0">
                Delivery details
            </p>
        </div>

        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Back
        </a>
    </div>

    <div class="card shadow-sm border-0">

        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                Delivery Information
            </h5>
        </div>

        <div class="card-body">

            <div class="row g-4">

                <div class="col-md-6">
                    <strong>Delivery #</strong>
                    <p>#@Model.Id</p>
                </div>

                <div class="col-md-6">
                    <strong>Sales Order</strong>
                    <p>#@Model.SalesOrderId</p>
                </div>

                <div class="col-md-6">
                    <strong>Customer</strong>
                    <p>
                        @(Model.SalesOrder?.Customer?.CustomerName ?? "Unknown Customer")
                    </p>
                </div>

                <div class="col-md-6">
                    <strong>Delivery Date</strong>
                    <p>
                        @Model.DeliveryDate.ToString("MMMM dd, yyyy hh:mm tt")
                    </p>
                </div>

                <div class="col-md-6">
                    <strong>Status</strong>
                    <p>
                        <span class="badge bg-primary">
                            @Model.Status
                        </span>
                    </p>
                </div>

                <div class="col-md-6">
                    <strong>Driver</strong>
                    <p>
                        @(Model.Driver ?? "Not Assigned")
                    </p>
                </div>

                <div class="col-md-6">
                    <strong>Vehicle</strong>
                    <p>
                        @(Model.Vehicle ?? "Not Assigned")
                    </p>
                </div>

                <div class="col-md-6">
                    <strong>Delivery Address</strong>
                    <p>
                        @(Model.DeliveryAddress ?? "Not Provided")
                    </p>
                </div>

                <div class="col-12">
                    <strong>Remarks</strong>
                    <p>
                        @(Model.Remarks ?? "No remarks")
                    </p>
                </div>

            </div>

            <hr />

            <div class="d-flex justify-content-end gap-2">

                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-secondary">
                    <i class="bi bi-pencil me-1"></i>
                    Edit
                </a>

                <a asp-action="Index"
                   class="btn btn-primary">
                    <i class="bi bi-arrow-left me-1"></i>
                    Back to Deliveries
                </a>

            </div>

        </div>
    </div>

</div>
