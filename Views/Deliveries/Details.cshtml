@model FoodSupply.Models.Delivery

@{
    ViewData["Title"] = "Delivery Details";

    var hasAddress = !string.IsNullOrWhiteSpace(Model.DeliveryAddress);

    var mapsUrl = hasAddress
        ? "https://www.google.com/maps/dir/?api=1&destination="
          + Uri.EscapeDataString(Model.DeliveryAddress!)
        : "#";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h1 class="fw-bold mb-1"
                style="color: #123D68;">

                <i class="bi bi-truck me-2"></i>

                Delivery #@Model.Id

            </h1>

            <p class="text-muted mb-0">
                Delivery details and customer route
            </p>

        </div>

        <a asp-action="Index"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left me-1"></i>

            Back

        </a>

    </div>


    <!-- Delivery Information -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header text-white"
             style="background-color: #123D68;">

            <h5 class="mb-0">

                <i class="bi bi-truck me-2"></i>

                Delivery Information

            </h5>

        </div>

        <div class="card-body">

            <div class="row g-4">

                <div class="col-md-6">

                    <strong>Delivery #</strong>

                    <p class="mb-0">
                        #@Model.Id
                    </p>

                </div>


                <div class="col-md-6">

                    <strong>Sales Order</strong>

                    <p class="mb-0">
                        #@Model.SalesOrderId
                    </p>

                </div>


                <div class="col-md-6">

                    <strong>Customer</strong>

                    <p class="mb-0">

                        @(Model.SalesOrder?.Customer?.CustomerName
                            ?? "Unknown Customer")

                    </p>

                </div>


                <div class="col-md-6">

                    <strong>Delivery Date</strong>

                    <p class="mb-0">

                        @Model.DeliveryDate.ToString(
                            "MMMM dd, yyyy hh:mm tt")

                    </p>

                </div>


                <div class="col-md-6">

                    <strong>Status</strong>

                    <p class="mb-0">

                        @if (Model.Status == "Pending")
                        {
                            <span class="badge bg-warning text-dark">
                                Pending
                            </span>
                        }
                        else if (Model.Status == "Out for Delivery")
                        {
                            <span class="badge bg-info text-dark">
                                Out for Delivery
                            </span>
                        }
                        else if (Model.Status == "Delivered")
                        {
                            <span class="badge bg-success">
                                Delivered
                            </span>
                        }
                        else if (Model.Status == "Cancelled")
                        {
                            <span class="badge bg-danger">
                                Cancelled
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                @Model.Status
                            </span>
                        }

                    </p>

                </div>


                <div class="col-md-6">

                    <strong>Driver</strong>

                    <p class="mb-0">

                        @(Model.Driver ?? "Not Assigned")

                    </p>

                </div>


                <div class="col-md-6">

                    <strong>Vehicle</strong>

                    <p class="mb-0">

                        @(Model.Vehicle ?? "Not Assigned")

                    </p>

                </div>


                <div class="col-md-6">

                    <strong>Delivery Address</strong>

                    <p class="mb-0">

                        @(Model.DeliveryAddress ?? "Not Provided")

                    </p>

                </div>


                <div class="col-12">

                    <strong>Remarks</strong>

                    <p class="mb-0">

                        @(Model.Remarks ?? "No remarks")

                    </p>

                </div>

            </div>

        </div>

    </div>


    <!-- Google Maps -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header text-white"
             style="background-color: #4B9B28;">

            <h5 class="mb-0">

                <i class="bi bi-geo-alt-fill me-2"></i>

                Delivery Location

            </h5>

        </div>

        <div class="card-body">

            @if (hasAddress)
            {
                <div class="row align-items-center">

                    <div class="col-md-8">

                        <h6 class="fw-bold">
                            Customer Destination
                        </h6>

                        <p class="text-muted mb-md-0">

                            <i class="bi bi-geo-alt me-1"></i>

                            @Model.DeliveryAddress

                        </p>

                    </div>

                    <div class="col-md-4 text-md-end">

                        <a href="@mapsUrl"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="btn"
                           style="background-color: #123D68;
                                  border-color: #123D68;
                                  color: white;">

                            <i class="bi bi-map me-1"></i>

                            View Route in Google Maps

                        </a>

                    </div>

                </div>
            }
            else
            {
                <div class="alert alert-warning mb-0">

                    <i class="bi bi-exclamation-triangle me-2"></i>

                    No delivery address has been provided.
                    A Google Maps route cannot be generated.

                </div>
            }

        </div>

    </div>


    <!-- Actions -->

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <div class="d-flex justify-content-end gap-2 flex-wrap">

                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-primary">

                    <i class="bi bi-pencil me-1"></i>

                    Edit

                </a>

                @if (hasAddress)
                {
                    <a href="@mapsUrl"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="btn"
                       style="background-color: #4B9B28;
                              border-color: #4B9B28;
                              color: white;">

                        <i class="bi bi-geo-alt-fill me-1"></i>

                        Open Route

                    </a>
                }

                <a asp-action="Index"
                   class="btn btn-primary">

                    <i class="bi bi-arrow-left me-1"></i>

                    Back to Deliveries

                </a>

            </div>

        </div>

    </div>

</div>