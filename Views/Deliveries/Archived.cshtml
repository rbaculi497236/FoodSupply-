@model IEnumerable<FoodSupply.Models.Delivery>

@{
    ViewData["Title"] = "Archived Deliveries";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">
                <i class="bi bi-archive-fill text-warning me-2"></i>
                Archived Deliveries
            </h1>

            <p class="text-muted mb-0">
                View and restore archived deliveries
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-primary">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Deliveries
        </a>

    </div>

    <div class="card shadow-sm border-0">

        <div class="card-header bg-warning text-dark">
            <h5 class="mb-0">
                <i class="bi bi-archive me-2"></i>
                Archived Deliveries
            </h5>
        </div>

        <div class="card-body p-0">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Delivery #</th>
                                <th>Sales Order</th>
                                <th>Customer</th>
                                <th>Delivery Date</th>
                                <th>Status</th>
                                <th>Driver</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var delivery in Model)
                            {
                                <tr>

                                    <td>
                                        <strong>#@delivery.Id</strong>
                                    </td>

                                    <td>
                                        #@delivery.SalesOrderId
                                    </td>

                                    <td>
                                        @(delivery.SalesOrder?.Customer?.CustomerName ?? "Unknown Customer")
                                    </td>

                                    <td>
                                        @delivery.DeliveryDate.ToString("MMM dd, yyyy")
                                    </td>

                                    <td>
                                        <span class="badge bg-secondary">
                                            @delivery.Status
                                        </span>
                                    </td>

                                    <td>
                                        @(delivery.Driver ?? "Not Assigned")
                                    </td>

                                    <td class="text-center">

                                        <div class="d-flex justify-content-center gap-2">

                                            <a asp-action="Details"
                                               asp-route-id="@delivery.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-eye"></i>
                                                Details
                                            </a>

                                            <form asp-action="Restore"
                                                  asp-route-id="@delivery.Id"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-success"
                                                        onclick="return confirm('Are you sure you want to restore Delivery #@delivery.Id?');">

                                                    <i class="bi bi-arrow-counterclockwise"></i>
                                                    Restore

                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-archive display-4 text-muted"></i>

                    <h4 class="mt-3">
                        No Archived Deliveries
                    </h4>

                    <p class="text-muted">
                        There are currently no archived deliveries.
                    </p>

                    <a asp-action="Index"
                       class="btn btn-primary">
                        <i class="bi bi-arrow-left me-1"></i>
                        Back to Deliveries
                    </a>

                </div>
            }

        </div>

    </div>

</div>
