@model FoodSupply.Models.LoginViewModel

@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - FoodSupply</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            min-height: 100vh;
            margin: 0;
            background: linear-gradient(135deg, #f4f8f5 0%, #e6f0e8 100%);
        }
        .login-shell {
            min-height: 100vh;
            padding: 32px 16px;
        }
        .login-card {
            width: 100%;
            max-width: 1040px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            overflow: hidden;
            border-radius: 24px;
            border: 1px solid #d8e4dc;
        }
        .login-form-panel { padding: 40px 48px; background: #fff; }
        .login-heading { margin: 48px 0 28px; }
        .login-heading h1 { color: #123d68; font-size: 1.8rem; font-weight: 700; }
        .login-options { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; font-size: .875rem; margin-bottom: 24px; }
        .login-actions { display: flex; gap: 12px; flex-wrap: wrap; }
        .login-actions .btn { flex: 1; padding: 11px 16px; white-space: nowrap; }
        .login-card .btn-outline-primary { color: #123d68; border-color: #123d68; }
        .login-card .btn-outline-primary:hover { color: #fff; background: #123d68; }
        .login-visual {
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            min-height: 600px;
            padding: 48px;
            color: #fff;
            text-align: center;
            background: radial-gradient(ellipse at top right, #4b9b28 0%, transparent 65%), linear-gradient(145deg, #194e43, #123d68);
        }
        .login-visual::before, .login-visual::after { content: ""; position: absolute; width: 360px; height: 360px; border: 1px solid #ffffff26; border-radius: 50%; pointer-events: none; }
        .login-visual::before { top: -160px; right: -100px; }
        .login-visual::after { bottom: -170px; left: -120px; width: 460px; height: 460px; }
        .visual-brand { position: relative; width: 100%; padding: 28px 24px; margin-bottom: 36px; background: #fff; border-radius: 20px; box-shadow: 0 20px 50px #08274040; }
        .visual-brand img { width: 100%; height: auto; }
        .login-visual h2 { font-size: 2rem; font-weight: 700; line-height: 1.25; }
        .login-visual p { color: #e0eee5; max-width: 300px; margin: 16px 0 0; }
        @@media (max-width: 767.98px) {
            .login-card { grid-template-columns: 1fr; max-width: 480px; }
            .login-form-panel { padding: 28px; }
            .login-heading { margin-top: 32px; }
            .login-visual { display: none; }
        }
        .brand-login {
            display: block;
            margin: 0;
            color: #123d68;
            font-size: 2rem;
            font-weight: 700;
            letter-spacing: -.04em;
        }
        .login-card .form-control:focus {
            border-color: #4b9b28;
            box-shadow: 0 0 0 .2rem rgba(75, 155, 40, .2);
        }
        .login-card .btn-primary {
            background-color: #123d68;
            border-color: #123d68;
        }
        .login-card .btn-primary:hover {
            background-color: #4b9b28;
            border-color: #4b9b28;
        }
    </style>
</head>
<body>

<div class="login-shell container d-flex justify-content-center align-items-center">

    <div class="card shadow login-card">
        <div class="login-form-panel">
        <div class="brand-login">FoodSupply</div>

        <div class="login-heading">
            <h1>Welcome back!</h1>
            <p class="text-muted mb-0">Sign in to your FoodSupply account.</p>
        </div>

        <div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    @TempData["Success"]
                </div>
            }

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <form asp-controller="Account"
                asp-action="Login"
                method="post">

                @Html.AntiForgeryToken()

                <!-- Username -->
                <div class="mb-3">

                    <label asp-for="Username" class="form-label">
                        Username
                    </label>

                    <input asp-for="Username"
                           autocomplete="username"
                           class="form-control"
                           placeholder="Enter username" />

                    <span asp-validation-for="Username"
                          class="text-danger">
                    </span>

                </div>

                <!-- Password -->
                <div class="mb-3">

                    <label asp-for="Password" class="form-label">
                        Password
                    </label>

                    <div class="input-group">

                        <input asp-for="Password"
                               autocomplete="current-password"
                               type="password"
                               class="form-control"
                               id="passwordInput"
                               placeholder="Enter password" />

                        <button type="button"
                                aria-label="Show password"
                                aria-pressed="false"
                                id="togglePasswordButton"
                                class="btn btn-outline-secondary"
                                onclick="togglePassword()">

                            <i class="bi bi-eye"
                               id="passwordIcon">
                            </i>

                        </button>

                    </div>

                    <span asp-validation-for="Password"
                          class="text-danger">
                    </span>

                </div>

                <!-- Remember Me -->
                <div class="login-options">
                <div class="form-check">

                    <input asp-for="RememberMe"
                           class="form-check-input" />

                    <label asp-for="RememberMe"
                           class="form-check-label">
                        Remember me
                    </label>

                </div>
                <a asp-controller="Account" asp-action="ForgotPassword">Forgot password?</a>
                </div>

                <!-- Login Button -->
                <div class="login-actions">
                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-box-arrow-in-right"></i>
                    Login

                </button>
                <a asp-controller="Account" asp-action="RegisterAdmin" class="btn btn-outline-primary">Create account</a>
                </div>

            </form>
            <p class="text-muted small mt-3 mb-0">Admin and manager registration. Staff accounts are created by your administrator.</p>

        </div>
        </div>
        <aside class="login-visual" aria-label="FoodSupply">
            <div class="visual-brand"><img src="~/images/foodsupply-logo.png" alt="FoodSupply ERP and CRM System" /></div>
            <h2>Your daily operations,<br />all in one place.</h2>
            <p>Manage inventory, orders and deliveries with FoodSupply.</p>
        </aside>
    </div>

</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
<script>

        function togglePassword() {

            const password =
                document.getElementById("passwordInput");

            const icon =
                document.getElementById("passwordIcon");
            const toggle = document.getElementById("togglePasswordButton");

            if (password.type === "password") {

                password.type = "text";
                toggle.setAttribute("aria-label", "Hide password");
                toggle.setAttribute("aria-pressed", "true");

                icon.classList.remove("bi-eye");
                icon.classList.add("bi-eye-slash");

            }
            else {

                password.type = "password";
                toggle.setAttribute("aria-label", "Show password");
                toggle.setAttribute("aria-pressed", "false");

                icon.classList.remove("bi-eye-slash");
                icon.classList.add("bi-eye");

            }
        }

</script>
</body>
</html>
