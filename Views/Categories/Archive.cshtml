@model FoodSupply.Models.Category

@{
    ViewData["Title"] = "Archive Category";
}

<div class="container-fluid">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">

                <i class="bi bi-archive-fill me-2"
                   style="color: #4B9B28;"></i>

                Archive Category

            </h1>

            <p class="text-muted mb-0">
                Confirm that you want to archive this category.
            </p>
        </div>


        <!-- Back to Categories -->
        <a asp-action="Index"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left me-1"></i>

            Back to Categories

        </a>

    </div>


    <!-- Category Information Card -->
    <div class="card shadow-sm border-0">

        <!-- Blue + Green Header -->
        <div class="card-header text-white"
             style="background: linear-gradient(135deg, #123D68, #4B9B28);">

            <h5 class="mb-0">

                <i class="bi bi-tags-fill me-2"></i>

                Category Information

            </h5>

        </div>


        <div class="card-body p-4">

            <!-- Warning -->
            <div class="alert alert-warning">

                <i class="bi bi-exclamation-triangle-fill me-2"></i>

                <strong>Are you sure?</strong>

                <p class="mb-0 mt-1">

                    This will archive the category

                    <strong>
                        @Model.CategoryName
                    </strong>.

                    The category will not be deleted and can be restored
                    from the Archived Categories page.

                </p>

            </div>


            <!-- Category Details -->
            <div class="row mb-4">

                <div class="col-md-6">

                    <strong>Category Code:</strong>

                    <p class="mb-0">
                        @Model.CategoryCode
                    </p>

                </div>


                <div class="col-md-6">

                    <strong>Category Name:</strong>

                    <p class="mb-0">
                        @Model.CategoryName
                    </p>

                </div>

            </div>


            <div class="row mb-4">

                <div class="col-md-6">

                    <strong>Description:</strong>

                    <p class="mb-0">
                        @(Model.Description ?? "-")
                    </p>

                </div>


                <div class="col-md-6">

                    <strong>Status:</strong>

                    <p class="mb-0">

                        @if (Model.Status == "Active")
                        {
                            <span class="badge bg-success">
                                Active
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                @Model.Status
                            </span>
                        }

                    </p>

                </div>

            </div>


            <hr />


            <!-- ACTION BUTTONS -->
            <div class="d-flex gap-2">

                <!-- Confirm Archive -->
                <form asp-action="ArchiveConfirmed"
                      asp-route-id="@Model.Id"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-success"
                            onclick="return confirm('Are you sure you want to archive category @Model.CategoryName?');">

                        <i class="bi bi-archive me-1"></i>

                        Confirm Archive

                    </button>

                </form>


                <!-- View Details -->
                <a asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary">

                    <i class="bi bi-eye me-1"></i>

                    View Details

                </a>


                <!-- Cancel -->
                <a asp-action="Index"
                   class="btn btn-secondary">

                    <i class="bi bi-x-circle me-1"></i>

                    Cancel

                </a>

            </div>

        </div>

    </div>

</div>