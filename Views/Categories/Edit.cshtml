@model FoodSupply.Models.Category

@{
    ViewData["Title"] = "Edit Category";
}

<div class="container mt-4">

    <div class="mb-4">
        <h1 class="fw-bold">
            <i class="bi bi-pencil-square text-warning me-2"></i>
            Edit Category
        </h1>

        <p class="text-muted">
            Update category information
        </p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <form asp-action="Edit">

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="CategoryCode"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="CategoryCode"
                               class="form-control" />

                        <span asp-validation-for="CategoryCode"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="CategoryName"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="CategoryName"
                               class="form-control" />

                        <span asp-validation-for="CategoryName"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-12 mb-3">

                        <label asp-for="Description"
                               class="form-label fw-semibold">
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="4"></textarea>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="Status"
                               class="form-label fw-semibold">
                        </label>

                        <select asp-for="Status"
                                class="form-select">

                            <option value="Active">
                                Active
                            </option>

                            <option value="Inactive">
                                Inactive
                            </option>

                        </select>

                    </div>

                </div>

                <div class="mt-3">

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-save me-1"></i>
                        Save Changes

                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary ms-2">

                        <i class="bi bi-arrow-left me-1"></i>
                        Back

                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}