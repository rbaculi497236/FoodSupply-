@model IEnumerable<FoodSupply.Models.Category>

@{
ViewData["Title"] = "Categories";
}

<div class="container mt-4">

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold">
            <i class="bi bi-tags-fill text-primary me-2"></i>
            Categories
        </h1>
        <p class="text-muted mb-0">
            Manage product categories
        </p>
    </div>

    <div>
        <a asp-action="Archived" class="btn btn-secondary me-2">
            <i class="bi bi-archive me-1"></i>
            Archived Categories
        </a>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Add Category
        </a>
    </div>
</div>

@await Html.PartialAsync("_TableTools")

<div class="card shadow-sm border-0">
    <div class="card-body">

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-tags display-4 text-muted"></i>

                <h5 class="mt-3">
                    No categories found
                </h5>

                <p class="text-muted">
                    Category records will appear here.
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Category Code</th>
                            <th>Category Name</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>

                                <td class="fw-semibold">
                                    @item.CategoryCode
                                </td>

                                <td>
                                    @item.CategoryName
                                </td>

                                <td>
                                    @(item.Description ?? "-")
                                </td>

                                <td>
                                    @if (item.Status == "Active")
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @item.Status
                                        </span>
                                    }
                                </td>

                                <td class="text-center">

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-info text-white">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-warning">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <a asp-action="Archive"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-danger">
                                        <i class="bi bi-archive"></i>
                                    </a>

                                </td>

                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        }

    </div>
</div>

</div>
