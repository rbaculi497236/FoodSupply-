@model FoodSupply.Models.CustomerConcern
@{ ViewData["Title"] = "Customer Concern Details"; }
<h1>Customer Concern Details</h1>
<div class="card card-body">
    <dl class="row">
        <dt class="col-sm-3">Customer</dt><dd class="col-sm-9">@Model.Customer?.CustomerName</dd>
        <dt class="col-sm-3">Concern type</dt><dd class="col-sm-9">@Model.ConcernType</dd>
        <dt class="col-sm-3">Subject</dt><dd class="col-sm-9">@Model.Subject</dd>
        <dt class="col-sm-3">Description</dt><dd class="col-sm-9 text-break">@Model.Description</dd>
        <dt class="col-sm-3">Priority</dt><dd class="col-sm-9">@Model.Priority</dd>
        <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd>
        <dt class="col-sm-3">Date reported</dt><dd class="col-sm-9">@Model.DateReported.ToString("MMM dd, yyyy HH:mm")</dd>
        <dt class="col-sm-3">Date resolved</dt><dd class="col-sm-9">@(Model.ResolvedDate?.ToString("MMM dd, yyyy HH:mm") ?? "—")</dd>
        <dt class="col-sm-3">Resolution</dt><dd class="col-sm-9 text-break">@(Model.Resolution ?? "—")</dd>
        <dt class="col-sm-3">Remarks</dt><dd class="col-sm-9 text-break">@(Model.Remarks ?? "—")</dd>
    </dl>
    <div>
        @if (!Model.IsArchived)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
        }
        <a asp-action="@(Model.IsArchived ? "Archived" : "Index")" class="btn btn-outline-secondary">Back to concerns</a>
    </div>
</div>
