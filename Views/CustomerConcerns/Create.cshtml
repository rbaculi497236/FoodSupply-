@model FoodSupply.Models.CustomerConcern
@{ ViewData["Title"] = "New Customer Concern"; }
<h1>New Customer Concern</h1>
<form asp-action="Create" method="post" class="card card-body">
    <partial name="_ConcernFields" model="Model" />
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save concern</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
