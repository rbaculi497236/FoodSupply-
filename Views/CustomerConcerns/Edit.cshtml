@model FoodSupply.Models.CustomerConcern
@{ ViewData["Title"] = "Edit Customer Concern"; }
<h1>Edit Customer Concern</h1>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card card-body">
    <input asp-for="Id" type="hidden" />
    <partial name="_ConcernFields" model="Model" />
    <label asp-for="Status" class="form-label mt-3"></label>
    <select asp-for="Status" class="form-select">
        <option>Pending</option><option>In Progress</option><option>Resolved</option>
    </select>
    <span asp-validation-for="Status" class="text-danger"></span>
    <label asp-for="Resolution" class="form-label mt-3"></label>
    <textarea asp-for="Resolution" class="form-control" rows="3"></textarea>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save changes</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
