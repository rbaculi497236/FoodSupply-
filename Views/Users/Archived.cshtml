@model IEnumerable<FoodSupply.Models.User>

@{
ViewData["Title"] = "Archived Users";
}

<div class="container mt-4">

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h1 class="fw-bold">
            <i class="bi bi-archive-fill text-secondary me-2"></i>
            Archived Users
        </h1>

        <p class="text-muted mb-0">
            View and restore archived FoodSupply users.
        </p>
    </div>

    <a asp-action="Index"
       class="btn btn-secondary">
        <i class="bi bi-arrow-left me-1"></i>
        Back to Users
    </a>

</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">

        <i class="bi bi-check-circle-fill me-2"></i>

        @TempData["Success"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}

<div class="card shadow-sm border-0">

    <div class="card-body p-0">

        @if (!Model.Any())
        {
            <div class="text-center py-5">

                <i class="bi bi-archive display-4 text-muted"></i>

                <h4 class="mt-3">
                    No Archived Users
                </h4>

                <p class="text-muted">
                    There are currently no archived users.
                </p>

                <a asp-action="Index"
                   class="btn btn-primary">

                    <i class="bi bi-people me-1"></i>
                    View Active Users

                </a>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>
                            <th>Full Name</th>
                            <th>Email</th>
                            <th>Username</th>
                            <th>Role</th>
                            <th>Archived Status</th>
                            <th>Created</th>
                            <th class="text-center">Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var user in Model)
                        {
                            <tr>

                                <td>
                                    <span class="fw-semibold">
                                        @user.FullName
                                    </span>
                                </td>

                                <td>
                                    @user.Email
                                </td>

                                <td>
                                    @user.Username
                                </td>

                                <td>
                                    <span class="badge bg-secondary">
                                        @user.Role
                                    </span>
                                </td>

                                <td>
                                    <span class="badge bg-danger">
                                        <i class="bi bi-archive me-1"></i>
                                        Archived
                                    </span>
                                </td>

                                <td>
                                    @user.CreatedAt.ToString("MMM dd, yyyy")
                                </td>

                                <td class="text-center">

                                    <form asp-action="Restore"
                                          asp-route-id="@user.Id"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to restore this user?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-success">

                                            <i class="bi bi-arrow-counterclockwise me-1"></i>
                                            Restore

                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>

</div>
