@model IEnumerable<FoodSupply.Models.User>

@{
ViewData["Title"] = "Users";
}

<div class="container mt-4">

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold">
            <i class="bi bi-people-fill text-primary me-2"></i>
            Users
        </h1>
        <p class="text-muted mb-0">
            Manage FoodSupply system users and their access roles.
        </p>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="Archived" class="btn btn-outline-secondary">
            <i class="bi bi-archive me-1"></i>
            Archived
        </a>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-person-plus-fill me-1"></i>
            Add User
        </a>
    </div>
</div>

@await Html.PartialAsync("_TableTools")

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["Success"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-body p-0">

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-people display-4 text-muted"></i>

                <h4 class="mt-3">No Users Found</h4>

                <p class="text-muted">
                    There are currently no active users.
                </p>

                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-person-plus me-1"></i>
                    Create First User
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Full Name</th>
                            <th>Email</th>
                            <th>Username</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var user in Model)
                        {
                            <tr>

                                <td>
                                    <div class="fw-semibold">
                                        @user.FullName
                                    </div>
                                </td>

                                <td>
                                    @user.Email
                                </td>

                                <td>
                                    <span class="text-muted">
                                        @user.Username
                                    </span>
                                </td>

                                <td>
                                    <span class="badge bg-primary">
                                        @user.Role
                                    </span>
                                </td>

                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle me-1"></i>
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            <i class="bi bi-x-circle me-1"></i>
                                            Inactive
                                        </span>
                                    }
                                </td>

                                <td>
                                    @user.CreatedAt.ToString("MMM dd, yyyy")
                                </td>

                                <td class="text-center">

                                    <div class="d-flex justify-content-center gap-1">

                                        <a asp-action="Edit"
                                           asp-route-id="@user.Id"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Edit User">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        <form asp-action="Archive"
                                              asp-route-id="@user.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to archive this user?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    title="Archive User">
                                                <i class="bi bi-archive"></i>
                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>
</div>

</div>
