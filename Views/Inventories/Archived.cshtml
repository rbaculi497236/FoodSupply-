@model IEnumerable<FoodSupply.Models.Inventory>

@{
    ViewData["Title"] = "Archived Inventory";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold mb-1" style="color: #123D68;">
            <i class="bi bi-archive-fill me-2"></i>
            Archived Inventory
        </h1>

        <p class="text-muted mb-0">
            View and restore archived inventory records
        </p>
    </div>

    <a asp-action="Index"
       class="btn btn-outline-primary">
        <i class="bi bi-arrow-left me-1"></i>
        Back to Inventory
    </a>
</div>

<div class="card shadow-sm border-0">

    <div class="card-header text-white"
         style="background-color: #123D68;">
        <h5 class="mb-0">
            <i class="bi bi-archive me-2"></i>
            Archived Records
        </h5>
    </div>

    <div class="card-body">

        @if (!Model.Any())
        {
            <div class="text-center py-5">

                <i class="bi bi-archive display-4 text-muted"></i>

                <h4 class="mt-3">
                    No archived inventory records
                </h4>

                <p class="text-muted mb-0">
                    Archived inventory records will appear here.
                </p>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Product</th>
                            <th>Stock Quantity</th>
                            <th>Reorder Level</th>
                            <th>Status</th>
                            <th>Last Updated</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <!-- Product -->
                                <td>
                                    <strong>
                                        @(item.Product?.ProductName ?? "Unknown Product")
                                    </strong>

                                    @if (item.Product != null)
                                    {
                                        <br />

                                        <small class="text-muted">
                                            @item.Product.ProductCode
                                        </small>
                                    }
                                </td>

                                <!-- Stock Quantity -->
                                <td>
                                    @item.StockQuantity
                                </td>

                                <!-- Reorder Level -->
                                <td>
                                    @item.ReorderLevel
                                </td>

                                <!-- Status -->
                                <td>
                                    <span class="badge"
                                          style="background-color: #6c757d;">
                                        Archived
                                    </span>
                                </td>

                                <!-- Last Updated -->
                                <td>
                                    @item.LastUpdated.ToString("MMM dd, yyyy hh:mm tt")
                                </td>

                                <!-- Actions -->
                                <td class="text-center">

                                    <div class="btn-group" role="group">

                                        <!-- Details -->
                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-info"
                                           title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <!-- Restore -->
                                        <form asp-action="Restore"
                                              asp-route-id="@item.Id"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-success"
                                                    title="Restore Inventory"
                                                    onclick="return confirm('Are you sure you want to restore this inventory record?');">

                                                <i class="bi bi-arrow-counterclockwise"></i>

                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>
    @await Html.PartialAsync("_Pagination")
</div>
