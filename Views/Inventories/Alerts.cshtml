@model IEnumerable<FoodSupply.Models.Inventory>
@{ ViewData["Title"] = "Inventory Alerts"; }
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-bell text-warning me-2"></i>Inventory Alerts</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to Inventory</a>
</div>
<div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Product</th><th>Stock</th><th>Expiration</th><th>Spoiled</th><th>Damaged</th><th>Alert</th></tr></thead><tbody>
@foreach (var item in Model)
{
    <tr><td>@item.Product?.ProductName</td><td>@item.StockQuantity / @item.ReorderLevel</td><td>@(item.ExpirationDate?.ToString("MMM dd, yyyy") ?? "-")</td><td>@item.SpoiledQuantity</td><td>@item.DamagedQuantity</td><td>
        @if (item.StockQuantity <= item.ReorderLevel) { <span class="badge bg-warning text-dark">Low stock</span> }
        @if (item.ExpirationDate.HasValue && item.ExpirationDate.Value.Date <= DateTime.Today.AddDays(30)) { <span class="badge bg-warning text-dark">Expiration</span> }
        @if (item.SpoiledQuantity > 0) { <span class="badge bg-danger">Spoilage</span> }
        @if (item.DamagedQuantity > 0) { <span class="badge bg-danger">Damage</span> }
    </td></tr>
}
</tbody></table></div>