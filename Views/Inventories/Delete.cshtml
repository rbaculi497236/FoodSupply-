@model FoodSupply.Models.Inventory

@{
    ViewData["Title"] = "Delete Inventory";
}

<div class="mb-4">
    <h1 class="fw-bold mb-1 text-danger">
        <i class="bi bi-trash-fill me-2"></i>
        Delete Inventory
    </h1>

    <p class="text-muted mb-0">
        Confirm inventory deletion
    </p>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">

        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            Are you sure you want to delete this inventory record?
            This action cannot be undone.
        </div>

        <div class="row">

            <div class="col-md-6 mb-3">
                <label class="text-muted">Product</label>
                <h5 class="fw-semibold">
                    @(Model.Product?.ProductName ?? "Unknown Product")
                </h5>
            </div>

            <div class="col-md-6 mb-3">
                <label class="text-muted">Product Code</label>
                <h5 class="fw-semibold">
                    @(Model.Product?.ProductCode ?? "N/A")
                </h5>
            </div>

            <div class="col-md-6 mb-3">
                <label class="text-muted">Stock Quantity</label>
                <h5 class="fw-semibold">
                    @Model.StockQuantity
                </h5>
            </div>

            <div class="col-md-6 mb-3">
                <label class="text-muted">Reorder Level</label>
                <h5 class="fw-semibold">
                    @Model.ReorderLevel
                </h5>
            </div>

            <div class="col-md-6 mb-3">
                <label class="text-muted">Stock Status</label>
                <h5 class="fw-semibold">
                    @Model.StockStatus
                </h5>
            </div>

        </div>

        <hr />

        <form asp-action="Delete" method="post">

            <input type="hidden" asp-for="Id" />

            <div class="d-flex justify-content-between mt-4">

                <a asp-action="Index"
                   class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-1"></i>
                    Cancel
                </a>

                <button type="submit"
                        class="btn btn-danger">
                    <i class="bi bi-trash me-1"></i>
                    Delete Inventory
                </button>

            </div>

        </form>

    </div>
</div>