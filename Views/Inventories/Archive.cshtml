@model FoodSupply.Models.Inventory

@{
    ViewData["Title"] = "Archive Inventory";
}

<div class="mb-4">
    <h1 class="fw-bold mb-1" style="color: #123D68;">
        <i class="bi bi-archive-fill me-2"></i>
        Archive Inventory
    </h1>

    <p class="text-muted mb-0">
        Confirm that you want to archive this inventory record.
    </p>
</div>

<div class="card shadow-sm border-0">

    <div class="card-header text-white"
         style="background-color: #123D68;">
        <h5 class="mb-0">
            <i class="bi bi-box-seam me-2"></i>
            Inventory Information
        </h5>
    </div>

    <div class="card-body p-4">

        <!-- Warning -->
        <div class="alert alert-warning border-0">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            <strong>Are you sure?</strong>

            You are about to archive this inventory record.
            The record will not be permanently deleted and can be restored
            from the Archived Inventory section.
        </div>

        <div class="row">

            <!-- Product -->
            <div class="col-md-6 mb-4">
                <label class="text-muted small fw-semibold">
                    Product
                </label>

                <h5 class="fw-semibold mb-0">
                    @(Model.Product?.ProductName ?? "Unknown Product")
                </h5>
            </div>

            <!-- Product Code -->
            <div class="col-md-6 mb-4">
                <label class="text-muted small fw-semibold">
                    Product Code
                </label>

                <h5 class="fw-semibold mb-0">
                    @(Model.Product?.ProductCode ?? "N/A")
                </h5>
            </div>

            <!-- Stock Quantity -->
            <div class="col-md-6 mb-4">
                <label class="text-muted small fw-semibold">
                    Stock Quantity
                </label>

                <h5 class="fw-semibold mb-0">
                    @Model.StockQuantity
                </h5>
            </div>

            <!-- Reorder Level -->
            <div class="col-md-6 mb-4">
                <label class="text-muted small fw-semibold">
                    Reorder Level
                </label>

                <h5 class="fw-semibold mb-0">
                    @Model.ReorderLevel
                </h5>
            </div>

            <!-- Stock Status -->
            <div class="col-md-6 mb-4">
                <label class="text-muted small fw-semibold">
                    Stock Status
                </label>

                <h5 class="fw-semibold mb-0">
                    @Model.StockStatus
                </h5>
            </div>

        </div>

        <hr />

        <!-- Actions -->
        <div class="d-flex justify-content-between align-items-center mt-4">

            <a asp-action="Index"
               class="btn btn-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Cancel
            </a>

            <form asp-action="ArchiveConfirmed"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn"
                        style="background-color: #4B9B28; border-color: #4B9B28; color: white;"
                        onclick="return confirm('Are you sure you want to archive this inventory record?');">

                    <i class="bi bi-archive-fill me-1"></i>
                    Confirm Archive

                </button>

            </form>

        </div>

    </div>
</div>