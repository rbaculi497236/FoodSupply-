@model FoodSupply.Models.Inventory
@{ ViewData["Title"] = "Inventory settings"; }
<h1>Inventory settings</h1>
<p>Stock changes, quarantine and expiry dates are managed per batch.</p>
<form asp-action="Edit" method="post" class="card card-body">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input asp-for="Id" type="hidden" /><input asp-for="ProductId" type="hidden" /><input asp-for="StockQuantity" type="hidden" />
    <p>Stock on hand: @Model.StockQuantity</p>
    <label asp-for="ReorderLevel"></label><input asp-for="ReorderLevel" type="number" min="0" class="form-control mb-3" />
    <button class="btn btn-primary">Save settings</button>
</form>
<a asp-controller="Operations" asp-action="Batches" asp-route-productId="@Model.ProductId" class="btn btn-outline-primary mt-3">Batches and stock history</a>
