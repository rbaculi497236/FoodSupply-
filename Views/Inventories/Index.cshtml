@model IEnumerable<FoodSupply.Models.Inventory>

@{
    ViewData["Title"] = "Inventory";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold mb-1" style="color: #123D68;">
            <i class="bi bi-box-seam-fill me-2"></i>
            Inventory
        </h1>

        <p class="text-muted mb-0">
            Monitor and manage product stock
        </p>
    </div>

    <div>
        <a asp-action="Archived"
           class="btn btn-outline-secondary me-2">
            <i class="bi bi-archive me-1"></i>
            Archived
        </a>

        <a asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Add Inventory
        </a>
    </div>
</div>

@await Html.PartialAsync("_TableTools")

<div class="card shadow-sm border-0">
    <div class="card-body">

        @if (!Model.Any())
        {
            <div class="text-center py-5">

                <i class="bi bi-box-seam display-4 text-muted"></i>

                <h4 class="mt-3">
                    No inventory records found
                </h4>

                <p class="text-muted">
                    Add an inventory record to start managing stock.
                </p>

                <a asp-action="Create"
                   class="btn btn-primary">
                    <i class="bi bi-plus-circle me-1"></i>
                    Add Inventory
                </a>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Product</th>
                            <th>Stock Quantity</th>
                            <th>Reorder Level</th>
                            <th>Status</th>
                            <th>Last Updated</th>
                            <th>Alerts</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <!-- Product -->
                                <td>
                                    <strong>
                                        @(item.Product?.ProductName ?? "Unknown Product")
                                    </strong>

                                    @if (item.Product != null)
                                    {
                                        <br />

                                        <small class="text-muted">
                                            @item.Product.ProductCode
                                        </small>
                                    }
                                </td>

                                <!-- Stock Quantity -->
                                <td>
                                    <strong>
                                        @item.StockQuantity
                                    </strong>
                                </td>

                                <!-- Reorder Level -->
                                <td>
                                    @item.ReorderLevel
                                </td>

                                <!-- Status -->
                                <td>

                                    @if (item.StockStatus == "In Stock")
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle me-1"></i>
                                            In Stock
                                        </span>
                                    }
                                    else if (item.StockStatus == "Low Stock")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-exclamation-triangle me-1"></i>
                                            Low Stock
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            <i class="bi bi-x-circle me-1"></i>
                                            Out of Stock
                                        </span>
                                    }

                                </td>

                                <!-- Last Updated -->
                                <td>
                                    @item.LastUpdated.ToString("MMM dd, yyyy hh:mm tt")
                                </td>

                                <!-- Alerts -->
                                <td>

                                    @if (item.ExpirationDate.HasValue &&
                                        item.ExpirationDate.Value.Date <= DateTime.Today.AddDays(30))
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-calendar-x me-1"></i>
                                            Expiring
                                        </span>
                                    }

                                    @if (item.SpoiledQuantity > 0)
                                    {
                                        <span class="badge bg-danger">
                                            <i class="bi bi-exclamation-octagon me-1"></i>
                                            Spoiled
                                        </span>
                                    }

                                    @if (item.DamagedQuantity > 0)
                                    {
                                        <span class="badge bg-danger">
                                            <i class="bi bi-box-seam me-1"></i>
                                            Damaged
                                        </span>
                                    }

                                </td>

                                <!-- Actions -->
                                <td class="text-center">

                                    <div class="btn-group" role="group">

                                        <!-- Details -->
                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-info"
                                           title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <!-- Edit -->
                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Edit Inventory">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <!-- Archive -->
                                        <a asp-action="Archive"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-warning"
                                           title="Archive Inventory">
                                            <i class="bi bi-archive"></i>
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>
</div>