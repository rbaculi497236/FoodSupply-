@model FoodSupply.Models.Purchase

@{
    ViewData["Title"] = "Purchase Details";
}

<!-- Success / Error Messages -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["Success"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["Error"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h1 class="fw-bold mb-1">
            <i class="bi bi-cart-check-fill text-primary me-2"></i>
            Purchase Details
        </h1>

        <p class="text-muted mb-0">
            View purchase order information and items
        </p>
    </div>

    <div class="d-flex gap-2">

        <!-- Edit button only for Pending purchases -->
        @if (Model.Status == "Pending")
        {
            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">

                <i class="bi bi-pencil me-1"></i>
                Edit

            </a>
        }

        <!-- Receive Purchase -->
        @if (Model.Status == "Pending" && Model.PurchaseItems.Any())
        {
            <form asp-action="Receive"
                  asp-route-id="@Model.Id"
                  method="post"
                  class="d-inline"
                  onsubmit="return confirm('Are you sure you want to receive this purchase? This will add the purchased quantities to inventory.');">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-success">

                    <i class="bi bi-box-seam me-1"></i>
                    Receive Purchase

                </button>

            </form>
        }

        <a asp-action="Index"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back

        </a>

    </div>
</div>


<!-- Purchase Information -->
<div class="card shadow-sm border-0 mb-4">

    <div class="card-body">

        <div class="row">

            <!-- Purchase Order Number -->
            <div class="col-md-6 mb-3">

                <label class="text-muted">
                    Purchase Order Number
                </label>

                <h5 class="fw-bold">
                    @Model.PurchaseOrderNumber
                </h5>

            </div>


            <!-- Supplier -->
            <div class="col-md-6 mb-3">

                <label class="text-muted">
                    Supplier
                </label>

                <h5 class="fw-bold">
                    @(Model.Supplier?.SupplierName ?? "Unknown Supplier")
                </h5>

            </div>


            <!-- Purchase Date -->
            <div class="col-md-6 mb-3">

                <label class="text-muted">
                    Purchase Date
                </label>

                <h5>
                    @Model.PurchaseDate.ToString("MMM dd, yyyy")
                </h5>

            </div>


            <!-- Status -->
            <div class="col-md-6 mb-3">

                <label class="text-muted">
                    Status
                </label>

                <div>

                    @if (Model.Status == "Pending")
                    {
                        <span class="badge bg-warning text-dark">

                            <i class="bi bi-clock me-1"></i>
                            Pending

                        </span>
                    }
                    else if (Model.Status == "Received")
                    {
                        <span class="badge bg-success">

                            <i class="bi bi-check-circle me-1"></i>
                            Received

                        </span>
                    }
                    else if (Model.Status == "Cancelled")
                    {
                        <span class="badge bg-danger">

                            <i class="bi bi-x-circle me-1"></i>
                            Cancelled

                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            @Model.Status
                        </span>
                    }

                </div>

            </div>


            <!-- Notes -->
            <div class="col-md-12 mb-3">

                <label class="text-muted">
                    Notes
                </label>

                <p class="mb-0">

                    @(string.IsNullOrWhiteSpace(Model.Notes)
                        ? "No notes"
                        : Model.Notes)

                </p>

            </div>

        </div>

    </div>

</div>


<!-- Purchase Items -->
<div class="card shadow-sm border-0">

    <div class="card-body">

        <!-- Purchase Items Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>

                <h4 class="fw-bold mb-1">

                    <i class="bi bi-box-seam me-2"></i>
                    Purchase Items

                </h4>

                <span class="badge bg-secondary">

                    @Model.PurchaseItems.Count item(s)

                </span>

            </div>


            <!-- Add Product only when Pending -->
            @if (Model.Status == "Pending")
            {
                <a asp-action="AddItem"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary">

                    <i class="bi bi-plus-circle me-1"></i>
                    Add Product

                </a>
            }

        </div>


        @if (!Model.PurchaseItems.Any())
        {
            <div class="text-center py-5">

                <i class="bi bi-box-seam display-4 text-muted"></i>

                <h5 class="mt-3">
                    No purchase items yet
                </h5>

                <p class="text-muted">
                    Add products to this purchase order.
                </p>


                @if (Model.Status == "Pending")
                {
                    <a asp-action="AddItem"
                       asp-route-id="@Model.Id"
                       class="btn btn-primary">

                        <i class="bi bi-plus-circle me-1"></i>
                        Add First Product

                    </a>
                }

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">

                        <tr>

                            <th>Product</th>
                            <th>Quantity</th>
                            <th>Unit Price</th>
                            <th>Subtotal</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model.PurchaseItems)
                        {
                            <tr>

                                <td>

                                    <strong>
                                        @(item.Product?.ProductName ?? "Unknown Product")
                                    </strong>

                                </td>

                                <td>
                                    @item.Quantity
                                </td>

                                <td>
                                    ₱@item.UnitPrice.ToString("N2")
                                </td>

                                <td>

                                    <strong>
                                        ₱@item.Subtotal.ToString("N2")
                                    </strong>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }


        <hr />


        <!-- Total -->
        <div class="d-flex justify-content-end">

            <div class="text-end">

                <small class="text-muted">
                    Total Amount
                </small>

                <h3 class="fw-bold text-primary">
                    ₱@Model.TotalAmount.ToString("N2")
                </h3>

            </div>

        </div>

    </div>

</div>