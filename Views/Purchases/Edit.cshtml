@model FoodSupply.Models.Purchase

@{
    ViewData["Title"] = "Edit Purchase";
}

<div class="mb-4">
    <h1 class="fw-bold mb-1">
        <i class="bi bi-pencil-square text-primary me-2"></i>
        Edit Purchase
    </h1>

    <p class="text-muted mb-0">
        Update purchase order information
    </p>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">

        <form asp-action="Edit" method="post">

            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="row">

                <!-- Purchase Order Number -->
                <div class="col-md-6 mb-3">

                    <label asp-for="PurchaseOrderNumber"
                           class="form-label fw-semibold">
                        Purchase Order Number
                    </label>

                    <input asp-for="PurchaseOrderNumber"
                           class="form-control" />

                    <span asp-validation-for="PurchaseOrderNumber"
                          class="text-danger">
                    </span>

                </div>

                <!-- Purchase Date -->
                <div class="col-md-6 mb-3">

                    <label asp-for="PurchaseDate"
                           class="form-label fw-semibold">
                        Purchase Date
                    </label>

                    <input asp-for="PurchaseDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="PurchaseDate"
                          class="text-danger">
                    </span>

                </div>

            </div>

            <!-- Supplier -->
            <div class="mb-3">

                <label asp-for="SupplierId"
                       class="form-label fw-semibold">
                    Supplier
                </label>

                <select asp-for="SupplierId"
                        class="form-select">

                    <option value="">
                        -- Select Supplier --
                    </option>

                    @foreach (var supplier in ViewBag.Suppliers)
                    {
                        <option value="@supplier.Id">
                            @supplier.SupplierCode -
                            @supplier.SupplierName
                        </option>
                    }

                </select>

                <span asp-validation-for="SupplierId"
                      class="text-danger">
                </span>

            </div>

            <!-- Status -->
            <div class="mb-3">

                <label asp-for="Status"
                       class="form-label fw-semibold">
                    Status
                </label>

                <select asp-for="Status"
                        class="form-select">

                    <option value="Pending">
                        Pending
                    </option>

                    <option value="Received">
                        Received
                    </option>

                    <option value="Cancelled">
                        Cancelled
                    </option>

                </select>

            </div>

            <!-- Notes -->
            <div class="mb-3">

                <label asp-for="Notes"
                       class="form-label fw-semibold">
                    Notes
                </label>

                <textarea asp-for="Notes"
                          class="form-control"
                          rows="4"
                          placeholder="Optional notes"></textarea>

                <span asp-validation-for="Notes"
                      class="text-danger">
                </span>

            </div>

            <!-- Total -->
            <div class="alert alert-light border">

                <div class="d-flex justify-content-between">

                    <span class="fw-semibold">
                        Current Total Amount
                    </span>

                    <strong class="text-primary">
                        ₱@Model.TotalAmount.ToString("N2")
                    </strong>

                </div>

            </div>

            <!-- Buttons -->
            <div class="d-flex justify-content-between mt-4">

                <a asp-action="Index"
                   class="btn btn-secondary">

                    <i class="bi bi-arrow-left me-1"></i>
                    Back

                </a>

                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-save me-1"></i>
                    Save Changes

                </button>

            </div>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}