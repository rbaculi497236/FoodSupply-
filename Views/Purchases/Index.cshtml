@model IEnumerable<FoodSupply.Models.Purchase>

@{
    ViewData["Title"] = "Purchases";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold mb-1">
            <i class="bi bi-cart-check-fill text-primary me-2"></i>
            Purchases
        </h1>

        <p class="text-muted mb-0">
            Manage purchase orders and supplier transactions
        </p>
    </div>

    <div>
        <a asp-action="Archived" class="btn btn-outline-warning me-2">
            <i class="bi bi-archive me-1"></i>
            Archived
        </a>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            New Purchase
        </a>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">

        @if (!Model.Any())
        {
            <div class="text-center py-5">

                <i class="bi bi-cart-x display-4 text-muted"></i>

                <h4 class="mt-3">
                    No purchase orders found
                </h4>

                <p class="text-muted">
                    Create a purchase order to start managing purchases.
                </p>

                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-1"></i>
                    New Purchase
                </a>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>PO Number</th>
                            <th>Supplier</th>
                            <th>Purchase Date</th>
                            <th>Total Amount</th>
                            <th>Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @item.PurchaseOrderNumber
                                    </strong>
                                </td>

                                <td>
                                    @(item.Supplier?.SupplierName ?? "Unknown Supplier")
                                </td>

                                <td>
                                    @item.PurchaseDate.ToString("MMM dd, yyyy")
                                </td>

                                <td>
                                    <strong>
                                        ₱@item.TotalAmount.ToString("N2")
                                    </strong>
                                </td>

                                <td>
                                    @if (item.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-clock me-1"></i>
                                            Pending
                                        </span>
                                    }
                                    else if (item.Status == "Received")
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle me-1"></i>
                                            Received
                                        </span>
                                    }
                                    else if (item.Status == "Cancelled")
                                    {
                                        <span class="badge bg-danger">
                                            <i class="bi bi-x-circle me-1"></i>
                                            Cancelled
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @item.Status
                                        </span>
                                    }
                                </td>

                                <td class="text-center">

                                    <div class="btn-group" role="group">

                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-info"
                                           title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <form asp-action="Archive"
                                              asp-route-id="@item.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to archive this purchase?');">

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-warning"
                                                    title="Archive">
                                                <i class="bi bi-archive"></i>
                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>
</div>