@model IEnumerable<FoodSupply.Models.Purchase>

@{
    ViewData["Title"] = "Archived Purchases";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold mb-1">
            <i class="bi bi-archive-fill text-warning me-2"></i>
            Archived Purchases
        </h1>

        <p class="text-muted mb-0">
            View and restore archived purchase orders
        </p>
    </div>

    <a asp-action="Index" class="btn btn-primary">
        <i class="bi bi-arrow-left me-1"></i>
        Back to Purchases
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">

        @if (!Model.Any())
        {
            <div class="text-center py-5">

                <i class="bi bi-archive display-4 text-muted"></i>

                <h4 class="mt-3">
                    No archived purchases
                </h4>

                <p class="text-muted">
                    Archived purchase orders will appear here.
                </p>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>PO Number</th>
                            <th>Supplier</th>
                            <th>Purchase Date</th>
                            <th>Total Amount</th>
                            <th>Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @item.PurchaseOrderNumber
                                    </strong>
                                </td>

                                <td>
                                    @(item.Supplier?.SupplierName ?? "Unknown Supplier")
                                </td>

                                <td>
                                    @item.PurchaseDate.ToString("MMM dd, yyyy")
                                </td>

                                <td>
                                    <strong>
                                        ₱@item.TotalAmount.ToString("N2")
                                    </strong>
                                </td>

                                <td>
                                    <span class="badge bg-secondary">
                                        <i class="bi bi-archive me-1"></i>
                                        Archived
                                    </span>
                                </td>

                                <td class="text-center">

                                    <div class="btn-group" role="group">

                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-info"
                                           title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <form asp-action="Restore"
                                              asp-route-id="@item.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to restore this purchase?');">

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-success"
                                                    title="Restore">
                                                <i class="bi bi-arrow-counterclockwise"></i>
                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>
</div>