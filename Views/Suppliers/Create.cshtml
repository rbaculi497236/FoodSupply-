@model FoodSupply.Models.Supplier

@{
ViewData["Title"] = "Add Supplier";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">
                <i class="bi bi-truck text-primary me-2"></i>
                Add Supplier
            </h1>
            <p class="text-muted mb-0">Add a new supplier to your system</p>
        </div>

    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>
        Back to Suppliers
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">

                <div class="col-md-6">
                    <label asp-for="SupplierName" class="form-label fw-semibold"></label>
                    <input asp-for="SupplierName" class="form-control"
                           placeholder="Enter supplier name" />
                    <span asp-validation-for="SupplierName" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ContactPerson" class="form-label fw-semibold"></label>
                    <input asp-for="ContactPerson" class="form-control"
                           placeholder="Enter contact person" />
                    <span asp-validation-for="ContactPerson" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
                    <input asp-for="PhoneNumber" class="form-control"
                           placeholder="e.g. 09171234567" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Email" class="form-label fw-semibold"></label>
                    <input asp-for="Email" class="form-control"
                           placeholder="supplier@example.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Status" class="form-label fw-semibold"></label>
                    <select asp-for="Status" class="form-select">
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Address" class="form-label fw-semibold"></label>
                    <textarea asp-for="Address" class="form-control"
                              rows="3"
                              placeholder="Enter supplier address"></textarea>
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>

            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle me-1"></i>
                    Cancel
                </a>

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-1"></i>
                    Add Supplier
                </button>
            </div>

        </form>

    </div>
</div>

</div>

@section Scripts {
@{
await Html.RenderPartialAsync("_ValidationScriptsPartial");
}
}
