@model IEnumerable<FoodSupply.Models.Supplier>

@{
    ViewData["Title"] = "Suppliers";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1" style="color: #123D68;">
                <i class="bi bi-truck me-2"></i>
                Suppliers
            </h1>

            <p class="text-muted mb-0">
                Manage supplier records
            </p>
        </div>

        <div>
            <a asp-action="Archived"
               class="btn btn-outline-secondary me-2">
                <i class="bi bi-archive me-1"></i>
                Archived
            </a>

            <a asp-action="Create"
               class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i>
                Add Supplier
            </a>
        </div>

    </div>

    @await Html.PartialAsync("_TableTools")

    <div class="card shadow-sm border-0">

        <div class="card-body p-0">

            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Code</th>
                                <th>Supplier Name</th>
                                <th>Contact Person</th>
                                <th>Phone</th>
                                <th>Email</th>
                                <th>Status</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var supplier in Model)
                            {
                                <tr>

                                    <!-- Supplier Code -->
                                    <td>
                                        <span class="fw-semibold">
                                            @supplier.SupplierCode
                                        </span>
                                    </td>

                                    <!-- Supplier Name -->
                                    <td>
                                        @supplier.SupplierName
                                    </td>

                                    <!-- Contact Person -->
                                    <td>
                                        @(string.IsNullOrWhiteSpace(supplier.ContactPerson)
                                            ? "—"
                                            : supplier.ContactPerson)
                                    </td>

                                    <!-- Phone -->
                                    <td>
                                        @(string.IsNullOrWhiteSpace(supplier.PhoneNumber)
                                            ? "—"
                                            : supplier.PhoneNumber)
                                    </td>

                                    <!-- Email -->
                                    <td>
                                        @(string.IsNullOrWhiteSpace(supplier.Email)
                                            ? "—"
                                            : supplier.Email)
                                    </td>

                                    <!-- Status -->
                                    <td>
                                        @if (supplier.Status == "Active")
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle me-1"></i>
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @supplier.Status
                                            </span>
                                        }
                                    </td>

                                    <!-- Actions -->
                                    <td class="text-center">

                                        <div class="btn-group" role="group">

                                            <!-- Details -->
                                            <a asp-action="Details"
                                               asp-route-id="@supplier.Id"
                                               class="btn btn-sm btn-outline-info"
                                               title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>

                                            <!-- Edit -->
                                            <a asp-action="Edit"
                                               asp-route-id="@supplier.Id"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Edit Supplier">
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            <!-- Archive -->
                                            <a asp-action="Archive"
                                               asp-route-id="@supplier.Id"
                                               class="btn btn-sm btn-outline-warning"
                                               title="Archive Supplier">
                                                <i class="bi bi-archive"></i>
                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-truck fs-1 text-muted"></i>

                    <h5 class="mt-3">
                        No suppliers found
                    </h5>

                    <p class="text-muted">
                        Add your first supplier to get started.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary">
                        <i class="bi bi-plus-circle me-1"></i>
                        Add Supplier
                    </a>

                </div>
            }

        </div>

    </div>

</div>