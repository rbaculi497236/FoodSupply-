@model FoodSupply.Models.Supplier

@{
ViewData["Title"] = "Supplier Details";
}

<div class="container py-4">

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold mb-1">
            <i class="bi bi-truck text-primary me-2"></i>
            Supplier Details
        </h1>
        <p class="text-muted mb-0">
            View complete supplier information
        </p>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>
        Back to Suppliers
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">

        <div class="row g-4">

            <div class="col-md-6">
                <div class="text-muted small">Supplier Code</div>
                <div class="fs-5 fw-semibold">
                    @Model.SupplierCode
                </div>
            </div>

            <div class="col-md-6">
                <div class="text-muted small">Supplier Name</div>
                <div class="fs-5 fw-semibold">
                    @Model.SupplierName
                </div>
            </div>

            <div class="col-md-6">
                <div class="text-muted small">Contact Person</div>
                <div class="fw-semibold">
                    @(string.IsNullOrWhiteSpace(Model.ContactPerson)
                        ? "—"
                        : Model.ContactPerson)
                </div>
            </div>

            <div class="col-md-6">
                <div class="text-muted small">Phone Number</div>
                <div class="fw-semibold">
                    @(string.IsNullOrWhiteSpace(Model.PhoneNumber)
                        ? "—"
                        : Model.PhoneNumber)
                </div>
            </div>

            <div class="col-md-6">
                <div class="text-muted small">Email</div>
                <div class="fw-semibold">
                    @(string.IsNullOrWhiteSpace(Model.Email)
                        ? "—"
                        : Model.Email)
                </div>
            </div>

            <div class="col-md-6">
                <div class="text-muted small">Status</div>

                @if (Model.Status == "Active")
                {
                    <span class="badge bg-success">
                        Active
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary">
                        @Model.Status
                    </span>
                }
            </div>

            <div class="col-12">
                <div class="text-muted small">Address</div>
                <div class="fw-semibold">
                    @(string.IsNullOrWhiteSpace(Model.Address)
                        ? "No address provided."
                        : Model.Address)
                </div>
            </div>

            <div class="col-12">
                <div class="text-muted small">Supplier ID</div>
                <div class="fw-semibold">
                    @Model.Id
                </div>
            </div>

        </div>

        <hr class="my-4" />

        <div class="d-flex justify-content-end gap-2">

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Back
            </a>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">
                <i class="bi bi-pencil-square me-1"></i>
                Edit Supplier
            </a>

            <a asp-action="Delete"
               asp-route-id="@Model.Id"
               class="btn btn-danger">
                <i class="bi bi-trash me-1"></i>
                Delete
            </a>

        </div>

    </div>
</div>

</div>
