@model FoodSupply.Models.Billing

@{
    ViewData["Title"] = "Invoice Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold">
            <i class="bi bi-receipt text-primary me-2"></i>
            @Model.InvoiceNumber
        </h1>
        <p class="text-muted mb-0">Invoice details and payment information</p>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-primary">
            <i class="bi bi-pencil me-1"></i>
            Update Payment
        </a>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Back
        </a>
    </div>
</div>

<div class="row g-4">

    <div class="col-md-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-primary text-white">
                <i class="bi bi-file-text me-2"></i>
                Invoice Information
            </div>

            <div class="card-body">
                <dl class="row mb-0">

                    <dt class="col-sm-5">Invoice Number</dt>
                    <dd class="col-sm-7 fw-semibold">
                        @Model.InvoiceNumber
                    </dd>

                    <dt class="col-sm-5">Sales Order</dt>
                    <dd class="col-sm-7">
                        #@Model.SalesOrderId
                    </dd>

                    <dt class="col-sm-5">Invoice Date</dt>
                    <dd class="col-sm-7">
                        @Model.InvoiceDate.ToString("MMMM dd, yyyy")
                    </dd>

                    <dt class="col-sm-5">Due Date</dt>
                    <dd class="col-sm-7">
                        @Model.DueDate.ToString("MMMM dd, yyyy")
                    </dd>

                    <dt class="col-sm-5">Total Amount</dt>
                    <dd class="col-sm-7 fw-bold">
                        ₱@Model.TotalAmount.ToString("N2")
                    </dd>

                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-success text-white">
                <i class="bi bi-cash-stack me-2"></i>
                Payment Information
            </div>

            <div class="card-body">
                <dl class="row mb-0">

                    <dt class="col-sm-5">Status</dt>
                    <dd class="col-sm-7">
                        @if (Model.PaymentStatus == "Paid")
                        {
                            <span class="badge bg-success">Paid</span>
                        }
                        else if (Model.PaymentStatus == "Partially Paid")
                        {
                            <span class="badge bg-warning text-dark">
                                Partially Paid
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Unpaid</span>
                        }
                    </dd>

                    <dt class="col-sm-5">Amount Paid</dt>
                    <dd class="col-sm-7">
                        ₱@Model.AmountPaid.ToString("N2")
                    </dd>

                    <dt class="col-sm-5">Balance</dt>
                    <dd class="col-sm-7 fw-bold">
                        ₱@Model.Balance.ToString("N2")
                    </dd>

                    <dt class="col-sm-5">Payment Date</dt>
                    <dd class="col-sm-7">
                        @(Model.PaymentDate?.ToString("MMMM dd, yyyy") ?? "—")
                    </dd>

                    <dt class="col-sm-5">Payment Method</dt>
                    <dd class="col-sm-7">
                        @(Model.PaymentMethod ?? "—")
                    </dd>

                </dl>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Remarks))
    {
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header">
                    <i class="bi bi-chat-left-text me-2"></i>
                    Remarks
                </div>

                <div class="card-body">
                    @Model.Remarks
                </div>
            </div>
        </div>
    }

</div>
