@model FoodSupply.Models.Billing

@{
    ViewData["Title"] = "Create Invoice";
}

<div class="mb-4">
    <h1 class="fw-bold">
        <i class="bi bi-receipt text-primary me-2"></i>
        Create Invoice
    </h1>

    <p class="text-muted">
        Create an invoice from a delivered Sales Order.
    </p>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">

        <form asp-action="Create" method="post">

            @Html.AntiForgeryToken()

            <!-- Show ALL validation errors -->
            <div asp-validation-summary="All"
                 class="alert alert-danger"></div>

            <!-- Sales Order -->
            <div class="mb-3">

                <label asp-for="SalesOrderId"
                       class="form-label fw-semibold">
                    Sales Order
                </label>

                <select asp-for="SalesOrderId"
                        class="form-select"
                        required>

                    <option value="">
                        -- Select Delivered Sales Order --
                    </option>

                    @if (ViewBag.SalesOrders != null)
                    {
                        foreach (var order in ViewBag.SalesOrders)
                        {
                            <option value="@order.Id">
                                Sales Order #@order.Id -
                                @order.OrderDate.ToString("MMM dd, yyyy") -
                                ₱@order.TotalAmount.ToString("N2")
                            </option>
                        }
                    }

                </select>

                <span asp-validation-for="SalesOrderId"
                      class="text-danger"></span>

                <div class="form-text">
                    Only Sales Orders with status
                    <strong>Delivered</strong>
                    can be billed.
                </div>

            </div>

            <!-- Due Date -->
            <div class="mb-3">

                <label asp-for="DueDate"
                       class="form-label fw-semibold">
                    Due Date
                </label>

                <input asp-for="DueDate"
                       type="date"
                       class="form-control" />

                <span asp-validation-for="DueDate"
                      class="text-danger"></span>

            </div>

            <!-- Remarks -->
            <div class="mb-3">

                <label asp-for="Remarks"
                       class="form-label fw-semibold">
                    Remarks
                </label>

                <textarea asp-for="Remarks"
                          class="form-control"
                          rows="3"
                          placeholder="Optional remarks"></textarea>

                <span asp-validation-for="Remarks"
                      class="text-danger"></span>

            </div>

            <!-- Information -->
            <div class="alert alert-info">

                <i class="bi bi-info-circle me-2"></i>

                The invoice number, total amount,
                payment status, and balance will be
                generated automatically.

            </div>

            <!-- Buttons -->
            <div class="d-flex justify-content-end gap-2">

                <a asp-action="Index"
                   class="btn btn-outline-secondary">

                    <i class="bi bi-arrow-left me-1"></i>
                    Cancel

                </a>

                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-check-circle me-1"></i>
                    Create Invoice

                </button>

            </div>

        </form>

    </div>
</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}