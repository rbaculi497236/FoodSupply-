@model IEnumerable<FoodSupply.Models.Billing>

@{
    ViewData["Title"] = "Billing";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold mb-1">
            <i class="bi bi-receipt text-primary me-2"></i>
            Billing
        </h1>
        <p class="text-muted mb-0">Manage invoices and payments</p>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="Archived" class="btn btn-outline-secondary">
            <i class="bi bi-archive me-1"></i> Archived
        </a>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Create Invoice
        </a>
    </div>
</div>

@await Html.PartialAsync("_TableTools")

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-receipt fs-1 text-muted"></i>
                <h5 class="mt-3">No invoices found</h5>
                <p class="text-muted">
                    Create an invoice from a delivered Sales Order.
                </p>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-1"></i>
                    Create Invoice
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Invoice</th>
                            <th>Sales Order</th>
                            <th>Invoice Date</th>
                            <th>Due Date</th>
                            <th>Total</th>
                            <th>Paid</th>
                            <th>Balance</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    @item.InvoiceNumber
                                </td>

                                <td>
                                    #@item.SalesOrderId
                                </td>

                                <td>
                                    @item.InvoiceDate.ToString("MMM dd, yyyy")
                                </td>

                                <td>
                                    @item.DueDate.ToString("MMM dd, yyyy")
                                </td>

                                <td>
                                    ₱@item.TotalAmount.ToString("N2")
                                </td>

                                <td>
                                    ₱@item.AmountPaid.ToString("N2")
                                </td>

                                <td class="fw-semibold">
                                    ₱@item.Balance.ToString("N2")
                                </td>

                                <td>
                                    @if (item.PaymentStatus == "Paid")
                                    {
                                        <span class="badge bg-success">
                                            Paid
                                        </span>
                                    }
                                    else if (item.PaymentStatus == "Partially Paid")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Partially Paid
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Unpaid
                                        </span>
                                    }
                                </td>

                                <td class="text-end">
                                    <div class="btn-group">
                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-secondary"
                                           title="Payment">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <a asp-action="Archive"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-danger"
                                           title="Archive">
                                            <i class="bi bi-archive"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
