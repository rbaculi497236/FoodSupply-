@model IEnumerable<FoodSupply.Models.Billing>

@{
    ViewData["Title"] = "Archived Billing";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold mb-1">
            <i class="bi bi-archive text-secondary me-2"></i>
            Archived Billing
        </h1>

        <p class="text-muted mb-0">
            View and restore archived invoices
        </p>
    </div>

    <a asp-action="Index"
       class="btn btn-outline-primary">
        <i class="bi bi-arrow-left me-1"></i>
        Active Billing
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-body">

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-archive fs-1 text-muted"></i>
                <h5 class="mt-3">No archived invoices</h5>
                <p class="text-muted">
                    Archived invoices will appear here.
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Invoice</th>
                            <th>Sales Order</th>
                            <th>Invoice Date</th>
                            <th>Total</th>
                            <th>Paid</th>
                            <th>Balance</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td class="fw-semibold">
                                    @item.InvoiceNumber
                                </td>

                                <td>
                                    #@item.SalesOrderId
                                </td>

                                <td>
                                    @item.InvoiceDate.ToString("MMM dd, yyyy")
                                </td>

                                <td>
                                    ₱@item.TotalAmount.ToString("N2")
                                </td>

                                <td>
                                    ₱@item.AmountPaid.ToString("N2")
                                </td>

                                <td>
                                    ₱@item.Balance.ToString("N2")
                                </td>

                                <td>
                                    @item.PaymentStatus
                                </td>

                                <td class="text-end">

                                    <div class="btn-group">

                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <form asp-action="Restore"
                                              asp-route-id="@item.Id"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-success">
                                                <i class="bi bi-arrow-counterclockwise"></i>
                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>
</div>
