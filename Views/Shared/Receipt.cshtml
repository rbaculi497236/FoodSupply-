@model FoodSupply.Models.ReceiptViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    Layout = null;
    var company = Configuration["Receipt:CompanyName"] ?? "FoodSupply";
    var address = Configuration["Receipt:Address"];
    var terms = Configuration["Receipt:Terms"];
    var culture = System.Globalization.CultureInfo.GetCultureInfo("en-PH");
    var subtotal = Model.Items.Sum(i => i.Amount);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Model.Number - @Model.OrderType Receipt</title>
    <link rel="stylesheet" href="~/css/receipt.css" asp-append-version="true" />
</head>
<body>
    <nav class="receipt-toolbar" aria-label="Receipt actions">
        <a asp-controller="@Model.Controller" asp-action="Details" asp-route-id="@Model.OrderId">Back to @Model.OrderType</a>
        <button type="button" id="printReceipt">Print / Save as PDF</button>
    </nav>
    <main class="receipt">
        <header class="receipt-header">
            <div class="parties">
                <section>
                    <h2>From</h2>
                    <div>@(Model.IsPurchase ? Model.PartyName : company)</div>
                    <div class="multiline">@(Model.IsPurchase ? Model.PartyAddress : address)</div>
                </section>
                <section>
                    <h2>To</h2>
                    <div>@(Model.IsPurchase ? company : Model.PartyName)</div>
                    <div class="multiline">@(Model.IsPurchase ? address : Model.PartyAddress)</div>
                </section>
            </div>
            <div class="receipt-heading">
                <img src="~/images/foodsupply-logo.png" alt="FoodSupply logo" />
                <h1>Receipt</h1>
                <p>@Model.OrderType</p>
                <dl>
                    <dt>Receipt #:</dt><dd>@Model.Number</dd>
                    <dt>Order Date:</dt><dd>@Model.Date.ToString("MMM dd, yyyy", culture)</dd>
                    <dt>Order Status:</dt><dd>@Model.Status</dd>
                </dl>
            </div>
        </header>
        <table class="receipt-items">
            <colgroup><col class="quantity" /><col /><col class="price" /><col class="price" /></colgroup>
            <thead><tr><th scope="col">QTY</th><th scope="col">Description</th><th scope="col" class="number">Unit Price</th><th scope="col" class="number">Amount</th></tr></thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr><td class="number">@item.Quantity</td><td>@item.Description</td><td class="number">@item.UnitPrice.ToString("N2", culture)</td><td class="number">@item.Amount.ToString("N2", culture)</td></tr>
                }
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="4">No items in this order.</td></tr>
                }
                @for (var i = Math.Max(1, Model.Items.Count); i < 9; i++)
                {
                    <tr class="blank-row" aria-hidden="true"><td>&nbsp;</td><td></td><td></td><td></td></tr>
                }
            </tbody>
        </table>
        <section class="receipt-summary" aria-label="Totals in Philippine pesos">
            <div><span>Subtotal</span><span>@subtotal.ToString("N2", culture)</span></div>
            @if (Model.Total != subtotal)
            {
                <div><span>Order adjustment</span><span>@((Model.Total - subtotal).ToString("N2", culture))</span></div>
            }
            <div class="total"><strong>Total (PHP)</strong><strong>@Model.Total.ToString("N2", culture)</strong></div>
        </section>
        <section class="receipt-terms">
            @if (!string.IsNullOrWhiteSpace(Model.Notes))
            {
                <h2>Notes</h2>
                <p class="multiline">@Model.Notes</p>
            }
            @if (!string.IsNullOrWhiteSpace(terms))
            {
                <h2>Terms and conditions</h2>
                <p class="multiline">@terms</p>
            }
            <p>Thank you for your business!</p>
            <p class="receipt-disclaimer">This receipt summarizes the order and does not confirm payment@(Model.IsPurchase ? " or delivery of goods" : "").</p>
        </section>
        <footer>
            @foreach (var contact in new[] { ("Tel", "Phone"), ("Email", "Email"), ("Web", "Website") })
            {
                var value = Configuration[$"Receipt:{contact.Item2}"];
                @if (!string.IsNullOrWhiteSpace(value))
                {
                    <span>@contact.Item1: @value</span>
                }
            }
        </footer>
    </main>
    <script>document.getElementById('printReceipt').addEventListener('click', function () { window.print(); });</script>
</body>
</html>
