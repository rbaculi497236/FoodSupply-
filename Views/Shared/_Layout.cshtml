@{
    var isAdmin = User.IsInRole("Admin") || User.IsInRole("Main Admin");
    var isManager = isAdmin || User.IsInRole("Manager");
    var isDeliveryOnly = User.IsInRole("Delivery Staff") && !isAdmin && !User.IsInRole("Manager");
    var canManageWarehouse = !isDeliveryOnly && (isManager || User.IsInRole("Warehouse Staff"));
    var canViewProducts = !isDeliveryOnly && (canManageWarehouse || User.IsInRole("Sales Staff / Billing Staff") || User.IsInRole("Sales/Customer Staff"));
    var canManagePurchasing = !isDeliveryOnly && (isManager || User.IsInRole("Purchasing/Supplier Staff"));
    var canManageSales = !isDeliveryOnly && (isManager || User.IsInRole("Sales Staff / Billing Staff") || User.IsInRole("Sales/Customer Staff"));
    var canManageDelivery = isManager || User.IsInRole("Delivery Staff");
    var canViewBilling = !isDeliveryOnly && (isManager || User.IsInRole("Sales Staff / Billing Staff") || User.IsInRole("Sales/Customer Staff") || User.IsInRole("Billing Staff"));
}
@inject FoodSupply.Data.ApplicationDbContext DbContext
@{ var inventoryAlertCount = User.Identity?.IsAuthenticated == true ? await DbContext.Inventories.CountAsync(i => i.StockQuantity <= i.ReorderLevel || (i.ExpirationDate.HasValue && i.ExpirationDate.Value <= DateTime.Today.AddDays(30)) || i.SpoiledQuantity > 0 || i.DamagedQuantity > 0) : 0; }

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - FoodSupply</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/FoodSupply.styles.css"
          asp-append-version="true" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

        body {
            margin: 0;
            background-color: #f8f9fa;
        }

        /* =========================
           SIDEBAR
        ========================= */

        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: 250px;
            height: 100vh;
            background: #212529;
            color: white;
            overflow-y: auto;
            z-index: 1000;
        }

        .sidebar-brand {
            height: 70px;
            display: flex;
            align-items: center;
            padding: 0 24px;
            font-size: 22px;
            font-weight: 700;
            color: white;
            text-decoration: none;
            border-bottom: 1px solid rgba(255,255,255,.1);
        }

        .sidebar-brand:hover {
            color: white;
            background-color: #343a40;
        }

        .sidebar-menu {
            padding: 20px 12px;
        }

        .sidebar-section {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            color: #adb5bd;
            padding: 10px 14px 6px;
            letter-spacing: .5px;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 14px;
            margin-bottom: 4px;
            color: #ced4da;
            text-decoration: none;
            border-radius: 8px;
            font-size: 15px;
            transition: all .2s ease;
        }

        .sidebar-link:hover {
            background-color: #343a40;
            color: white;
        }

        .sidebar-icon {
            width: 22px;
            text-align: center;
            font-size: 17px;
        }

        /* Dashboard highlight */

        .dashboard-link {
            background-color: #0d6efd;
            color: white;
        }

        .dashboard-link:hover {
            background-color: #0b5ed7;
            color: white;
        }

        /* =========================
           MAIN CONTENT
        ========================= */

        .main-wrapper {
            margin-left: 250px;
            min-height: 100vh;
        }

        /* =========================
           TOP BAR
        ========================= */

        .topbar {
            height: 70px;
            background: white;
            border-bottom: 1px solid #dee2e6;
            display: flex;
            align-items: center;
            padding: 0 30px;
        }

        /* =========================
           PAGE CONTENT
        ========================= */

        .page-content {
            padding: 30px;
            min-height: calc(100vh - 140px);
        }

        /* =========================
           FOOTER
        ========================= */

        .footer {
            margin-left: 250px;
        }

        /* =========================
           SIDEBAR SCROLLBAR
        ========================= */

        .sidebar::-webkit-scrollbar {
            width: 6px;
        }

        .sidebar::-webkit-scrollbar-track {
            background: #212529;
        }

        .sidebar::-webkit-scrollbar-thumb {
            background: #495057;
            border-radius: 10px;
        }

        /* =========================
           TABLET
        ========================= */

        @@media (max-width: 991.98px) {

            .sidebar {
                width: 220px;
            }

            .main-wrapper {
                margin-left: 220px;
            }

            .footer {
                margin-left: 220px;
            }

        }

        /* =========================
           MOBILE
        ========================= */

        @@media (max-width: 767.98px) {

            .sidebar {
                position: relative;
                width: 100%;
                height: auto;
            }

            .main-wrapper {
                margin-left: 0;
            }

            .footer {
                margin-left: 0;
            }

            .topbar {
                padding: 0 20px;
            }

            .page-content {
                padding: 20px;
            }

        }

    </style>

</head>


<body>

    <!-- =========================
         SIDEBAR
    ========================= -->

    <aside class="sidebar">

        <!-- BRAND -->

        <a class="sidebar-brand"
           asp-controller="Dashboard"
           asp-action="Index">

            <i class="bi bi-box-seam me-2"></i>

            FoodSupply

        </a>


        <div class="sidebar-menu">

            <!-- MAIN -->

            <div class="sidebar-section">
                Main
            </div>


            <!-- DASHBOARD -->

            @if (User.Identity?.IsAuthenticated == true)
            {
            <a class="sidebar-link dashboard-link"
               asp-controller="Dashboard"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-speedometer2"></i>
                </span>

                <span>Dashboard</span>

            </a>
            }


            <!-- MANAGEMENT -->

            <div class="sidebar-section mt-3">
                Management
            </div>


            <!-- PRODUCTS -->

                @if (canViewProducts)
                {
                <a class="sidebar-link"
               asp-controller="Products"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-box-seam"></i>
                </span>

                <span>Products</span>

            </a>
            }


            <!-- CATEGORIES -->

                @if (canManageWarehouse)
                {
                <a class="sidebar-link"
               asp-controller="Categories"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-tags"></i>
                </span>

                <span>Categories</span>

            </a>
            }


            <!-- SUPPLIERS -->

                @if (canManagePurchasing)
                {
                <a class="sidebar-link"
               asp-controller="Suppliers"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-truck"></i>
                </span>

                <span>Suppliers</span>

            </a>
            }


            <!-- CUSTOMERS -->

                @if (canManageSales)
                {
                <a class="sidebar-link"
               asp-controller="Customers"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-people"></i>
                </span>

                <span>Customers</span>

            </a>
            }


            <!-- OPERATIONS -->

            <div class="sidebar-section mt-3">
                Operations
            </div>


            <!-- INVENTORY -->

                @if (canManageWarehouse)
                {
                <a class="sidebar-link"
               asp-controller="Inventories"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-clipboard-data"></i>
                </span>

                <span>Inventory</span>

            </a>
            }


            <!-- PURCHASING -->

                @if (canManagePurchasing)
                {
                <a class="sidebar-link"
               asp-controller="Purchases"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-cart3"></i>
                </span>

                <span>Purchasing</span>

            </a>
            }


            <!-- SALES ORDERS -->

                @if (canManageSales)
                {
                <a class="sidebar-link"
               asp-controller="SalesOrders"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-receipt"></i>
                </span>

                <span>Sales Orders</span>

            </a>
            }


            <!-- DELIVERIES -->

                @if (canManageDelivery)
                {
                <a class="sidebar-link"
               asp-controller="Deliveries"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-truck"></i>
                </span>

                <span>Deliveries</span>

            </a>
            }


            <!-- BILLING -->

                @if (canViewBilling)
                {
                <a class="sidebar-link"
               asp-controller="Billings"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-cash-stack"></i>
                </span>

                <span>Billing</span>

            </a>
            }


            <!-- SYSTEM -->

            <div class="sidebar-section mt-3">
                System
            </div>


            <!-- USERS -->

            @if (isAdmin)
            {
            <a class="sidebar-link"
               asp-controller="Users"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-person-gear"></i>
                </span>

                <span>Users</span>

            </a>
            }


            <!-- PRIVACY -->

            <a class="sidebar-link"
               asp-controller="Home"
               asp-action="Privacy">

                <span class="sidebar-icon">
                    <i class="bi bi-shield-lock"></i>
                </span>

                <span>Privacy</span>

            </a>

        </div>

    </aside>


    <!-- =========================
         MAIN WRAPPER
    ========================= -->

    <div class="main-wrapper">


        <!-- =========================
             TOP BAR
        ========================= -->

        <header class="topbar">
            @if (canManageWarehouse)
            {
                <a asp-controller="Inventories" asp-action="Alerts" class="btn btn-link position-relative ms-auto" title="Inventory alerts">
                    <i class="bi bi-bell fs-5"></i>
                    @if (inventoryAlertCount > 0) { <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">@inventoryAlertCount</span> }
                </a>
            }

            <!-- PAGE TITLE -->

            <div>

                <h5 class="mb-0 fw-bold">
                    @ViewData["Title"]
                </h5>

            </div>


            <!-- USER / LOGOUT -->

            <div class="ms-auto d-flex align-items-center gap-3">

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="text-muted">

                        <i class="bi bi-person-circle me-1"></i>

                        @User.Identity.Name

                    </span>


                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-outline-danger btn-sm">

                            <i class="bi bi-box-arrow-right me-1"></i>

                            Logout

                        </button>

                    </form>
                }

            </div>

        </header>


        <!-- =========================
             PAGE CONTENT
        ========================= -->

        <main class="page-content">

            @RenderBody()

        </main>

    </div>


    <!-- =========================
         FOOTER
    ========================= -->

    <footer class="border-top footer text-muted py-3">

        <div class="container-fluid px-4">

            &copy; 2026 - FoodSupply -

            <a asp-controller="Home"
               asp-action="Privacy">

                Privacy

            </a>

        </div>

    </footer>


    <!-- =========================
         SCRIPTS
    ========================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
