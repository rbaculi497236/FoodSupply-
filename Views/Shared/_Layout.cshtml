@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@inject FoodSupply.Data.ApplicationDbContext DbContext

@{
    // =========================================================
    // AUTHENTICATION
    // =========================================================

    var isAuthenticated = User.Identity?.IsAuthenticated == true;

    var currentRole = User.Claims
        .FirstOrDefault(c => c.Type == ClaimTypes.Role)
        ?.Value?
        .Trim() ?? "";

    // =========================================================
    // ROLE CHECKS
    // =========================================================

    // "Main Admin" is authorized alongside "Admin" throughout the
    // controllers, so it must receive the same sidebar permissions.
    var isMainAdmin = string.Equals(
        currentRole,
        "Main Admin",
        StringComparison.OrdinalIgnoreCase
    );

    var isAdmin = string.Equals(
        currentRole,
        "Admin",
        StringComparison.OrdinalIgnoreCase
    ) || isMainAdmin;

    var isManager = string.Equals(
        currentRole,
        "Manager",
        StringComparison.OrdinalIgnoreCase
    );

    var isSalesBilling = string.Equals(
        currentRole,
        "Sales Staff / Billing Staff",
        StringComparison.OrdinalIgnoreCase
    );

    var isDelivery = string.Equals(
        currentRole,
        "Delivery Staff",
        StringComparison.OrdinalIgnoreCase
    );

    // =========================================================
    // ROLE PERMISSIONS
    // =========================================================

    var canViewDashboard =
        isAdmin ||
        isManager ||
        isSalesBilling ||
        isDelivery;

    var canViewProducts =
        isAdmin ||
        isManager ||
        isSalesBilling;

    var canManageCategories =
        isAdmin ||
        isManager;

    var canManageSuppliers =
        isAdmin ||
        isManager;

    var canViewCustomers =
        isAdmin ||
        isManager ||
        isSalesBilling;

    var canViewCRM =
        isAdmin ||
        isManager ||
        isSalesBilling;

    var canViewInventory =
        isAdmin ||
        isManager;

    var canManagePurchasing =
        isAdmin ||
        isManager;

    var canManageSales =
        isAdmin ||
        isManager ||
        isSalesBilling;

    var canManageDelivery =
        isAdmin ||
        isManager ||
        isDelivery;

    var canViewBilling =
        isAdmin ||
        isManager ||
        isSalesBilling;

    var canViewReports =
        isAdmin ||
        isManager ||
        isSalesBilling ||
        isDelivery;

    var canManageUsers =
        isAdmin;

    var canViewNotifications =
        isAdmin ||
        isManager ||
        isSalesBilling ||
        isDelivery;

    // =========================================================
    // CURRENT PAGE
    // =========================================================

    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    var currentAction =
        ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    // =========================================================
    // INVENTORY ALERT COUNT
    // =========================================================

    var inventoryAlertCount = 0;

    if (isAuthenticated)
    {
        inventoryAlertCount = await DbContext.Inventories
            .CountAsync(i =>
                !i.IsArchived &&
                (
                    i.StockQuantity <= i.ReorderLevel ||

                    (
                        i.ExpirationDate.HasValue &&
                        i.ExpirationDate.Value <=
                            DateTime.Today.AddDays(30)
                    ) ||

                    i.SpoiledQuantity > 0 ||

                    i.DamagedQuantity > 0
                )
            );
    }

    // =========================================================
    // USER DISPLAY
    // =========================================================

    var displayName =
        User.Identity?.Name ?? "User";

    var firstLetter =
        !string.IsNullOrWhiteSpace(displayName)
            ? displayName.Substring(0, 1).ToUpper()
            : "U";

    var displayRole = "User";

    if (isMainAdmin)
    {
        displayRole = "Main Admin";
    }
    else if (isAdmin)
    {
        displayRole = "Admin";
    }
    else if (isManager)
    {
        displayRole = "Manager";
    }
    else if (isSalesBilling)
    {
        displayRole = "Sales Staff / Billing Staff";
    }
    else if (isDelivery)
    {
        displayRole = "Delivery Staff";
    }
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - FoodSupply
    </title>

    <!-- =====================================================
         BOOTSTRAP
         ===================================================== -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- =====================================================
         BOOTSTRAP ICONS
         ===================================================== -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- =====================================================
         FOODSUPPLY CSS
         ===================================================== -->

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <!-- =====================================================
         FOODSUPPLY THEME
         ===================================================== -->

    <style>

        /* =====================================================
           FOODSUPPLY BRAND COLORS
           ===================================================== */

        :root {

            --food-blue: #123D68;
            --food-blue-light: #1F5A91;
            --food-blue-soft: #EAF2F9;

            --food-green: #4B9B28;
            --food-green-light: #65B33C;
            --food-green-soft: #EEF7E9;

            --food-gradient:
                linear-gradient(
                    135deg,
                    #123D68 0%,
                    #1F5A91 48%,
                    #4B9B28 100%
                );

            --food-gradient-soft:
                linear-gradient(
                    135deg,
                    #EAF2F9 0%,
                    #EEF7E9 100%
                );

            --food-border: #D9E5EE;
            --food-text: #263746;
            --food-muted: #6B7C8C;
        }


        /* =====================================================
           GLOBAL
           ===================================================== */

        html,
        body {
            min-height: 100%;
        }

        html {
            position: relative;
        }

        body {
            margin: 0;

            background:
                linear-gradient(
                    135deg,
                    #F7FAFC 0%,
                    #F1F7F2 100%
                );

            font-family:
                "Segoe UI",
                Tahoma,
                Geneva,
                Verdana,
                sans-serif;

            color: var(--food-text);
        }

        a {
            text-decoration: none;
        }


        /* =====================================================
           SIDEBAR
           ===================================================== */

        .sidebar {

            position: fixed;

            top: 0;
            left: 0;
            bottom: 0;

            width: 250px;

            background: #ffffff;

            border-right:
                1px solid var(--food-border);

            overflow-y: auto;

            z-index: 1030;

            scrollbar-width: thin;

            box-shadow:
                4px 0 18px rgba(18, 61, 104, 0.06);
        }


        .sidebar::-webkit-scrollbar {
            width: 6px;
        }

        .sidebar::-webkit-scrollbar-thumb {

            background:
                linear-gradient(
                    180deg,
                    var(--food-blue),
                    var(--food-green)
                );

            border-radius: 10px;
        }


        /* =====================================================
           SIDEBAR BRAND
           ===================================================== */

        .sidebar-brand {

            height: 90px;

            display: flex;

            align-items: center;

            padding: 10px 18px;

            border-bottom:
                1px solid var(--food-border);

            background:
                linear-gradient(
                    135deg,
                    #ffffff 0%,
                    #F3F8F1 100%
                );
        }


        .sidebar-brand a {

            width: 100%;

            display: flex;

            align-items: center;

            justify-content: center;
        }


        .sidebar-brand img {

            max-width: 190px;

            max-height: 65px;

            object-fit: contain;
        }


        /* =====================================================
           SIDEBAR SECTION
           ===================================================== */

        .sidebar-section {

            padding:
                20px 15px 7px;

            font-size: 11px;

            font-weight: 700;

            text-transform: uppercase;

            color: var(--food-green);

            letter-spacing: 0.1em;
        }


        /* =====================================================
           SIDEBAR LINKS
           ===================================================== */

        .sidebar-link {

            display: flex;

            align-items: center;

            gap: 12px;

            margin: 3px 10px;

            padding: 11px 13px;

            border-radius: 9px;

            color: #526271;

            font-size: 14px;

            transition:
                background-color 0.2s ease,
                color 0.2s ease,
                transform 0.2s ease,
                box-shadow 0.2s ease;
        }


        .sidebar-link:hover {

            background:
                linear-gradient(
                    90deg,
                    var(--food-blue-soft),
                    var(--food-green-soft)
                );

            color: var(--food-blue);

            transform: translateX(2px);
        }


        .sidebar-link.active {

            background:
                linear-gradient(
                    90deg,
                    #E8F1F8 0%,
                    #EEF7E9 100%
                );

            color: var(--food-blue);

            font-weight: 700;

            box-shadow:
                inset 4px 0 0 var(--food-green);
        }


        .sidebar-icon {

            width: 24px;

            min-width: 24px;

            display: inline-flex;

            align-items: center;

            justify-content: center;

            font-size: 17px;

            color: var(--food-blue);
        }


        .sidebar-link.active .sidebar-icon {

            color: var(--food-green);
        }


        .sidebar-link span:last-child {

            white-space: nowrap;
        }


        /* =====================================================
           MAIN WRAPPER
           ===================================================== */

        .main-wrapper {

            margin-left: 250px;

            min-height: 100vh;

            display: flex;

            flex-direction: column;
        }


        /* =====================================================
           TOPBAR
           ===================================================== */

        .topbar {

            height: 75px;

            background:
                linear-gradient(
                    90deg,
                    #ffffff 0%,
                    #F8FBFC 55%,
                    #F3F8F1 100%
                );

            border-bottom:
                1px solid var(--food-border);

            display: flex;

            align-items: center;

            justify-content: space-between;

            padding: 0 25px;

            position: sticky;

            top: 0;

            z-index: 1020;

            box-shadow:
                0 2px 12px rgba(18, 61, 104, 0.05);
        }


        .topbar-title {

            font-size: 20px;

            font-weight: 700;

            color: var(--food-blue);

            position: relative;

            padding-left: 13px;
        }


        .topbar-title::before {

            content: "";

            position: absolute;

            left: 0;

            top: 3px;

            bottom: 3px;

            width: 4px;

            border-radius: 5px;

            background:
                linear-gradient(
                    180deg,
                    var(--food-blue),
                    var(--food-green)
                );
        }


        /* =====================================================
           USER AREA
           ===================================================== */

        .topbar-user {

            display: flex;

            align-items: center;

            gap: 10px;
        }


        .user-avatar {

            width: 40px;

            height: 40px;

            min-width: 40px;

            border-radius: 50%;

            background:
                linear-gradient(
                    135deg,
                    var(--food-blue),
                    var(--food-green)
                );

            color: #ffffff;

            display: flex;

            align-items: center;

            justify-content: center;

            font-weight: 700;

            font-size: 15px;

            box-shadow:
                0 3px 8px rgba(18, 61, 104, 0.2);
        }


        .user-info {

            line-height: 1.2;

            min-width: 120px;
        }


        .user-name {

            font-weight: 700;

            font-size: 14px;

            color: var(--food-blue);
        }


        .user-role {

            font-size: 12px;

            color: var(--food-green);

            margin-top: 3px;

            font-weight: 600;
        }


        /* =====================================================
           NOTIFICATION
           ===================================================== */

        .notification-link {

            position: relative;

            display: inline-flex;

            align-items: center;

            justify-content: center;

            width: 40px;

            height: 40px;

            border-radius: 50%;

            color: var(--food-blue);

            transition:
                background-color 0.2s ease,
                color 0.2s ease,
                transform 0.2s ease;
        }


        .notification-link:hover {

            background:
                var(--food-green-soft);

            color: var(--food-green);

            transform: translateY(-1px);
        }


        .notification-badge {

            position: absolute;

            top: 0;

            right: 0;

            min-width: 18px;

            height: 18px;

            padding: 0 4px;

            border-radius: 50px;

            background: var(--food-green);

            color: #ffffff;

            font-size: 10px;

            font-weight: 700;

            display: flex;

            align-items: center;

            justify-content: center;

            border:
                2px solid #ffffff;
        }


        /* =====================================================
           CONTENT
           ===================================================== */

        .content {

            flex: 1;

            padding: 25px;

            width: 100%;
        }


        /* =====================================================
           CARDS
           ===================================================== */

        .card {

            border:
                1px solid var(--food-border);

            border-radius: 12px;

            box-shadow:
                0 4px 14px rgba(18, 61, 104, 0.06);

            overflow: hidden;
        }


        .card-header {

            border-bottom:
                1px solid var(--food-border);
        }


        /* =====================================================
           FOODSUPPLY BUTTONS
           ===================================================== */

        .btn-primary {

            background:
                linear-gradient(
                    135deg,
                    var(--food-blue),
                    var(--food-blue-light)
                ) !important;

            border-color:
                var(--food-blue) !important;
        }


        .btn-primary:hover {

            background:
                linear-gradient(
                    135deg,
                    #0D3154,
                    var(--food-blue)
                ) !important;

            border-color:
                #0D3154 !important;
        }


        .btn-success {

            background:
                linear-gradient(
                    135deg,
                    var(--food-green),
                    var(--food-green-light)
                ) !important;

            border-color:
                var(--food-green) !important;
        }


        .btn-success:hover {

            background:
                linear-gradient(
                    135deg,
                    #3D8520,
                    var(--food-green)
                ) !important;
        }


        .btn-outline-primary {

            color: var(--food-blue) !important;

            border-color:
                var(--food-blue) !important;
        }


        .btn-outline-primary:hover {

            color: #ffffff !important;

            background:
                var(--food-blue) !important;

            border-color:
                var(--food-blue) !important;
        }


        .btn-outline-success {

            color: var(--food-green) !important;

            border-color:
                var(--food-green) !important;
        }


        .btn-outline-success:hover {

            color: #ffffff !important;

            background:
                var(--food-green) !important;

            border-color:
                var(--food-green) !important;
        }


        /* =====================================================
           TABLES
           ===================================================== */

        .table thead {

            background:
                linear-gradient(
                    90deg,
                    var(--food-blue-soft),
                    var(--food-green-soft)
                );
        }


        .table thead th {

            color: var(--food-blue);

            font-weight: 700;

            border-bottom:
                2px solid var(--food-green);
        }


        .table-hover tbody tr:hover {

            background-color:
                #F4F9F3;
        }


        /* =====================================================
           BADGES
           ===================================================== */

        .badge.bg-success {

            background-color:
                var(--food-green) !important;
        }


        /* =====================================================
           FOOTER
           ===================================================== */

        .footer {

            background:
                linear-gradient(
                    90deg,
                    #ffffff,
                    #F3F8F1
                );

            border-top:
                1px solid var(--food-border);

            padding:
                15px 25px;

            color:
                var(--food-muted);

            font-size: 13px;

            line-height: normal;

            white-space: normal;
        }


        .footer strong {

            color:
                var(--food-blue);
        }


        /* =====================================================
           LOGOUT
           ===================================================== */

        .logout-button {

            width: 38px;

            height: 38px;

            display: inline-flex;

            align-items: center;

            justify-content: center;

            border-radius: 8px;

            color: var(--food-blue);

            border-color:
                var(--food-blue);
        }


        .logout-button:hover {

            background:
                var(--food-blue);

            border-color:
                var(--food-blue);

            color: #ffffff;
        }


        /* =====================================================
           FORM CONTROLS
           ===================================================== */

        .form-control:focus,
        .form-select:focus {

            border-color:
                var(--food-green);

            box-shadow:
                0 0 0 0.2rem
                rgba(75, 155, 40, 0.15);
        }


        /* =====================================================
           LINKS
           ===================================================== */

        .content a:not(.btn) {

            color:
                var(--food-blue);
        }


        .content a:not(.btn):hover {

            color:
                var(--food-green);
        }


        /* =====================================================
           ALERTS
           ===================================================== */

        .alert-success {

            border-left:
                4px solid var(--food-green);
        }


        .alert-info {

            border-left:
                4px solid var(--food-blue);
        }


        /* =====================================================
           RESPONSIVE - TABLET
           ===================================================== */

        @@media (max-width: 991.98px) {

            .sidebar {

                width: 220px;
            }

            .main-wrapper {

                margin-left: 220px;
            }

            .topbar {

                padding: 0 20px;
            }

            .content {

                padding: 20px;
            }
        }


        /* =====================================================
           RESPONSIVE - MOBILE
           ===================================================== */

        @@media (max-width: 767.98px) {

            .sidebar {

                position: relative;

                width: 100%;

                height: auto;

                max-height: none;

                border-right: none;

                border-bottom:
                    1px solid var(--food-border);
            }

            .main-wrapper {

                margin-left: 0;
            }

            .topbar {

                position: relative;

                height: auto;

                min-height: 70px;

                padding: 12px 15px;
            }

            .topbar-title {

                font-size: 18px;
            }

            .content {

                padding: 15px;
            }

            .sidebar-brand {

                justify-content: center;
            }

            .user-info {

                display: none;
            }

            .topbar-user {

                gap: 6px;
            }
        }


        /* =====================================================
           VERY SMALL MOBILE
           ===================================================== */

        @@media (max-width: 480px) {

            .topbar-title {

                font-size: 16px;
            }

            .topbar {

                padding: 10px;
            }

            .content {

                padding: 10px;
            }
        }

    </style>

    @await RenderSectionAsync("Styles", required: false)

</head>


<body>

    <!-- =====================================================
         SIDEBAR
         ===================================================== -->

    <aside class="sidebar">

        <!-- LOGO -->

        <div class="sidebar-brand">

            <a asp-controller="Dashboard"
               asp-action="Index">

                <img src="~/images/foodsupply-logo.png"
                     alt="FoodSupply Logo" />

            </a>

        </div>


        <!-- =================================================
             MAIN
             ================================================= -->

        <div class="sidebar-section">
            Main
        </div>


        @if (canViewDashboard)
        {
            <a class="sidebar-link @(currentController == "Dashboard" ? "active" : "")"
               asp-controller="Dashboard"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-speedometer2"></i>
                </span>

                <span>
                    Dashboard
                </span>

            </a>
        }


        <!-- =================================================
             MANAGEMENT
             ================================================= -->

        <div class="sidebar-section">
            Management
        </div>


        @if (canViewProducts)
        {
            <a class="sidebar-link @(currentController == "Products" ? "active" : "")"
               asp-controller="Products"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-box-seam"></i>
                </span>

                <span>
                    Products
                </span>

            </a>
        }


        @if (canManageCategories)
        {
            <a class="sidebar-link @(currentController == "Categories" ? "active" : "")"
               asp-controller="Categories"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-tags"></i>
                </span>

                <span>
                    Categories
                </span>

            </a>
        }


        @if (canManageSuppliers)
        {
            <a class="sidebar-link @(currentController == "Suppliers" ? "active" : "")"
               asp-controller="Suppliers"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-truck"></i>
                </span>

                <span>
                    Suppliers
                </span>

            </a>
        }


        @if (canViewCustomers)
        {
            <a class="sidebar-link @(currentController == "Customers" ? "active" : "")"
               asp-controller="Customers"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-people"></i>
                </span>

                <span>
                    Customers
                </span>

            </a>
        }


        @if (canViewCRM)
        {
            <a class="sidebar-link @(currentController == "CRM" ? "active" : "")"
               asp-controller="CRM"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-person-lines-fill"></i>
                </span>

                <span>
                    CRM
                </span>

            </a>
        }


        <!-- =================================================
             OPERATIONS
             ================================================= -->

        <div class="sidebar-section">
            Operations
        </div>


        @if (canViewInventory)
        {
            <a class="sidebar-link @(currentController == "Inventories" ? "active" : "")"
               asp-controller="Inventories"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-clipboard-data"></i>
                </span>

                <span>
                    Inventory
                </span>

            </a>
        }


        @if (canManagePurchasing)
        {
            <a class="sidebar-link @(currentController == "Purchases" ? "active" : "")"
               asp-controller="Purchases"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-cart-check"></i>
                </span>

                <span>
                    Purchasing
                </span>

            </a>
        }


        @if (canManageSales)
        {
            <a class="sidebar-link @(currentController == "SalesOrders" ? "active" : "")"
               asp-controller="SalesOrders"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-receipt"></i>
                </span>

                <span>
                    Sales Orders
                </span>

            </a>
        }


        @if (canManageDelivery)
        {
            <a class="sidebar-link @(currentController == "Deliveries" ? "active" : "")"
               asp-controller="Deliveries"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-truck-front"></i>
                </span>

                <span>
                    Deliveries
                </span>

            </a>
        }


        @if (canViewBilling)
        {
            <a class="sidebar-link @(currentController == "Billings" ? "active" : "")"
               asp-controller="Billings"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-cash-stack"></i>
                </span>

                <span>
                    Billing
                </span>

            </a>
        }


        @if (canViewReports)
        {
            <a class="sidebar-link @(currentController == "Reports" ? "active" : "")"
               asp-controller="Reports"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-bar-chart-line"></i>
                </span>

                <span>
                    Reports
                </span>

            </a>
        }


        <!-- =================================================
             SYSTEM
             ================================================= -->

        <div class="sidebar-section">
            System
        </div>


        @if (canManageUsers)
        {
            <a class="sidebar-link @(currentController == "Users" ? "active" : "")"
               asp-controller="Users"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-person-gear"></i>
                </span>

                <span>
                    Users
                </span>

            </a>
        }


        @if (isAuthenticated)
        {
            <a class="sidebar-link @(currentController == "Home" && currentAction == "Privacy" ? "active" : "")"
               asp-controller="Home"
               asp-action="Privacy">

                <span class="sidebar-icon">
                    <i class="bi bi-shield-check"></i>
                </span>

                <span>
                    Privacy
                </span>

            </a>
        }


        @if (canViewNotifications)
        {
            <a class="sidebar-link @(currentController == "Notifications" ? "active" : "")"
               asp-controller="Notifications"
               asp-action="Index">

                <span class="sidebar-icon position-relative">

                    <i class="bi bi-bell"></i>

                    @if (inventoryAlertCount > 0)
                    {
                        <span class="notification-badge">

                            @(inventoryAlertCount > 99
                                ? "99+"
                                : inventoryAlertCount)

                        </span>
                    }

                </span>

                <span>
                    Notifications
                </span>

            </a>
        }

    </aside>


    <!-- =====================================================
         MAIN WRAPPER
         ===================================================== -->

    <div class="main-wrapper">


        <!-- =================================================
             TOPBAR
             ================================================= -->

        <header class="topbar">

            <div class="topbar-title">

                @ViewData["Title"]

            </div>


            @if (isAuthenticated)
            {
                <div class="topbar-user">


                    <!-- NOTIFICATIONS -->

                    @if (canViewNotifications)
                    {
                        <a class="notification-link"
                           asp-controller="Notifications"
                           asp-action="Index"
                           title="Notifications">

                            <i class="bi bi-bell fs-5"></i>

                            @if (inventoryAlertCount > 0)
                            {
                                <span class="notification-badge">

                                    @(inventoryAlertCount > 99
                                        ? "99+"
                                        : inventoryAlertCount)

                                </span>
                            }

                        </a>
                    }


                    <!-- USER AVATAR -->

                    <div class="user-avatar">

                        @firstLetter

                    </div>


                    <!-- USER INFORMATION -->

                    <div class="user-info">

                        <div class="user-name">

                            @displayName

                        </div>

                        <div class="user-role">

                            @displayRole

                        </div>

                    </div>


                    <!-- LOGOUT -->

                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post"
                          class="ms-2">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-outline-primary btn-sm logout-button"
                                title="Logout">

                            <i class="bi bi-box-arrow-right"></i>

                        </button>

                    </form>

                </div>
            }

        </header>


        <!-- =================================================
             PAGE CONTENT
             ================================================= -->

        <main class="content">

            @RenderBody()

        </main>


        <!-- =================================================
             FOOTER
             ================================================= -->

        <footer class="footer">

            <div class="d-flex
                        justify-content-between
                        align-items-center
                        flex-wrap">

                <div>

                    &copy; @DateTime.Now.Year

                    <strong>
                        FoodSupply
                    </strong>.

                    All rights reserved.

                </div>

                <div>

                    <span class="text-muted">

                        Food Supply ERP & CRM System

                    </span>

                </div>

            </div>

        </footer>

    </div>


    <!-- =====================================================
         JAVASCRIPT
         ===================================================== -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
