@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@inject FoodSupply.Data.ApplicationDbContext DbContext

@{
    // =========================================================
    // AUTHENTICATION
    // =========================================================

    var isAuthenticated = User.Identity?.IsAuthenticated == true;

    var currentRole = User.Claims
        .FirstOrDefault(c => c.Type == ClaimTypes.Role)
        ?.Value?
        .Trim() ?? "";

    // =========================================================
    // ROLE CHECKS
    // =========================================================

    var isMainAdmin = string.Equals(
        currentRole,
        "Main Admin",
        StringComparison.OrdinalIgnoreCase
    );

    var isAdmin = string.Equals(
        currentRole,
        "Admin",
        StringComparison.OrdinalIgnoreCase
    ) || isMainAdmin;

    var isManager = string.Equals(
        currentRole,
        "Manager",
        StringComparison.OrdinalIgnoreCase
    );

    var isSalesBilling = string.Equals(
        currentRole,
        "Sales Staff / Billing Staff",
        StringComparison.OrdinalIgnoreCase
    );

    var isDelivery = string.Equals(
        currentRole,
        "Delivery Staff",
        StringComparison.OrdinalIgnoreCase
    );

    // =========================================================
    // ROLE PERMISSIONS
    // =========================================================

    var canViewDashboard =
        isAdmin ||
        isManager ||
        isSalesBilling ||
        isDelivery;

    var canViewProducts =
        isAdmin ||
        isManager ||
        isSalesBilling;

    var canManageCategories =
        isAdmin ||
        isManager;

    var canManageSuppliers =
        isAdmin ||
        isManager;

    var canViewCustomers =
        isAdmin ||
        isManager ||
        isSalesBilling;

    var canViewCRM =
        isAdmin ||
        isManager ||
        isSalesBilling;

    var canViewInventory =
        isAdmin ||
        isManager;

    var canManagePurchasing =
        isAdmin ||
        isManager;

    var canManageSales =
        isAdmin ||
        isManager ||
        isSalesBilling;

    var canManageDelivery =
        isAdmin ||
        isManager ||
        isDelivery;

    var canViewBilling =
        isAdmin ||
        isManager ||
        isSalesBilling;

    var canViewReports =
        isAdmin ||
        isManager ||
        isSalesBilling ||
        isDelivery;

    var canManageUsers =
        isAdmin;

    var canViewNotifications =
        isAdmin ||
        isManager ||
        isSalesBilling ||
        isDelivery;

    // =========================================================
    // CURRENT PAGE
    // =========================================================

    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    var currentAction =
        ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    // =========================================================
    // INVENTORY ALERT COUNT
    // =========================================================

    var inventoryAlertCount = 0;

    if (isAuthenticated)
    {
        inventoryAlertCount = await DbContext.Inventories
            .CountAsync(i =>
                !i.IsArchived &&
                (
                    i.StockQuantity <= i.ReorderLevel || DbContext.InventoryBatches.Any(b => b.ProductId == i.ProductId && b.Quantity > 0 && (b.IsQuarantined || (b.ExpirationDate.HasValue && b.ExpirationDate.Value <= DateTime.Today.AddDays(30)))) ||

                    (
                        i.ExpirationDate.HasValue &&
                        i.ExpirationDate.Value <=
                            DateTime.Today.AddDays(30)
                    ) ||

                    i.SpoiledQuantity > 0 ||

                    i.DamagedQuantity > 0
                )
            );
    }

    // =========================================================
    // USER DISPLAY
    // =========================================================

    var displayName =
        User.Identity?.Name ?? "User";

    var firstLetter =
        !string.IsNullOrWhiteSpace(displayName)
            ? displayName.Substring(0, 1).ToUpper()
            : "U";

    var displayRole = "User";

    if (isMainAdmin)
    {
        displayRole = "Main Admin";
    }
    else if (isAdmin)
    {
        displayRole = "Admin";
    }
    else if (isManager)
    {
        displayRole = "Manager";
    }
    else if (isSalesBilling)
    {
        displayRole = "Sales Staff / Billing Staff";
    }
    else if (isDelivery)
    {
        displayRole = "Delivery Staff";
    }
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - FoodSupply
    </title>

    <!-- =====================================================
         BOOTSTRAP
         ===================================================== -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- =====================================================
         BOOTSTRAP ICONS
         ===================================================== -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- =====================================================
         FOODSUPPLY CSS
         ===================================================== -->

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <!-- =====================================================
         LAYOUT STYLE
         ===================================================== -->

    <style>

        /* =====================================================
           FOODSUPPLY BRAND COLORS
           ===================================================== */

        :root {
            --food-blue: #123D68;
            --food-blue-light: #1F5A91;
            --food-blue-dark: #0D3154;

            --food-green: #4B9B28;
            --food-green-light: #65B33C;

            --food-green-soft: #EEF7E9;
            --food-blue-soft: #EAF2F9;

            --food-border: #D9E5EE;

            --food-text: #263746;
            --food-muted: #6B7C8C;

            --sidebar-width: 255px;
        }


        /* =====================================================
           GLOBAL
           ===================================================== */

        html,
        body {
            min-height: 100%;
        }

        html {
            position: relative;
        }

        body {
            margin: 0;

            background:
                linear-gradient(
                    135deg,
                    #F7FAFC 0%,
                    #F1F7F2 100%
                );

            font-family:
                "Segoe UI",
                Tahoma,
                Geneva,
                Verdana,
                sans-serif;

            color: var(--food-text);
        }

        a {
            text-decoration: none;
        }


        /* =====================================================
           SIDEBAR
           ===================================================== */

        .sidebar {
            position: fixed;

            top: 0;
            left: 0;
            bottom: 0;

            width: var(--sidebar-width);

            background:
                linear-gradient(
                    180deg,
                    #0F3558 0%,
                    #123D68 55%,
                    #0E3455 100%
                );

            color: #ffffff;

            overflow-y: auto;
            overflow-x: hidden;

            z-index: 1030;

            box-shadow:
                5px 0 20px rgba(0, 0, 0, 0.12);

            scrollbar-width: thin;

            scrollbar-color:
                var(--food-green)
                transparent;
        }

        .sidebar::-webkit-scrollbar {
            width: 5px;
        }

        .sidebar::-webkit-scrollbar-track {
            background: transparent;
        }

        .sidebar::-webkit-scrollbar-thumb {
            background: var(--food-green);

            border-radius: 10px;
        }


        /* =====================================================
           SIDEBAR BRAND
           ===================================================== */

        .sidebar-brand {
            height: 86px;

            display: flex;

            align-items: center;
            justify-content: center;

            padding: 12px 18px;

            border-bottom:
                1px solid rgba(255,255,255,0.12);

            background:
                rgba(255,255,255,0.04);

            position: relative;
        }

        .sidebar-brand a {
            display: flex;

            align-items: center;
            justify-content: center;

            width: 100%;
        }

        .sidebar-brand img {
            max-width: 185px;
            max-height: 62px;

            object-fit: contain;
        }


        /* =====================================================
           SIDEBAR CLOSE BUTTON
           ===================================================== */

        .sidebar-close {
            display: none;

            position: absolute;

            top: 18px;
            right: 12px;

            width: 32px;
            height: 32px;

            align-items: center;
            justify-content: center;

            border: 0;

            border-radius: 7px;

            background:
                rgba(255,255,255,0.08);

            color: #ffffff;
        }

        .sidebar-close:hover {
            background:
                rgba(255,255,255,0.16);
        }


        /* =====================================================
           SIDEBAR USER
           ===================================================== */

        .sidebar-user {
            display: flex;

            align-items: center;

            gap: 11px;

            margin:
                15px 12px 8px;

            padding: 12px;

            border-radius: 10px;

            background:
                rgba(255,255,255,0.07);

            border:
                1px solid rgba(255,255,255,0.08);
        }

        .sidebar-user-avatar {
            width: 38px;
            height: 38px;

            min-width: 38px;

            border-radius: 50%;

            display: flex;

            align-items: center;
            justify-content: center;

            background:
                linear-gradient(
                    135deg,
                    var(--food-green),
                    var(--food-green-light)
                );

            color: #ffffff;

            font-size: 15px;

            font-weight: 700;

            box-shadow:
                0 3px 8px rgba(0,0,0,0.18);
        }

        .sidebar-user-info {
            min-width: 0;
        }

        .sidebar-user-name {
            color: #ffffff;

            font-size: 13px;

            font-weight: 700;

            white-space: nowrap;

            overflow: hidden;

            text-overflow: ellipsis;
        }

        .sidebar-user-role {
            color: #A9C5D9;

            font-size: 11px;

            margin-top: 3px;

            white-space: nowrap;

            overflow: hidden;

            text-overflow: ellipsis;
        }


        /* =====================================================
           SIDEBAR SECTION
           ===================================================== */

        .sidebar-section {
            padding:
                18px 18px 7px;

            color: #7FC45D;

            font-size: 10px;

            font-weight: 800;

            text-transform: uppercase;

            letter-spacing: 0.13em;
        }


        /* =====================================================
           SIDEBAR LINKS
           ===================================================== */

        .sidebar-link {
            position: relative;

            display: flex;

            align-items: center;

            gap: 12px;

            margin:
                3px 10px;

            padding:
                11px 13px;

            border-radius: 8px;

            color: #C8D8E5;

            font-size: 14px;

            font-weight: 500;

            transition:
                background-color 0.2s ease,
                color 0.2s ease,
                transform 0.2s ease;
        }

        .sidebar-link:hover {
            color: #ffffff;

            background:
                rgba(255,255,255,0.09);

            transform:
                translateX(2px);
        }

        .sidebar-link.active {
            color: #ffffff;

            font-weight: 700;

            background:
                linear-gradient(
                    90deg,
                    rgba(75,155,40,0.28),
                    rgba(255,255,255,0.08)
                );

            box-shadow:
                inset 4px 0 0 var(--food-green-light);
        }

        .sidebar-link.active::after {
            content: "";

            position: absolute;

            right: 10px;

            width: 6px;
            height: 6px;

            border-radius: 50%;

            background:
                var(--food-green-light);

            box-shadow:
                0 0 8px rgba(101,179,60,0.7);
        }


        /* =====================================================
           SIDEBAR ICONS
           ===================================================== */

        .sidebar-icon {
            width: 25px;

            min-width: 25px;

            height: 25px;

            display: inline-flex;

            align-items: center;
            justify-content: center;

            color: #8FB1C8;

            font-size: 17px;

            transition:
                color 0.2s ease,
                transform 0.2s ease;
        }

        .sidebar-link:hover .sidebar-icon {
            color: #ffffff;

            transform:
                scale(1.05);
        }

        .sidebar-link.active .sidebar-icon {
            color:
                var(--food-green-light);
        }

        .sidebar-text {
            white-space: nowrap;
        }


        /* =====================================================
           NOTIFICATION BADGE
           ===================================================== */

        .notification-icon {
            position: relative;
        }

        .notification-badge {
            position: absolute;

            top: -5px;
            right: -7px;

            min-width: 17px;
            height: 17px;

            padding: 0 4px;

            display: flex;

            align-items: center;
            justify-content: center;

            border-radius: 20px;

            background: #EF4444;

            color: #ffffff;

            border:
                2px solid #123D68;

            font-size: 9px;

            font-weight: 800;
        }


        /* =====================================================
           SIDEBAR BOTTOM
           ===================================================== */

        .sidebar-bottom {
            margin-top: 25px;

            padding:
                15px 12px 18px;

            border-top:
                1px solid rgba(255,255,255,0.1);
        }

        .sidebar-bottom form {
            margin: 0;
        }

        .sidebar-logout {
            width: 100%;

            display: flex;

            align-items: center;

            gap: 12px;

            padding:
                10px 13px;

            border: 0;

            border-radius: 8px;

            background:
                rgba(255,255,255,0.06);

            color: #C8D8E5;

            font-size: 14px;

            font-weight: 500;

            transition:
                background-color 0.2s ease,
                color 0.2s ease;
        }

        .sidebar-logout:hover {
            background:
                rgba(220,53,69,0.18);

            color: #ffffff;
        }

        .sidebar-logout i {
            width: 25px;

            text-align: center;

            font-size: 17px;
        }

        .sidebar-version {
            margin-top: 12px;

            text-align: center;

            color: #7191A8;

            font-size: 10px;

            letter-spacing: 0.04em;
        }


        /* =====================================================
           MAIN WRAPPER
           ===================================================== */

        .main-wrapper {
            margin-left:
                var(--sidebar-width);

            min-height: 100vh;

            display: flex;

            flex-direction: column;
        }


        /* =====================================================
           TOPBAR
           ===================================================== */

        .topbar {
            height: 72px;

            background: #ffffff;

            border-bottom:
                1px solid #E5E7EB;

            display: flex;

            align-items: center;

            justify-content: space-between;

            padding:
                0 25px;

            position: sticky;

            top: 0;

            z-index: 1020;

            box-shadow:
                0 2px 10px rgba(18,61,104,0.05);
        }

        .topbar-left {
            display: flex;

            align-items: center;

            gap: 12px;
        }

        .topbar-title {
            font-size: 20px;

            font-weight: 700;

            color:
                var(--food-blue);

            padding-left: 13px;

            position: relative;
        }

        .topbar-title::before {
            content: "";

            position: absolute;

            left: 0;

            top: 3px;

            bottom: 3px;

            width: 4px;

            border-radius: 5px;

            background:
                linear-gradient(
                    180deg,
                    var(--food-blue),
                    var(--food-green)
                );
        }


        /* =====================================================
           MOBILE MENU BUTTON
           ===================================================== */

        .mobile-menu-button {
            display: none;

            width: 40px;
            height: 40px;

            border:
                1px solid var(--food-border);

            border-radius: 8px;

            background: #ffffff;

            color:
                var(--food-blue);

            align-items: center;

            justify-content: center;

            font-size: 21px;
        }

        .mobile-menu-button:hover {
            background:
                var(--food-green-soft);

            color:
                var(--food-green);
        }


        /* =====================================================
           TOPBAR USER
           ===================================================== */

        .topbar-user {
            display: flex;

            align-items: center;

            gap: 10px;
        }

        .user-avatar {
            width: 40px;
            height: 40px;

            border-radius: 50%;

            display: flex;

            align-items: center;
            justify-content: center;

            background:
                linear-gradient(
                    135deg,
                    var(--food-blue),
                    var(--food-green)
                );

            color: #ffffff;

            font-size: 14px;

            font-weight: 700;
        }

        .user-info {
            min-width: 120px;

            line-height: 1.2;
        }

        .user-name {
            color:
                var(--food-blue);

            font-size: 14px;

            font-weight: 700;
        }

        .user-role {
            margin-top: 3px;

            color:
                var(--food-green);

            font-size: 11px;

            font-weight: 600;
        }


        /* =====================================================
           LOGOUT BUTTON
           ===================================================== */

        .logout-button {
            width: 38px;
            height: 38px;

            display: inline-flex;

            align-items: center;
            justify-content: center;

            border-radius: 8px !important;

            color:
                var(--food-blue) !important;
        }

        .logout-button:hover {
            background:
                var(--food-blue) !important;

            color:
                #ffffff !important;
        }


        /* =====================================================
           CONTENT
           ===================================================== */

        .content {
            flex: 1;

            padding: 25px;

            width: 100%;
        }


        /* =====================================================
           CARDS
           ===================================================== */

        .card {
            border:
                1px solid var(--food-border);

            border-radius: 12px;

            box-shadow:
                0 4px 14px rgba(18,61,104,0.06);

            overflow: hidden;
        }

        .card-header {
            border-bottom:
                1px solid var(--food-border);
        }


        /* =====================================================
           BUTTONS
           ===================================================== */

        .btn-primary {
            background:
                linear-gradient(
                    135deg,
                    var(--food-blue),
                    var(--food-blue-light)
                ) !important;

            border-color:
                var(--food-blue) !important;
        }

        .btn-primary:hover {
            background:
                linear-gradient(
                    135deg,
                    var(--food-blue-dark),
                    var(--food-blue)
                ) !important;

            border-color:
                var(--food-blue-dark) !important;
        }

        .btn-success {
            background:
                linear-gradient(
                    135deg,
                    var(--food-green),
                    var(--food-green-light)
                ) !important;

            border-color:
                var(--food-green) !important;
        }

        .btn-success:hover {
            background:
                linear-gradient(
                    135deg,
                    #3D8520,
                    var(--food-green)
                ) !important;
        }

        .btn-outline-primary {
            color:
                var(--food-blue) !important;

            border-color:
                var(--food-blue) !important;
        }

        .btn-outline-primary:hover {
            color: #ffffff !important;

            background:
                var(--food-blue) !important;

            border-color:
                var(--food-blue) !important;
        }

        .btn-outline-success {
            color:
                var(--food-green) !important;

            border-color:
                var(--food-green) !important;
        }

        .btn-outline-success:hover {
            color: #ffffff !important;

            background:
                var(--food-green) !important;

            border-color:
                var(--food-green) !important;
        }


        /* =====================================================
           TABLES
           ===================================================== */

        .table thead {
            background:
                linear-gradient(
                    90deg,
                    var(--food-blue-soft),
                    var(--food-green-soft)
                );
        }

        .table thead th {
            color:
                var(--food-blue);

            font-weight: 700;

            border-bottom:
                2px solid var(--food-green);
        }

        .table-hover tbody tr:hover {
            background-color:
                #F4F9F3;
        }


        /* =====================================================
           BADGES
           ===================================================== */

        .badge.bg-success {
            background-color:
                var(--food-green) !important;
        }


        /* =====================================================
           FORMS
           ===================================================== */

        .form-control:focus,
        .form-select:focus {
            border-color:
                var(--food-green);

            box-shadow:
                0 0 0 0.2rem
                rgba(75,155,40,0.15);
        }


        /* =====================================================
           CONTENT LINKS
           ===================================================== */

        .content a:not(.btn) {
            color:
                var(--food-blue);
        }

        .content a:not(.btn):hover {
            color:
                var(--food-green);
        }


        /* =====================================================
           ALERTS
           ===================================================== */

        .alert-success {
            border-left:
                4px solid var(--food-green);
        }

        .alert-info {
            border-left:
                4px solid var(--food-blue);
        }


        /* =====================================================
           FOOTER
           ===================================================== */

        .footer {
            background:
                linear-gradient(
                    90deg,
                    #ffffff,
                    #F3F8F1
                );

            border-top:
                1px solid var(--food-border);

            padding:
                15px 25px;

            color:
                var(--food-muted);

            font-size: 13px;

            line-height: normal;

            white-space: normal;
        }

        .footer strong {
            color:
                var(--food-blue);
        }


        /* =====================================================
           TABLET
           ===================================================== */

        @@media (max-width: 991.98px) {

            :root {
                --sidebar-width: 220px;
            }

            .sidebar {
                width:
                    var(--sidebar-width);
            }

            .main-wrapper {
                margin-left:
                    var(--sidebar-width);
            }

            .topbar {
                padding:
                    0 20px;
            }

            .content {
                padding:
                    20px;
            }
        }


        /* =====================================================
           MOBILE
           ===================================================== */

        @@media (max-width: 767.98px) {

            .sidebar {
                width: 270px;

                left: -270px;

                transition:
                    left 0.25s ease;
            }

            .sidebar.mobile-open {
                left: 0;
            }

            .sidebar-close {
                display: flex;
            }

            .main-wrapper {
                margin-left: 0;
            }

            .topbar {
                height: 65px;

                padding:
                    0 15px;
            }

            .mobile-menu-button {
                display: flex;
            }

            .topbar-title {
                font-size: 17px;
            }

            .user-info {
                display: none;
            }

            .topbar-user {
                gap: 6px;
            }

            .content {
                padding:
                    15px;
            }

            .footer {
                padding:
                    12px 15px;
            }
        }


        /* =====================================================
           SMALL MOBILE
           ===================================================== */

        @@media (max-width: 480px) {

            .topbar {
                padding:
                    0 10px;
            }

            .topbar-title {
                font-size: 16px;
            }

            .content {
                padding:
                    10px;
            }

            .user-avatar {
                width: 36px;
                height: 36px;
            }

            .logout-button {
                width: 36px;
                height: 36px;
            }
        }

    </style>

    @await RenderSectionAsync("Styles", required: false)

</head>


<body>


    <!-- =====================================================
         SIDEBAR
         ===================================================== -->

    <aside class="sidebar" id="foodSidebar">


        <!-- =================================================
             BRAND
             ================================================= -->

        <div class="sidebar-brand">

            <a asp-controller="Dashboard"
               asp-action="Index">

                <img src="~/images/foodsupply-logo.png"
                     alt="FoodSupply Logo" />

            </a>

            <button type="button"
                    class="sidebar-close"
                    id="sidebarClose"
                    aria-label="Close menu">

                <i class="bi bi-x-lg"></i>

            </button>

        </div>


        <!-- =================================================
             USER MINI PROFILE
             ================================================= -->

        @if (isAuthenticated)
        {
            <div class="sidebar-user">

                <div class="sidebar-user-avatar">
                    @firstLetter
                </div>

                <div class="sidebar-user-info">

                    <div class="sidebar-user-name">
                        @displayName
                    </div>

                    <div class="sidebar-user-role">
                        @displayRole
                    </div>

                </div>

            </div>
        }


        <!-- =================================================
             MAIN
             ================================================= -->

        <div class="sidebar-section">
            Main
        </div>


        @if (canViewDashboard)
        {
            <a class="sidebar-link @(currentController == "Dashboard" ? "active" : "")"
               asp-controller="Dashboard"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-grid-1x2-fill"></i>
                </span>

                <span class="sidebar-text">
