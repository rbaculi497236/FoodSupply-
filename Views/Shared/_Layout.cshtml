@using Microsoft.EntityFrameworkCore
@inject FoodSupply.Data.ApplicationDbContext DbContext

@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;

    // =========================================================
    // FOODSUPPLY - CURRENT 4 ROLE SYSTEM
    // =========================================================

    var isAdmin = User.IsInRole("Admin");

    var isManager =
        isAdmin ||
        User.IsInRole("Manager");

    var isSalesBilling =
        User.IsInRole("Sales Staff / Billing Staff");

    var isDelivery =
        User.IsInRole("Delivery Staff");

    // =========================================================
    // MODULE ACCESS
    // =========================================================

    // Dashboard
    var canViewDashboard =
        isAdmin ||
        isManager ||
        isSalesBilling ||
        isDelivery;

    // Products
    // Admin / Manager can manage products.
    // Sales/Billing can view products.
    var canViewProducts =
        isAdmin ||
        isManager ||
        isSalesBilling;

    var canManageProducts =
        isAdmin ||
        isManager;

    // Categories
    var canManageCategories =
        isAdmin ||
        isManager;

    // Suppliers
    var canManageSuppliers =
        isAdmin ||
        isManager;

    // Customers
    // Manager/Admin manage customers.
    // Sales/Billing can also access customers.
    var canViewCustomers =
        isAdmin ||
        isManager ||
        isSalesBilling;

    var canManageCustomers =
        isAdmin ||
        isManager ||
        isSalesBilling;

    // CRM
    var canViewCRM =
        isAdmin ||
        isManager ||
        isSalesBilling;

    // Inventory
    var canViewInventory =
        isAdmin ||
        isManager;

    // Purchasing
    var canManagePurchasing =
        isAdmin ||
        isManager;

    // Sales Orders
    var canManageSales =
        isAdmin ||
        isManager ||
        isSalesBilling;

    // Deliveries
    var canManageDelivery =
        isAdmin ||
        isManager ||
        isDelivery;

    // Billing
    var canViewBilling =
        isAdmin ||
        isManager ||
        isSalesBilling;

    // Reports
    // Delivery Staff is included because your ReportsController
    // currently authorizes Delivery Staff.
    var canViewReports =
        isAdmin ||
        isManager ||
        isSalesBilling ||
        isDelivery;

    // Users
    var canManageUsers =
        isAdmin;

    // Notifications
    var canViewNotifications =
        isAdmin ||
        isManager ||
        isSalesBilling ||
        isDelivery;

    // =========================================================
    // INVENTORY ALERT COUNT
    // =========================================================

    var inventoryAlertCount = 0;

    if (isAuthenticated)
    {
        inventoryAlertCount = await DbContext.Inventories
            .CountAsync(i =>
                !i.IsArchived &&
                (
                    i.StockQuantity <= i.ReorderLevel ||
                    (
                        i.ExpirationDate.HasValue &&
                        i.ExpirationDate.Value <= DateTime.Today.AddDays(30)
                    ) ||
                    i.SpoiledQuantity > 0 ||
                    i.DamagedQuantity > 0
                )
            );
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - FoodSupply
    </title>

    <!-- Bootstrap 5 -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- FoodSupply Site CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <style>

        /* =====================================================
           GLOBAL
           ===================================================== */

        html,
        body {
            height: 100%;
        }

        body {
            margin: 0;
            background-color: #f5f7fb;
            font-family:
                "Segoe UI",
                Tahoma,
                Geneva,
                Verdana,
                sans-serif;
        }

        a {
            text-decoration: none;
        }

        /* =====================================================
           SIDEBAR
           ===================================================== */

        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;

            width: 250px;

            background: #ffffff;

            border-right: 1px solid #e5e7eb;

            overflow-y: auto;

            z-index: 1030;
        }

        .sidebar-brand {
            height: 75px;

            display: flex;
            align-items: center;

            padding: 15px 20px;

            border-bottom: 1px solid #e5e7eb;
        }

        .sidebar-brand img {
            max-width: 185px;
            max-height: 55px;

            object-fit: contain;
        }

        .sidebar-section {
            padding: 18px 15px 7px;

            font-size: 11px;

            font-weight: 700;

            text-transform: uppercase;

            color: #9ca3af;

            letter-spacing: 0.08em;
        }

        .sidebar-link {
            display: flex;
            align-items: center;

            gap: 12px;

            margin: 3px 10px;

            padding: 10px 13px;

            border-radius: 8px;

            color: #4b5563;

            font-size: 14px;

            transition: all 0.2s ease;
        }

        .sidebar-link:hover {
            background-color: #f0f4ff;

            color: #2563eb;
        }

        .sidebar-link.active {
            background-color: #e8f0ff;

            color: #2563eb;

            font-weight: 600;
        }

        .sidebar-icon {
            width: 24px;

            display: inline-flex;

            justify-content: center;

            font-size: 17px;
        }

        /* =====================================================
           MAIN CONTENT
           ===================================================== */

        .main-wrapper {
            margin-left: 250px;

            min-height: 100vh;

            display: flex;

            flex-direction: column;
        }

        /* =====================================================
           TOPBAR
           ===================================================== */

        .topbar {
            height: 75px;

            background: #ffffff;

            border-bottom: 1px solid #e5e7eb;

            display: flex;

            align-items: center;

            justify-content: space-between;

            padding: 0 25px;

            position: sticky;

            top: 0;

            z-index: 1020;
        }

        .topbar-title {
            font-size: 20px;

            font-weight: 600;

            color: #1f2937;
        }

        .topbar-user {
            display: flex;

            align-items: center;

            gap: 10px;
        }

        .user-avatar {
            width: 38px;

            height: 38px;

            border-radius: 50%;

            background: #2563eb;

            color: white;

            display: flex;

            align-items: center;

            justify-content: center;

            font-weight: 600;
        }

        .user-info {
            line-height: 1.2;
        }

        .user-name {
            font-weight: 600;

            font-size: 14px;

            color: #1f2937;
        }

        .user-role {
            font-size: 12px;

            color: #6b7280;
        }

        /* =====================================================
           NOTIFICATION
           ===================================================== */

        .notification-link {
            position: relative;

            display: inline-flex;

            align-items: center;

            justify-content: center;

            width: 40px;

            height: 40px;

            border-radius: 50%;

            color: #4b5563;
        }

        .notification-link:hover {
            background: #f3f4f6;

            color: #2563eb;
        }

        .notification-badge {
            position: absolute;

            top: 2px;

            right: 2px;

            min-width: 18px;

            height: 18px;

            padding: 0 4px;

            border-radius: 50px;

            background: #dc3545;

            color: white;

            font-size: 10px;

            display: flex;

            align-items: center;

            justify-content: center;

            border: 2px solid white;
        }

        /* =====================================================
           CONTENT
           ===================================================== */

        .content {
            flex: 1;

            padding: 25px;
        }

        /* =====================================================
           FOOTER
           ===================================================== */

        .footer {
            background: #ffffff;

            border-top: 1px solid #e5e7eb;

            padding: 15px 25px;

            color: #6b7280;

            font-size: 13px;
        }

        /* =====================================================
           RESPONSIVE
           ===================================================== */

        @@media (max-width: 991.98px) {

            .sidebar {
                width: 220px;
            }

            .main-wrapper {
                margin-left: 220px;
            }
        }

        @@media (max-width: 767.98px) {

            .sidebar {
                position: relative;

                width: 100%;

                height: auto;

                max-height: none;
            }

            .main-wrapper {
                margin-left: 0;
            }

            .topbar {
                position: relative;

                height: auto;

                min-height: 70px;

                padding: 12px 15px;
            }

            .content {
                padding: 15px;
            }

            .sidebar-brand {
                justify-content: center;
            }
        }

    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <!-- =====================================================
         SIDEBAR
         ===================================================== -->

    <aside class="sidebar">

        <!-- Logo -->
        <div class="sidebar-brand">

            <a asp-controller="Home"
               asp-action="Index">

                <img src="~/images/foodsupply-logo.png"
                     alt="FoodSupply Logo" />

            </a>

        </div>


        <!-- =================================================
             MAIN
             ================================================= -->

        <div class="sidebar-section">
            Main
        </div>


        @if (canViewDashboard)
        {
            <a class="sidebar-link"
               asp-controller="Home"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-speedometer2"></i>
                </span>

                <span>
                    Dashboard
                </span>

            </a>
        }


        <!-- =================================================
             MANAGEMENT
             ================================================= -->

        <div class="sidebar-section">
            Management
        </div>


        @if (canViewProducts)
        {
            <a class="sidebar-link"
               asp-controller="Products"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-box-seam"></i>
                </span>

                <span>
                    Products
                </span>

            </a>
        }


        @if (canManageCategories)
        {
            <a class="sidebar-link"
               asp-controller="Categories"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-tags"></i>
                </span>

                <span>
                    Categories
                </span>

            </a>
        }


        @if (canManageSuppliers)
        {
            <a class="sidebar-link"
               asp-controller="Suppliers"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-truck"></i>
                </span>

                <span>
                    Suppliers
                </span>

            </a>
        }


        @if (canViewCustomers)
        {
            <a class="sidebar-link"
               asp-controller="Customers"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-people"></i>
                </span>

                <span>
                    Customers
                </span>

            </a>
        }


        @if (canViewCRM)
        {
            <a class="sidebar-link"
               asp-controller="CRM"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-person-lines-fill"></i>
                </span>

                <span>
                    CRM
                </span>

            </a>
        }


        <!-- =================================================
             OPERATIONS
             ================================================= -->

        <div class="sidebar-section">
            Operations
        </div>


        @if (canViewInventory)
        {
            <a class="sidebar-link"
               asp-controller="Inventory"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-clipboard-data"></i>
                </span>

                <span>
                    Inventory
                </span>

            </a>
        }


        @if (canManagePurchasing)
        {
            <a class="sidebar-link"
               asp-controller="Purchases"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-cart-check"></i>
                </span>

                <span>
                    Purchasing
                </span>

            </a>
        }


        @if (canManageSales)
        {
            <a class="sidebar-link"
               asp-controller="SalesOrders"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-receipt"></i>
                </span>

                <span>
                    Sales Orders
                </span>

            </a>
        }


        @if (canManageDelivery)
        {
            <a class="sidebar-link"
               asp-controller="Deliveries"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-truck-front"></i>
                </span>

                <span>
                    Deliveries
                </span>

            </a>
        }


        @if (canViewBilling)
        {
            <a class="sidebar-link"
               asp-controller="Billing"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-cash-stack"></i>
                </span>

                <span>
                    Billing
                </span>

            </a>
        }


        @if (canViewReports)
        {
            <a class="sidebar-link"
               asp-controller="Reports"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-bar-chart-line"></i>
                </span>

                <span>
                    Reports
                </span>

            </a>
        }


        <!-- =================================================
             SYSTEM
             ================================================= -->

        <div class="sidebar-section">
            System
        </div>


        @if (canManageUsers)
        {
            <a class="sidebar-link"
               asp-controller="Users"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-person-gear"></i>
                </span>

                <span>
                    Users
                </span>

            </a>
        }


        @if (isAuthenticated)
        {
            <a class="sidebar-link"
               asp-controller="Home"
               asp-action="Privacy">

                <span class="sidebar-icon">
                    <i class="bi bi-shield-check"></i>
                </span>

                <span>
                    Privacy
                </span>

            </a>
        }


        <!-- =================================================
             NOTIFICATIONS
             ================================================= -->

        @if (canViewNotifications)
        {
            <a class="sidebar-link"
               asp-controller="Notifications"
               asp-action="Index">

                <span class="sidebar-icon position-relative">

                    <i class="bi bi-bell"></i>

                    @if (inventoryAlertCount > 0)
                    {
                        <span class="notification-badge">
                            @(inventoryAlertCount > 99 ? "99+" : inventoryAlertCount)
                        </span>
                    }

                </span>

                <span>
                    Notifications
                </span>

            </a>
        }

    </aside>


    <!-- =====================================================
         MAIN WRAPPER
         ===================================================== -->

    <div class="main-wrapper">

        <!-- =================================================
             TOPBAR
             ================================================= -->

        <header class="topbar">

            <div class="topbar-title">

                @ViewData["Title"]

            </div>


            @if (isAuthenticated)
            {
                <div class="topbar-user">

                    <!-- Notification Icon -->

                    @if (canViewNotifications)
                    {
                        <a class="notification-link"
                           asp-controller="Notifications"
                           asp-action="Index"
                           title="Notifications">

                            <i class="bi bi-bell fs-5"></i>

                            @if (inventoryAlertCount > 0)
                            {
                                <span class="notification-badge">
                                    @(inventoryAlertCount > 99 ? "99+" : inventoryAlertCount)
                                </span>
                            }

                        </a>
                    }


                    <!-- User -->

                    <div class="user-avatar">

                        @{
                            var displayName =
                                User.Identity?.Name ?? "User";

                            var firstLetter =
                                displayName.Length > 0
                                    ? displayName.Substring(0, 1).ToUpper()
                                    : "U";
                        }

                        @firstLetter

                    </div>


                    <div class="user-info">

                        <div class="user-name">
                            @(User.Identity?.Name ?? "User")
                        </div>

                        <div class="user-role">

                            @if (isAdmin)
                            {
                                <span>Admin</span>
                            }
                            else if (User.IsInRole("Manager"))
                            {
                                <span>Manager</span>
                            }
                            else if (isSalesBilling)
                            {
                                <span>Sales Staff / Billing Staff</span>
                            }
                            else if (isDelivery)
                            {
                                <span>Delivery Staff</span>
                            }
                            else
                            {
                                <span>User</span>
                            }

                        </div>

                    </div>


                    <!-- Logout -->

                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post"
                          class="ms-2">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-outline-danger btn-sm"
                                title="Logout">

                            <i class="bi bi-box-arrow-right"></i>

                        </button>

                    </form>

                </div>
            }

        </header>


        <!-- =================================================
             PAGE CONTENT
             ================================================= -->

        <main class="content">

            @RenderBody()

        </main>


        <!-- =================================================
             FOOTER
             ================================================= -->

        <footer class="footer">

            <div class="d-flex justify-content-between align-items-center flex-wrap">

                <div>
                    &copy; @DateTime.Now.Year
                    <strong>FoodSupply</strong>.
                    All rights reserved.
                </div>

                <div>
                    <span class="text-muted">
                        Food Supply ERP System
                    </span>
                </div>

            </div>

        </footer>

    </div>


    <!-- =====================================================
         JAVASCRIPT
         ===================================================== -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
