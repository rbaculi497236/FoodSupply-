@using Microsoft.EntityFrameworkCore
@using System.Security.Claims

@inject FoodSupply.Data.ApplicationDbContext DbContext

@{
    /* =========================================================
       AUTHENTICATION
       ========================================================= */

    var isAuthenticated = User.Identity?.IsAuthenticated == true;

    // Get the role directly from the authentication cookie/claims.
    // Trim whitespace and compare case-insensitively below.
    var currentRole = User.Claims
        .FirstOrDefault(c => c.Type == ClaimTypes.Role)
        ?.Value?
        .Trim() ?? "";

    /* =========================================================
       ROLE CHECKS
       ========================================================= */

    var isAdmin = string.Equals(
        currentRole,
        "Admin",
        StringComparison.OrdinalIgnoreCase
    );

    var isManager = string.Equals(
        currentRole,
        "Manager",
        StringComparison.OrdinalIgnoreCase
    );

    var isSalesBilling = string.Equals(
        currentRole,
        "Sales Staff / Billing Staff",
        StringComparison.OrdinalIgnoreCase
    );

    var isDelivery = string.Equals(
        currentRole,
        "Delivery Staff",
        StringComparison.OrdinalIgnoreCase
    );

    /* =========================================================
       ROLE HIERARCHY
       ========================================================= */

    var canViewDashboard =
        isAdmin ||
        isManager ||
        isSalesBilling ||
        isDelivery;

    var canViewProducts =
        isAdmin ||
        isManager ||
        isSalesBilling;

    var canManageCategories =
        isAdmin ||
        isManager;

    var canManageSuppliers =
        isAdmin ||
        isManager;

    var canViewCustomers =
        isAdmin ||
        isManager ||
        isSalesBilling;

    var canViewCRM =
        isAdmin ||
        isManager ||
        isSalesBilling;

    var canViewInventory =
        isAdmin ||
        isManager;

    var canManagePurchasing =
        isAdmin ||
        isManager;

    var canManageSales =
        isAdmin ||
        isManager ||
        isSalesBilling;

    var canManageDelivery =
        isAdmin ||
        isManager ||
        isDelivery;

    var canViewBilling =
        isAdmin ||
        isManager ||
        isSalesBilling;

    var canViewReports =
        isAdmin ||
        isManager ||
        isSalesBilling ||
        isDelivery;

    var canManageUsers =
        isAdmin;

    var canViewNotifications =
        isAdmin ||
        isManager ||
        isSalesBilling ||
        isDelivery;

    /* =========================================================
       CURRENT PAGE
       ========================================================= */

    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    var currentAction =
        ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    /* =========================================================
       INVENTORY ALERT COUNT
       ========================================================= */

    var inventoryAlertCount = 0;

    if (isAuthenticated)
    {
        inventoryAlertCount = await DbContext.Inventories
            .CountAsync(i =>
                !i.IsArchived &&
                (
                    i.StockQuantity <= i.ReorderLevel ||

                    (
                        i.ExpirationDate.HasValue &&
                        i.ExpirationDate.Value <=
                            DateTime.Today.AddDays(30)
                    ) ||

                    i.SpoiledQuantity > 0 ||

                    i.DamagedQuantity > 0
                )
            );
    }

    /* =========================================================
       USER DISPLAY
       ========================================================= */

    var displayName =
        User.Identity?.Name ?? "User";

    var firstLetter =
        !string.IsNullOrWhiteSpace(displayName)
            ? displayName.Substring(0, 1).ToUpper()
            : "U";

    var displayRole = "User";

    if (isAdmin)
    {
        displayRole = "Admin";
    }
    else if (isManager)
    {
        displayRole = "Manager";
    }
    else if (isSalesBilling)
    {
        displayRole = "Sales Staff / Billing Staff";
    }
    else if (isDelivery)
    {
        displayRole = "Delivery Staff";
    }
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - FoodSupply
    </title>

    <!-- =====================================================
         BOOTSTRAP
         ===================================================== -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- =====================================================
         BOOTSTRAP ICONS
         ===================================================== -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- =====================================================
         FOODSUPPLY CSS
         ===================================================== -->

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <!-- =====================================================
         LAYOUT CSS
         ===================================================== -->

    <style>

        /* =====================================================
           GLOBAL
           ===================================================== */

        html,
        body {
            min-height: 100%;
        }

        html {
            position: relative;
        }

        body {
            margin: 0;
            background-color: #f5f7fb;
            font-family:
                "Segoe UI",
                Tahoma,
                Geneva,
                Verdana,
                sans-serif;
        }

        a {
            text-decoration: none;
        }

        /* =====================================================
           SIDEBAR
           ===================================================== */

        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;

            width: 250px;

            background: #ffffff;

            border-right: 1px solid #e5e7eb;

            overflow-y: auto;

            z-index: 1030;

            scrollbar-width: thin;
        }

        .sidebar::-webkit-scrollbar {
            width: 6px;
        }

        .sidebar::-webkit-scrollbar-thumb {
            background: #d1d5db;
            border-radius: 10px;
        }

        /* =====================================================
           SIDEBAR BRAND
           ===================================================== */

        .sidebar-brand {
            height: 75px;

            display: flex;
            align-items: center;

            padding: 10px 20px;

            border-bottom: 1px solid #e5e7eb;
        }

        .sidebar-brand a {
            width: 100%;
            display: flex;
            align-items: center;
        }

        .sidebar-brand img {
            max-width: 185px;
            max-height: 55px;

            object-fit: contain;
        }

        /* =====================================================
           SIDEBAR SECTION
           ===================================================== */

        .sidebar-section {
            padding: 20px 15px 7px;

            font-size: 11px;

            font-weight: 700;

            text-transform: uppercase;

            color: #9ca3af;

            letter-spacing: 0.08em;
        }

        /* =====================================================
           SIDEBAR LINK
           ===================================================== */

        .sidebar-link {
            display: flex;

            align-items: center;

            gap: 12px;

            margin: 3px 10px;

            padding: 10px 13px;

            border-radius: 8px;

            color: #4b5563;

            font-size: 14px;

            transition:
                background-color 0.2s ease,
                color 0.2s ease,
                transform 0.2s ease;
        }

        .sidebar-link:hover {
            background-color: #f0f4ff;

            color: #2563eb;

            transform: translateX(2px);
        }

        .sidebar-link.active {
            background-color: #e8f0ff;

            color: #2563eb;

            font-weight: 600;
        }

        .sidebar-icon {
            width: 24px;

            min-width: 24px;

            display: inline-flex;

            align-items: center;

            justify-content: center;

            font-size: 17px;
        }

        .sidebar-link span:last-child {
            white-space: nowrap;
        }

        /* =====================================================
           MAIN WRAPPER
           ===================================================== */

        .main-wrapper {
            margin-left: 250px;

            min-height: 100vh;

            display: flex;

            flex-direction: column;
        }

        /* =====================================================
           TOPBAR
           ===================================================== */

        .topbar {
            height: 75px;

            background: #ffffff;

            border-bottom: 1px solid #e5e7eb;

            display: flex;

            align-items: center;

            justify-content: space-between;

            padding: 0 25px;

            position: sticky;

            top: 0;

            z-index: 1020;
        }

        .topbar-title {
            font-size: 20px;

            font-weight: 600;

            color: #1f2937;
        }

        .topbar-user {
            display: flex;

            align-items: center;

            gap: 10px;
        }

        /* =====================================================
           USER AVATAR
           ===================================================== */

        .user-avatar {
            width: 38px;

            height: 38px;

            min-width: 38px;

            border-radius: 50%;

            background: #2563eb;

            color: #ffffff;

            display: flex;

            align-items: center;

            justify-content: center;

            font-weight: 600;

            font-size: 15px;
        }

        /* =====================================================
           USER INFO
           ===================================================== */

        .user-info {
            line-height: 1.2;

            min-width: 100px;
        }

        .user-name {
            font-weight: 600;

            font-size: 14px;

            color: #1f2937;
        }

        .user-role {
            font-size: 12px;

            color: #6b7280;

            margin-top: 3px;
        }

        /* =====================================================
           NOTIFICATION
           ===================================================== */

        .notification-link {
            position: relative;

            display: inline-flex;

            align-items: center;

            justify-content: center;

            width: 40px;

            height: 40px;

            border-radius: 50%;

            color: #4b5563;

            transition:
                background-color 0.2s ease,
                color 0.2s ease;
        }

        .notification-link:hover {
            background: #f3f4f6;

            color: #2563eb;
        }

        .notification-badge {
            position: absolute;

            top: 0;

            right: 0;

            min-width: 18px;

            height: 18px;

            padding: 0 4px;

            border-radius: 50px;

            background: #dc3545;

            color: #ffffff;

            font-size: 10px;

            font-weight: 600;

            display: flex;

            align-items: center;

            justify-content: center;

            border: 2px solid #ffffff;
        }

        /* =====================================================
           CONTENT
           ===================================================== */

        .content {
            flex: 1;

            padding: 25px;

            width: 100%;
        }

        /* =====================================================
           FOOTER
           ===================================================== */

        .footer {
            background: #ffffff;

            border-top: 1px solid #e5e7eb;

            padding: 15px 25px;

            color: #6b7280;

            font-size: 13px;

            line-height: normal;

            white-space: normal;
        }

        /* =====================================================
           LOGOUT BUTTON
           ===================================================== */

        .logout-button {
            width: 38px;

            height: 38px;

            display: inline-flex;

            align-items: center;

            justify-content: center;

            border-radius: 8px;
        }

        /* =====================================================
           RESPONSIVE - TABLET
           ===================================================== */

        @@media (max-width: 991.98px) {

            .sidebar {
                width: 220px;
            }

            .main-wrapper {
                margin-left: 220px;
            }

            .topbar {
                padding: 0 20px;
            }

            .content {
                padding: 20px;
            }

        }

        /* =====================================================
           RESPONSIVE - MOBILE
           ===================================================== */

        @@media (max-width: 767.98px) {

            .sidebar {
                position: relative;

                width: 100%;

                height: auto;

                max-height: none;

                border-right: none;

                border-bottom: 1px solid #e5e7eb;
            }

            .main-wrapper {
                margin-left: 0;
            }

            .topbar {
                position: relative;

                height: auto;

                min-height: 70px;

                padding: 12px 15px;
            }

            .topbar-title {
                font-size: 18px;
            }

            .content {
                padding: 15px;
            }

            .sidebar-brand {
                justify-content: center;
            }

            .user-info {
                display: none;
            }

            .topbar-user {
                gap: 6px;
            }

        }

        /* =====================================================
           VERY SMALL MOBILE
           ===================================================== */

        @@media (max-width: 480px) {

            .topbar-title {
                font-size: 16px;
            }

            .topbar {
                padding: 10px;
            }

            .content {
                padding: 10px;
            }

        }

    </style>

    @await RenderSectionAsync("Styles", required: false)

</head>

<body>

    <!-- =====================================================
         SIDEBAR
         ===================================================== -->

    <aside class="sidebar">

        <!-- =================================================
             LOGO
             ================================================= -->

        <div class="sidebar-brand">

            <a asp-controller="Dashboard"
               asp-action="Index">

                <img src="~/images/foodsupply-logo.png"
                     alt="FoodSupply Logo" />

            </a>

        </div>


        <!-- =================================================
             MAIN
             ================================================= -->

        <div class="sidebar-section">
            Main
        </div>

        @if (canViewDashboard)
        {
            <a class="sidebar-link @(currentController == "Dashboard" ? "active" : "")"
               asp-controller="Dashboard"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-speedometer2"></i>
                </span>

                <span>
                    Dashboard
                </span>

            </a>
        }


        <!-- =================================================
             MANAGEMENT
             ================================================= -->

        <div class="sidebar-section">
            Management
        </div>

        @if (canViewProducts)
        {
            <a class="sidebar-link @(currentController == "Products" ? "active" : "")"
               asp-controller="Products"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-box-seam"></i>
                </span>

                <span>
                    Products
                </span>

            </a>
        }

        @if (canManageCategories)
        {
            <a class="sidebar-link @(currentController == "Categories" ? "active" : "")"
               asp-controller="Categories"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-tags"></i>
                </span>

                <span>
                    Categories
                </span>

            </a>
        }

        @if (canManageSuppliers)
        {
            <a class="sidebar-link @(currentController == "Suppliers" ? "active" : "")"
               asp-controller="Suppliers"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-truck"></i>
                </span>

                <span>
                    Suppliers
                </span>

            </a>
        }

        @if (canViewCustomers)
        {
            <a class="sidebar-link @(currentController == "Customers" ? "active" : "")"
               asp-controller="Customers"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-people"></i>
                </span>

                <span>
                    Customers
                </span>

            </a>
        }

        @if (canViewCRM)
        {
            <a class="sidebar-link @(currentController == "CRM" ? "active" : "")"
               asp-controller="CRM"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-person-lines-fill"></i>
                </span>

                <span>
                    CRM
                </span>

            </a>
        }


        <!-- =================================================
             OPERATIONS
             ================================================= -->

        <div class="sidebar-section">
            Operations
        </div>

        @if (canViewInventory)
        {
            <a class="sidebar-link @(currentController == "Inventories" ? "active" : "")"
               asp-controller="Inventories"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-clipboard-data"></i>
                </span>

                <span>
                    Inventory
                </span>

            </a>
        }

        @if (canManagePurchasing)
        {
            <a class="sidebar-link @(currentController == "Purchases" ? "active" : "")"
               asp-controller="Purchases"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-cart-check"></i>
                </span>

                <span>
                    Purchasing
                </span>

            </a>
        }

        @if (canManageSales)
        {
            <a class="sidebar-link @(currentController == "SalesOrders" ? "active" : "")"
               asp-controller="SalesOrders"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-receipt"></i>
                </span>

                <span>
                    Sales Orders
                </span>

            </a>
        }

        @if (canManageDelivery)
        {
            <a class="sidebar-link @(currentController == "Deliveries" ? "active" : "")"
               asp-controller="Deliveries"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-truck-front"></i>
                </span>

                <span>
                    Deliveries
                </span>

            </a>
        }

        @if (canViewBilling)
        {
            <a class="sidebar-link @(currentController == "Billings" ? "active" : "")"
               asp-controller="Billings"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-cash-stack"></i>
                </span>

                <span>
                    Billing
                </span>

            </a>
        }

        @if (canViewReports)
        {
            <a class="sidebar-link @(currentController == "Reports" ? "active" : "")"
               asp-controller="Reports"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-bar-chart-line"></i>
                </span>

                <span>
                    Reports
                </span>

            </a>
        }


        <!-- =================================================
             SYSTEM
             ================================================= -->

        <div class="sidebar-section">
            System
        </div>

        @if (canManageUsers)
        {
            <a class="sidebar-link @(currentController == "Users" ? "active" : "")"
               asp-controller="Users"
               asp-action="Index">

                <span class="sidebar-icon">
                    <i class="bi bi-person-gear"></i>
                </span>

                <span>
                    Users
                </span>

            </a>
        }

        @if (isAuthenticated)
        {
            <a class="sidebar-link @(currentController == "Home" && currentAction == "Privacy" ? "active" : "")"
               asp-controller="Home"
               asp-action="Privacy">

                <span class="sidebar-icon">
                    <i class="bi bi-shield-check"></i>
                </span>

                <span>
                    Privacy
                </span>

            </a>
        }

        @if (canViewNotifications)
        {
            <a class="sidebar-link @(currentController == "Notifications" ? "active" : "")"
               asp-controller="Notifications"
               asp-action="Index">

                <span class="sidebar-icon position-relative">

                    <i class="bi bi-bell"></i>

                    @if (inventoryAlertCount > 0)
                    {
                        <span class="notification-badge">

                            @(inventoryAlertCount > 99
                                ? "99+"
                                : inventoryAlertCount)

                        </span>
                    }

                </span>

                <span>
                    Notifications
                </span>

            </a>
        }

    </aside>


    <!-- =====================================================
         MAIN WRAPPER
         ===================================================== -->

    <div class="main-wrapper">


        <!-- =================================================
             TOPBAR
             ================================================= -->

        <header class="topbar">

            <div class="topbar-title">

                @ViewData["Title"]

            </div>


            @if (isAuthenticated)
            {
                <div class="topbar-user">

                    <!-- =====================================
                         NOTIFICATIONS
                         ===================================== -->

                    @if (canViewNotifications)
                    {
                        <a class="notification-link"
                           asp-controller="Notifications"
                           asp-action="Index"
                           title="Notifications">

                            <i class="bi bi-bell fs-5"></i>

                            @if (inventoryAlertCount > 0)
                            {
                                <span class="notification-badge">

                                    @(inventoryAlertCount > 99
                                        ? "99+"
                                        : inventoryAlertCount)

                                </span>
                            }

                        </a>
                    }


                    <!-- =====================================
                         USER AVATAR
                         ===================================== -->

                    <div class="user-avatar">

                        @firstLetter

                    </div>


                    <!-- =====================================
                         USER INFORMATION
                         ===================================== -->

                    <div class="user-info">

                        <div class="user-name">

                            @displayName

                        </div>

                        <div class="user-role">

                            @displayRole

                        </div>

                    </div>


                    <!-- =====================================
                         LOGOUT
                         ===================================== -->

                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post"
                          class="ms-2">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-outline-danger btn-sm logout-button"
                                title="Logout">

                            <i class="bi bi-box-arrow-right"></i>

                        </button>

                    </form>

                </div>
            }

        </header>


        <!-- =================================================
             PAGE CONTENT
             ================================================= -->

        <main class="content">

            @RenderBody()

        </main>


        <!-- =================================================
             FOOTER
             ================================================= -->

        <footer class="footer">

            <div class="d-flex
                        justify-content-between
                        align-items-center
                        flex-wrap">

                <div>

                    &copy; @DateTime.Now.Year

                    <strong>
                        FoodSupply
                    </strong>.

                    All rights reserved.

                </div>

                <div>

                    <span class="text-muted">
                        Food Supply ERP System
                    </span>

                </div>

            </div>

        </footer>

    </div>


    <!-- =====================================================
         JAVASCRIPT
         ===================================================== -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>