@model IReadOnlyList<FoodSupply.Models.InventoryNotification>
@{
    ViewData["Title"] = "Notifications";
    var canInspect = User.IsInRole("Admin") || User.IsInRole("Main Admin") || User.IsInRole("Manager");
}
<div class="mb-4">
    <h1 class="fw-bold"><i class="bi bi-bell me-2"></i>Notifications</h1>
    <p class="text-muted">@ViewBag.TotalItems product(s) need attention. Expiry alerts include expired stock and stock expiring within 30 days.</p>
    <p>Use the actions below to resolve each issue. The bell count updates automatically when a product has no remaining alerts.</p>
    @if (!canInspect)
    {
        <div class="alert alert-info">Ask an administrator or manager to resolve these inventory issues.</div>
    }
</div>
@if (Model.Count == 0)
{
    <div class="alert alert-success" role="status">
        <i class="bi bi-check-circle me-2"></i>No inventory alerts at the moment.
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead><tr><th scope="col">Product</th><th scope="col">Stock / Reorder level</th><th scope="col">Alerts</th>@if (canInspect) { <th scope="col">Action</th> }</tr></thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ProductName</td>
                        <td>@item.StockQuantity / @item.ReorderLevel</td>
                        <td>
                            <div class="d-flex flex-wrap gap-2">
                                @if (item.LowStock) { <span class="badge bg-warning text-dark">Low stock</span> }
                                @if (item.Expiring) { <span class="badge bg-warning text-dark">Expired / Expiring soon</span> }
                                @if (item.Quarantined) { <span class="badge bg-danger">Quarantined stock</span> }
                                @if (item.SpoiledQuantity > 0) { <span class="badge bg-danger">Spoiled: @item.SpoiledQuantity</span> }
                                @if (item.DamagedQuantity > 0) { <span class="badge bg-danger">Damaged: @item.DamagedQuantity</span> }
                            </div>
                        </td>
                        @if (canInspect)
                        {
                            <td>
                                <div class="d-flex flex-column gap-3">
                                    @if (item.LowStock)
                                    {
                                        <div>
                                            <a asp-controller="Operations" asp-action="Batches" asp-route-productId="@item.ProductId" asp-fragment="receive-stock" class="btn btn-sm btn-outline-primary">Receive stock</a>
                                            <small class="d-block text-muted">Record received stock to bring the quantity above @item.ReorderLevel. For supplier orders, receive from the purchase details page.</small>
                                        </div>
                                    }
                                    @if (item.Expiring || item.Quarantined || item.SpoiledQuantity > 0 || item.DamagedQuantity > 0)
                                    {
                                        <div>
                                            <a asp-controller="Operations" asp-action="Batches" asp-route-productId="@item.ProductId" asp-fragment="batch-adjustments" class="btn btn-sm btn-outline-primary">Review / adjust batches</a>
                                            <small class="d-block text-muted">Record disposal by reducing the affected batch count with a reason. Release quarantine only after inspection. Expiry alerts remain while affected stock remains.</small>
                                        </div>
                                    }
                                    @if (item.LegacyExpiry || item.SpoiledQuantity > 0 || item.DamagedQuantity > 0)
                                    {
                                        <div>
                                            <a asp-controller="Inventories" asp-action="Edit" asp-route-id="@item.InventoryId" class="btn btn-sm btn-outline-primary">Review inventory record</a>
                                            <small class="d-block text-muted">After handling the stock, correct older expiry, spoiled or damaged records with a reason.</small>
                                        </div>
                                    }
                                </div>
                            </td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    @await Html.PartialAsync("_Pagination")
}
