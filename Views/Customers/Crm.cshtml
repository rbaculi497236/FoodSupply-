@using FoodSupply.Models
@{ ViewData["Title"] = "CRM"; var followUps = (IEnumerable<Customer>)(ViewBag.FollowUps ?? new List<Customer>()); var activities = (IEnumerable<CustomerActivity>)(ViewBag.RecentActivities ?? new List<CustomerActivity>()); }
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1><i class="bi bi-person-lines-fill text-success me-2"></i>Customer Relationship Management</h1><p class="text-muted mb-0">Follow-ups, customer activity, and account history</p></div><a asp-action="Index" class="btn btn-outline-secondary">Customers</a></div>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted">Customers with follow-ups</div><div class="display-6 fw-bold">@followUps.Count()</div></div></div></div><div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted">Due follow-ups</div><div class="display-6 fw-bold text-danger">@ViewBag.DueFollowUps</div></div></div></div><div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted">Recent activities</div><div class="display-6 fw-bold">@activities.Count()</div></div></div></div></div>
<div class="row g-4"><div class="col-lg-7"><div class="card border-0 shadow-sm"><div class="card-header bg-white"><strong>Upcoming Follow-ups</strong></div><div class="card-body p-0"><table class="table mb-0"><thead><tr><th>Customer</th><th>Follow-up</th><th></th></tr></thead><tbody>@foreach (var customer in followUps){<tr><td>@customer.CustomerName</td><td>@customer.NextFollowUpDate?.ToString("MMM dd, yyyy")</td><td><a asp-action="Details" asp-route-id="@customer.Id" class="btn btn-sm btn-outline-primary">Open</a></td></tr>}</tbody></table></div></div></div><div class="col-lg-5"><div class="card border-0 shadow-sm"><div class="card-header bg-white"><strong>Recent Activity</strong></div><div class="card-body">@foreach (var activity in activities){<div class="mb-3"><strong>@activity.Customer?.CustomerName</strong><div>@activity.Subject</div><small class="text-muted">@activity.ActivityType · @activity.ActivityDate.ToString("MMM dd")</small></div>}</div></div></div></div>