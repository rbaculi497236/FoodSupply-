@model IEnumerable<FoodSupply.Models.Customer>

@{
    ViewData["Title"] = "Customers";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold">

                <i class="bi bi-people-fill me-2"
                   style="color: #123D68;"></i>

                Customers

            </h1>

            <p class="text-muted mb-0">
                Manage customer records
            </p>
        </div>


        <div class="d-flex gap-2">

            <!-- Archived Customers -->
            <a asp-action="Archived"
               class="btn btn-outline-secondary">

                <i class="bi bi-archive me-1"></i>

                Archived

            </a>


            <!-- Add Customer -->
            <a asp-action="Create"
               class="btn btn-primary">

                <i class="bi bi-plus-circle me-1"></i>

                Add Customer

            </a>

        </div>

    </div>


    @await Html.PartialAsync("_TableTools")


    <div class="card shadow-sm border-0">

        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="text-center py-5">

                    <i class="bi bi-people display-4 text-muted"></i>

                    <h5 class="mt-3">
                        No customers found
                    </h5>

                    <p class="text-muted">
                        Customer records will appear here.
                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">

                            <tr>

                                <th>Customer Code</th>

                                <th>Customer Name</th>

                                <th>Contact Person</th>

                                <th>Phone Number</th>

                                <th>Email</th>

                                <th>Customer Type</th>

                                <th>Status</th>

                                <th class="text-center">
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <!-- Customer Code -->
                                    <td class="fw-semibold">
                                        @item.CustomerCode
                                    </td>


                                    <!-- Customer Name -->
                                    <td>
                                        @item.CustomerName
                                    </td>


                                    <!-- Contact Person -->
                                    <td>
                                        @(item.ContactPerson ?? "-")
                                    </td>


                                    <!-- Phone -->
                                    <td>
                                        @(item.PhoneNumber ?? "-")
                                    </td>


                                    <!-- Email -->
                                    <td>
                                        @(item.Email ?? "-")
                                    </td>


                                    <!-- Customer Type -->
                                    <td>
                                        @item.CustomerType
                                    </td>


                                    <!-- Status -->
                                    <td>

                                        @if (item.Status == "Active")
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @item.Status
                                            </span>
                                        }

                                    </td>


                                    <!-- ACTIONS -->
                                    <td class="text-center">

                                        <!-- View Details -->
                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-primary"
                                           title="View Details">

                                            <i class="bi bi-eye"></i>

                                        </a>


                                        <!-- Edit -->
                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-success"
                                           title="Edit Customer">

                                            <i class="bi bi-pencil"></i>

                                        </a>


                                        <!-- Archive -->
                                        <a asp-action="Archive"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-warning"
                                           title="Archive Customer">

                                            <i class="bi bi-archive"></i>

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>