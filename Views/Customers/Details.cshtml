@model FoodSupply.Models.Customer

@{
    ViewData["Title"] = "Customer Details";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">
                <i class="bi bi-person-vcard-fill text-info me-2"></i>
                Customer Details
            </h1>
            <p class="text-muted mb-0">
                View customer information
            </p>
        </div>

        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Customers
        </a>
    </div>

    <div class="card shadow-sm border-0">

        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="bi bi-person-fill me-2"></i>
                @Model.CustomerName
            </h5>
        </div>

        <div class="card-body p-4">

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="fw-bold text-muted">
                        Customer Code
                    </label>
                    <div class="fs-5">
                        @Model.CustomerCode
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-bold text-muted">
                        Customer Name
                    </label>
                    <div class="fs-5">
                        @Model.CustomerName
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-bold text-muted">
                        Contact Person
                    </label>
                    <div>
                        @(Model.ContactPerson ?? "-")
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-bold text-muted">
                        Phone Number
                    </label>
                    <div>
                        @(Model.PhoneNumber ?? "-")
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-bold text-muted">
                        Email
                    </label>
                    <div>
                        @(Model.Email ?? "-")
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-bold text-muted">
                        Customer Type
                    </label>
                    <div>
                        <span class="badge bg-info text-dark">
                            @Model.CustomerType
                        </span>
                    </div>
                </div>

                <div class="col-12 mb-3">
                    <label class="fw-bold text-muted">
                        Address
                    </label>
                    <div>
                        @(Model.Address ?? "-")
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-bold text-muted">
                        Status
                    </label>
                    <div>
                        @if (Model.Status == "Active")
                        {
                            <span class="badge bg-success">
                                Active
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                @Model.Status
                            </span>
                        }
                    </div>
                </div>

            </div>

            <hr />

            <div class="mt-3">

                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-warning">
                    <i class="bi bi-pencil me-1"></i>
                    Edit Customer
                </a>

                <a asp-action="Delete"
                   asp-route-id="@Model.Id"
                   class="btn btn-danger ms-2">
                    <i class="bi bi-trash me-1"></i>
                    Archive Customer
                </a>

                <a asp-action="Index"
                   class="btn btn-secondary ms-2">
                    <i class="bi bi-arrow-left me-1"></i>
                    Back
                </a>

            </div>

            <hr class="my-4" />
            <div class="row g-4">
                <div class="col-lg-6">
                    <h5><i class="bi bi-clock-history me-2"></i>Customer Activity</h5>
                    <form asp-action="AddActivity" method="post" class="border rounded p-3 mb-3">
                        <input type="hidden" name="CustomerId" value="@Model.Id" />
                        <div class="mb-2"><select name="ActivityType" class="form-select"><option>Note</option><option>Call</option><option>Email</option><option>Meeting</option><option>Complaint</option></select></div>
                        <div class="mb-2"><input name="Subject" class="form-control" placeholder="Subject" required /></div>
                        <div class="mb-2"><textarea name="Notes" class="form-control" rows="2" placeholder="Activity notes"></textarea></div>
                        <div class="mb-2"><input name="NextActionDate" type="date" class="form-control" /></div>
                        <button class="btn btn-primary btn-sm" type="submit"><i class="bi bi-plus-circle me-1"></i>Add Activity</button>
                    </form>
                    @foreach (var activity in (IEnumerable<FoodSupply.Models.CustomerActivity>)(ViewBag.Activities ?? new List<FoodSupply.Models.CustomerActivity>()))
                    {
                        <div class="border-start border-3 border-success ps-3 mb-3"><strong>@activity.Subject</strong><div class="small text-muted">@activity.ActivityType · @activity.ActivityDate.ToString("MMM dd, yyyy")</div><div>@activity.Notes</div></div>
                    }
                </div>
                <div class="col-lg-6">
                    <h5><i class="bi bi-bar-chart-line me-2"></i>Customer History</h5>
                    <p class="mb-2">Sales orders: @(((IEnumerable<FoodSupply.Models.SalesOrder>)(ViewBag.SalesOrders ?? new List<FoodSupply.Models.SalesOrder>())).Count())</p>
                    <p class="mb-2">Invoices: @(((IEnumerable<FoodSupply.Models.Billing>)(ViewBag.Billings ?? new List<FoodSupply.Models.Billing>())).Count())</p>
                    <p class="mb-2">Deliveries: @(((IEnumerable<FoodSupply.Models.Delivery>)(ViewBag.Deliveries ?? new List<FoodSupply.Models.Delivery>())).Count())</p>
                    <p class="mb-0">Next follow-up: @(Model.NextFollowUpDate?.ToString("MMM dd, yyyy") ?? "Not scheduled")</p>
                </div>
            </div>

        </div>
    </div>

</div>