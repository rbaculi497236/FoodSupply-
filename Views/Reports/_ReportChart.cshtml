@model FoodSupply.Models.ReportChartViewModel
@using System.Globalization
@{
    var maximum = Model.Points.Count > 0 ? Model.Points.Max(p => Math.Abs(p.Value)) : 0;
    string Number(decimal value) => value.ToString("0.###", CultureInfo.InvariantCulture);
    string Amount(decimal value) => Model.Currency ? "PHP " + value.ToString("N2") : value.ToString("N0");
}
<section class="card shadow-sm border-0 mb-4 report-chart" aria-label="@Model.Title">
    <div class="card-body p-4">
        <h2 class="h5 fw-bold">@Model.Title</h2>
        <p class="text-muted small">@Model.Description All matching records are included, across all table pages.</p>
        @if (Model.Points.Count == 0 || maximum == 0)
        {
            <p class="text-muted mb-0">No chart data for the selected filters.</p>
        }
        else if (Model.Type == "Line")
        {
            var points = Model.Points.OrderBy(p => p.Label).ToList();
            var firstMonth = DateTime.ParseExact(points.First().Label, "yyyy-MM", CultureInfo.InvariantCulture);
            var lastMonth = DateTime.ParseExact(points.Last().Label, "yyyy-MM", CultureInfo.InvariantCulture);
            var monthCount = (lastMonth.Year - firstMonth.Year) * 12 + lastMonth.Month - firstMonth.Month;
            var values = points.ToDictionary(p => p.Label, p => p.Value);
            var series = Enumerable.Range(0, monthCount + 1).Select(i => new FoodSupply.Models.ReportChartPoint {
                Label = firstMonth.AddMonths(i).ToString("yyyy-MM"),
                Value = values.GetValueOrDefault(firstMonth.AddMonths(i).ToString("yyyy-MM"))
            }).ToList();
            var minimum = Math.Min(0, series.Min(p => p.Value));
            var top = Math.Max(0, series.Max(p => p.Value));
            decimal X(int index) => series.Count == 1 ? 400 : 30 + index * 740m / (series.Count - 1);
            decimal Y(decimal value) => 230 - (value - minimum) / (top - minimum) * 200;
            var coordinates = string.Join(" ", series.Select((p, i) => $"{Number(X(i))},{Number(Y(p.Value))}"));
            <div class="report-line-scale"><span>@Amount(top)</span><span>Monthly delivered sales</span></div>
            <svg class="report-line-chart" viewBox="0 0 800 260" role="img" aria-label="Monthly sales trend. Exact monthly values are listed below.">
                <path d="M30 30H770 M30 130H770 M30 230H770" stroke="#dfe7ee" fill="none" />
                <polyline points="@coordinates" fill="none" stroke="#123d68" stroke-width="3" stroke-linejoin="round" />
                @for (var i = 0; i < series.Count; i++)
                {
                    <circle cx="@Number(X(i))" cy="@Number(Y(series[i].Value))" r="4" fill="#4b9b28"><title>@series[i].Label: @Amount(series[i].Value)</title></circle>
                }
            </svg>
            <div class="report-line-scale"><span>@Amount(minimum)</span></div>
            <div class="report-line-scale"><span>@series.First().Label</span><span>@series.Last().Label</span></div>
            <p class="small text-muted mt-2">Months between the first and last result without delivered orders are shown as zero.</p>
            <details class="mt-3">
                <summary>View exact monthly values</summary>
                <dl class="report-chart-values mt-3">
                    @foreach (var point in series)
                    {
                        <div><dt>@point.Label</dt><dd>@Amount(point.Value)</dd></div>
                    }
                </dl>
            </details>
        }
        else if (Model.Type == "Doughnut" && Model.Points.All(p => p.Value >= 0))
        {
            var total = Model.Points.Sum(p => p.Value);
            decimal offset = 0;
            var colors = new[] { "#4b9b28", "#123d68" };
            <div class="report-doughnut-layout">
                <svg class="report-doughnut" viewBox="0 0 240 240" role="img" aria-label="Paid versus outstanding amounts. Exact values and percentages are listed alongside.">
                    @for (var i = 0; i < Model.Points.Count; i++)
                    {
                        var point = Model.Points[i];
                        var share = point.Value / total * 100;
                        <circle cx="120" cy="120" r="85" fill="none" stroke="@colors[i % colors.Length]" stroke-width="32" pathLength="100" stroke-dasharray="@Number(share) @Number(100 - share)" stroke-dashoffset="@Number(-offset)" transform="rotate(-90 120 120)"><title>@point.Label: @Amount(point.Value) (@share.ToString("0.0")%)</title></circle>
                        offset += share;
                    }
                </svg>
                <div>
                    <p class="fw-bold">Total: @Amount(total)</p>
                    <dl class="report-chart-values">
                        @for (var i = 0; i < Model.Points.Count; i++)
                        {
                            var point = Model.Points[i];
                            <div><dt><span class="report-chart-key" style="background: @colors[i % colors.Length]" aria-hidden="true"></span>@point.Label</dt><dd>@Amount(point.Value) (@((point.Value / total * 100).ToString("0.0"))%)</dd></div>
                        }
                    </dl>
                </div>
            </div>
        }
        else
        {
            <div class="report-chart-bars">
                @foreach (var point in Model.Points)
                {
                    var width = (Math.Abs(point.Value) / maximum * 100).ToString("0.##", CultureInfo.InvariantCulture);
                    var formatted = Model.Currency ? "₱" + point.Value.ToString("N2") : point.Value.ToString("N0");
                    <div class="report-chart-row">
                        <div class="report-chart-label">@point.Label</div>
                        <div class="report-chart-track" aria-hidden="true"><div class="report-chart-bar" style="width: @(width)%"></div></div>
                        <div class="report-chart-value">@formatted</div>
                    </div>
                }
            </div>
        }
    </div>
</section>
