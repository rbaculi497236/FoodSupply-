@model IEnumerable<FoodSupply.Models.Product>

@{
ViewData["Title"] = "Products";
var canEditProducts = User.IsInRole("Admin") || User.IsInRole("Manager") || User.IsInRole("Main Admin") || User.IsInRole("Warehouse Staff");
}

<h1>Products</h1>

<p>
    @if (canEditProducts)
    {
        <a asp-action="Create" class="btn btn-primary">Add Product</a>
    }

    @if (canEditProducts)
    {
        <a asp-action="Archived" class="btn btn-secondary">Archived Products</a>
    }

</p>

@await Html.PartialAsync("_TableTools")

@if (TempData["Success"] is string message) {
    <div class="alert alert-success" role="status"><i class="bi bi-check-circle me-2"></i>@message</div>
}

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Product Code</th>
            <th>Product Name</th>
            <th>Category</th>
            <th>Unit</th>
            <th>Pack</th>
            <th>Price</th>
            <th>Stock</th>
            <th>Reorder Level</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>

<tbody>
    @if (!Model.Any()) {
        <tr><td colspan="10"><div class="empty-state p-4 text-center">
            <i class="bi bi-box-seam fs-1" aria-hidden="true"></i>
            <h2 class="h5 mt-2">@(string.IsNullOrWhiteSpace((string?)ViewBag.Search) ? "Your catalogue starts here" : "No products match your search")</h2>
            <p class="text-muted">@(string.IsNullOrWhiteSpace((string?)ViewBag.Search) ? "Add your first product to start organizing your stock." : "Try a product name, code, or unit, or clear the search.")</p>
            @if (!string.IsNullOrWhiteSpace((string?)ViewBag.Search)) { <a asp-action="Index" class="btn btn-outline-primary">Clear search</a> }
            else if (canEditProducts) { <a asp-action="Create" class="btn btn-primary">Add your first product</a> }
        </div></td></tr>
    }
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.ProductCode</td>
            <td><div class="d-flex align-items-center gap-2"><partial name="_ProductPhoto" model="item" /><span>@item.ProductName</span></div></td>
            <td>@(item.Category?.CategoryName ?? "Uncategorized")</td>
            <td>@item.Unit</td>
            <td>@item.Boxes box(es) / @item.PiecesPerBox pcs</td>
            <td>@item.Price.ToString("N2")</td>
            <td>@item.StockQuantity @if (item.StockQuantity <= item.ReorderLevel) { <span class="badge bg-warning text-dark">Low stock</span> }</td>
            <td>@item.ReorderLevel</td>
            <td><partial name="_StatusBadge" model="item.Status" /></td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id"
                   class="btn btn-info btn-sm">Details</a>

                @if (canEditProducts)
                {
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="Archive" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Archive</a>
                }
            </td>
        </tr>
    }
</tbody>

</table>
