@model FoodSupply.Models.Product

@{
ViewData["Title"] = "Product Details";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">
                <i class="bi bi-box-seam text-primary me-2"></i>
                Product Details
            </h1>
            <p class="text-muted mb-0">View complete product information</p>
        </div>

    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>
        Back to Products
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">

        <div class="row g-4">

            <div class="col-md-6">
                <div class="text-muted small">Product Code</div>
                <div class="fs-5 fw-semibold">@Model.ProductCode</div>
            </div>

            <div class="col-md-6">
                <div class="text-muted small">Product Name</div>
                <div class="fs-5 fw-semibold">@Model.ProductName</div>
            </div>

            <div class="col-12">
                <div class="text-muted small">Description</div>
                <div>
                    @(string.IsNullOrWhiteSpace(Model.Description)
                        ? "No description provided."
                        : Model.Description)
                </div>
            </div>

            <div class="col-md-4">
                <div class="text-muted small">Category</div>
                <div class="fw-semibold">@Model.Category</div>
            </div>

            <div class="col-md-4">
                <div class="text-muted small">Unit</div>
                <div class="fw-semibold">@Model.Unit</div>
            </div>

            <div class="col-md-4">
                <div class="text-muted small">Price</div>
                <div class="fw-semibold">
                    ₱@Model.Price.ToString("N2")
                </div>
            </div>

            <div class="col-md-4">
                <div class="text-muted small">Stock Quantity</div>
                <div class="fw-semibold">@Model.StockQuantity</div>
            </div>

            <div class="col-md-4">
                <div class="text-muted small">Reorder Level</div>
                <div class="fw-semibold">@Model.ReorderLevel</div>
            </div>

            <div class="col-md-4">
                <div class="text-muted small">Expiration Date</div>
                <div class="fw-semibold">
                    @(Model.ExpirationDate?.ToString("MMMM dd, yyyy") ?? "N/A")
                </div>
            </div>

            <div class="col-md-6">
                <div class="text-muted small">Status</div>

                @if (Model.Status == "Active")
                {
                    <span class="badge bg-success">Active</span>
                }
                else
                {
                    <span class="badge bg-secondary">@Model.Status</span>
                }
            </div>

            <div class="col-md-6">
                <div class="text-muted small">Product ID</div>
                <div class="fw-semibold">@Model.Id</div>
            </div>

        </div>

        <hr class="my-4" />

        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Back
            </a>

            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-pencil-square me-1"></i>
                Edit Product
            </a>

            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                <i class="bi bi-trash me-1"></i>
                Delete
            </a>
        </div>

    </div>
</div>

</div>
