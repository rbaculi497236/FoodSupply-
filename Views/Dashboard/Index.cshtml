@model FoodSupply.Models.DashboardViewModel

@{
ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">

<!-- HEADER -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold mb-1">
            <i class="bi bi-speedometer2 text-primary me-2"></i>
            Dashboard
        </h1>

        <p class="text-muted mb-0">
            Welcome to your FoodSupply ERP dashboard.
        </p>
    </div>

    <div>
        <span class="text-muted">
            <i class="bi bi-calendar3 me-1"></i>
            @DateTime.Now.ToString("MMMM dd, yyyy")
        </span>
    </div>
</div>


<!-- SUMMARY CARDS -->
<div class="row g-4 mb-4">

    <!-- Products -->
    <div class="col-xl col-md-6">
        <div class="card dashboard-card shadow-sm border-0 h-100">
            <div class="card-body">

                <div class="d-flex justify-content-between">
                    <div>
                        <p class="text-muted mb-1">
                            Total Products
                        </p>

                        <h2 class="fw-bold mb-0">
                            @Model.TotalProducts
                        </h2>
                    </div>

                    <div class="dashboard-icon bg-primary-subtle text-primary">
                        <i class="bi bi-box-seam"></i>
                    </div>
                </div>

                <a asp-controller="Products"
                   asp-action="Index"
                   class="small text-decoration-none">
                    View Products
                    <i class="bi bi-arrow-right"></i>
                </a>

            </div>
        </div>
    </div>


    <!-- Customers -->
    <div class="col-xl col-md-6">
        <div class="card dashboard-card shadow-sm border-0 h-100">
            <div class="card-body">

                <div class="d-flex justify-content-between">
                    <div>
                        <p class="text-muted mb-1">
                            Customers
                        </p>

                        <h2 class="fw-bold mb-0">
                            @Model.TotalCustomers
                        </h2>
                    </div>

                    <div class="dashboard-icon bg-success-subtle text-success">
                        <i class="bi bi-people"></i>
                    </div>
                </div>

                <a asp-controller="Customers"
                   asp-action="Index"
                   class="small text-decoration-none">
                    View Customers
                    <i class="bi bi-arrow-right"></i>
                </a>

            </div>
        </div>
    </div>


    <!-- Suppliers -->
    <div class="col-xl col-md-6">
        <div class="card dashboard-card shadow-sm border-0 h-100">
            <div class="card-body">

                <div class="d-flex justify-content-between">
                    <div>
                        <p class="text-muted mb-1">
                            Suppliers
                        </p>

                        <h2 class="fw-bold mb-0">
                            @Model.TotalSuppliers
                        </h2>
                    </div>

                    <div class="dashboard-icon bg-warning-subtle text-warning">
                        <i class="bi bi-truck"></i>
                    </div>
                </div>

                <a asp-controller="Suppliers"
                   asp-action="Index"
                   class="small text-decoration-none">
                    View Suppliers
                    <i class="bi bi-arrow-right"></i>
                </a>

            </div>
        </div>
    </div>


    <!-- Categories -->
    <div class="col-xl col-md-6">
        <div class="card dashboard-card shadow-sm border-0 h-100">
            <div class="card-body">

                <div class="d-flex justify-content-between">
                    <div>
                        <p class="text-muted mb-1">
                            Categories
                        </p>

                        <h2 class="fw-bold mb-0">
                            @Model.TotalCategories
                        </h2>
                    </div>

                    <div class="dashboard-icon bg-info-subtle text-info">
                        <i class="bi bi-tags"></i>
                    </div>
                </div>

                <a asp-controller="Categories"
                   asp-action="Index"
                   class="small text-decoration-none">
                    View Categories
                    <i class="bi bi-arrow-right"></i>
                </a>

            </div>
        </div>
    </div>


    <!-- Users -->
    <div class="col-xl col-md-6">
        <div class="card dashboard-card shadow-sm border-0 h-100">
            <div class="card-body">

                <div class="d-flex justify-content-between">
                    <div>
                        <p class="text-muted mb-1">
                            System Users
                        </p>

                        <h2 class="fw-bold mb-0">
                            @Model.TotalUsers
                        </h2>
                    </div>

                    <div class="dashboard-icon bg-danger-subtle text-danger">
                        <i class="bi bi-person-gear"></i>
                    </div>
                </div>

                <a asp-controller="Users"
                   asp-action="Index"
                   class="small text-decoration-none">
                    Manage Users
                    <i class="bi bi-arrow-right"></i>
                </a>

            </div>
        </div>
    </div>

</div>


<!-- SALES / BILLING -->
<div class="row g-4 mb-4">

    <!-- Total Sales -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">

                <div class="d-flex align-items-center mb-3">

                    <div class="dashboard-icon bg-primary-subtle text-primary me-3">
                        <i class="bi bi-cash-stack"></i>
                    </div>

                    <div>
                        <h6 class="text-muted mb-0">
                            Total Sales
                        </h6>

                        <h3 class="fw-bold mb-0">
                            ₱@Model.TotalSales.ToString("N2")
                        </h3>
                    </div>

                </div>

                <div class="progress" style="height: 7px;">
                    <div class="progress-bar"
                         role="progressbar"
                         style="width: 100%;">
                    </div>
                </div>

                <div class="mt-3">
                    <span class="text-muted">
                        All active sales orders
                    </span>
                </div>

            </div>
        </div>
    </div>


    <!-- Total Paid -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">

                <div class="d-flex align-items-center mb-3">

                    <div class="dashboard-icon bg-success-subtle text-success me-3">
                        <i class="bi bi-check-circle"></i>
                    </div>

                    <div>
                        <h6 class="text-muted mb-0">
                            Total Paid
                        </h6>

                        <h3 class="fw-bold mb-0">
                            ₱@Model.TotalPaid.ToString("N2")
                        </h3>
                    </div>

                </div>

                <p class="text-success mb-0">
                    <i class="bi bi-arrow-up"></i>
                    Payments received
                </p>

            </div>
        </div>
    </div>


    <!-- Outstanding -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">

                <div class="d-flex align-items-center mb-3">

                    <div class="dashboard-icon bg-danger-subtle text-danger me-3">
                        <i class="bi bi-exclamation-circle"></i>
                    </div>

                    <div>
                        <h6 class="text-muted mb-0">
                            Outstanding Balance
                        </h6>

                        <h3 class="fw-bold mb-0">
                            ₱@Model.OutstandingBalance.ToString("N2")
                        </h3>
                    </div>

                </div>

                <a asp-controller="Billings"
                   asp-action="Index"
                   class="text-danger text-decoration-none">
                    View Invoices
                    <i class="bi bi-arrow-right"></i>
                </a>

            </div>
        </div>
    </div>

</div>


<!-- OPERATIONS -->
<div class="row g-4 mb-4">

    <!-- Inventory -->
    <div class="col-lg-3 col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-body">

                <h6 class="text-muted">
                    <i class="bi bi-boxes me-2"></i>
                    Inventory
                </h6>

                <h2 class="fw-bold text-danger">
                    @Model.LowStockProducts
                </h2>

                <p class="mb-0">
                    Low-stock products
                </p>

            </div>
        </div>
    </div>


    <!-- Sales Orders -->
    <div class="col-lg-3 col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-body">

                <h6 class="text-muted">
                    <i class="bi bi-cart me-2"></i>
                    Sales Orders
                </h6>

                <h2 class="fw-bold text-warning">
                    @Model.PendingSalesOrders
                </h2>

                <p class="mb-0">
                    Pending / processing
                </p>

            </div>
        </div>
    </div>


    <!-- Deliveries -->
    <div class="col-lg-3 col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-body">

                <h6 class="text-muted">
                    <i class="bi bi-truck me-2"></i>
                    Deliveries
                </h6>

                <h2 class="fw-bold text-info">
                    @Model.PendingDeliveries
                </h2>

                <p class="mb-0">
                    Pending deliveries
                </p>

            </div>
        </div>
    </div>


    <!-- Invoices -->
    <div class="col-lg-3 col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-body">

                <h6 class="text-muted">
                    <i class="bi bi-receipt me-2"></i>
                    Invoices
                </h6>

                <h2 class="fw-bold text-danger">
                    @Model.UnpaidInvoices
                </h2>

                <p class="mb-0">
                    Unpaid invoices
                </p>

            </div>
        </div>
    </div>

</div>


<!-- RECENT SALES ORDERS -->
<div class="row g-4">

    <div class="col-lg-7">

        <div class="card shadow-sm border-0">

            <div class="card-header bg-white border-0 py-3">

                <div class="d-flex justify-content-between align-items-center">

                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-cart-check text-primary me-2"></i>
                        Recent Sales Orders
                    </h5>

                    <a asp-controller="SalesOrders"
                       asp-action="Index"
                       class="btn btn-sm btn-outline-primary">
                        View All
                    </a>

                </div>

            </div>

            <div class="card-body p-0">

                @if (Model.RecentSalesOrders.Any())
                {
                    <div class="table-responsive">

                        <table class="table table-hover align-middle mb-0">

                            <thead class="table-light">
                                <tr>
                                    <th>Order #</th>
                                    <th>Customer</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var order in Model.RecentSalesOrders)
                                {
                                    <tr>

                                        <td>
                                            <strong>
                                                #@order.Id
                                            </strong>
                                        </td>

                                        <td>
                                            @(order.Customer?.CustomerName ?? "N/A")
                                        </td>

                                        <td>
                                            @order.OrderDate.ToString("MMM dd, yyyy")
                                        </td>

                                        <td>

                                            @if (order.Status == "Delivered")
                                            {
                                                <span class="badge bg-success">
                                                    Delivered
                                                </span>
                                            }
                                            else if (order.Status == "Processing")
                                            {
                                                <span class="badge bg-warning text-dark">
                                                    Processing
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">
                                                    @order.Status
                                                </span>
                                            }

                                        </td>

                                        <td class="text-end fw-semibold">
                                            ₱@order.TotalAmount.ToString("N2")
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <div class="text-center p-4 text-muted">

                        <i class="bi bi-cart-x fs-2"></i>

                        <p class="mt-2 mb-0">
                            No sales orders yet.
                        </p>

                    </div>
                }

            </div>

        </div>

    </div>


    <!-- RECENT INVOICES -->
    <div class="col-lg-5">

        <div class="card shadow-sm border-0">

            <div class="card-header bg-white border-0 py-3">

                <div class="d-flex justify-content-between align-items-center">

                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-receipt text-success me-2"></i>
                        Recent Invoices
                    </h5>

                    <a asp-controller="Billings"
                       asp-action="Index"
                       class="btn btn-sm btn-outline-success">
                        View All
                    </a>

                </div>

            </div>

            <div class="card-body">

                @if (Model.RecentBillings.Any())
                {
                    foreach (var billing in Model.RecentBillings)
                    {
                        <div class="d-flex justify-content-between align-items-center border-bottom py-3">

                            <div>

                                <div class="fw-semibold">
                                    @billing.InvoiceNumber
                                </div>

                                <small class="text-muted">
                                    @billing.InvoiceDate.ToString("MMM dd, yyyy")
                                </small>

                            </div>

                            <div class="text-end">

                                <div class="fw-semibold">
                                    ₱@billing.TotalAmount.ToString("N2")
                                </div>

                                @if (billing.PaymentStatus == "Paid")
                                {
                                    <span class="badge bg-success">
                                        Paid
                                    </span>
                                }
                                else if (billing.PaymentStatus == "Partially Paid")
                                {
                                    <span class="badge bg-warning text-dark">
                                        Partially Paid
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Unpaid
                                    </span>
                                }

                            </div>

                        </div>
                    }
                }
                else
                {
                    <div class="text-center p-4 text-muted">

                        <i class="bi bi-receipt fs-2"></i>

                        <p class="mt-2 mb-0">
                            No invoices yet.
                        </p>

                    </div>
                }

            </div>

        </div>

    </div>

</div>

</div>

<style>

    .dashboard-card {
        transition: all 0.2s ease-in-out;
    }

    .dashboard-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.12) !important;
    }

    .dashboard-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;

        display: flex;
        align-items: center;
        justify-content: center;

        font-size: 22px;
    }

    .card {
        border-radius: 12px;
    }

    .table th {
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: .3px;
    }

</style>
