@model FoodSupply.Models.DashboardViewModel
@inject IConfiguration Configuration

@{
    ViewData["Title"] = "Dashboard";

    var weatherLocation = Configuration["Weather:LocationName"] ?? "Manila, Philippines";
    var weatherLatitude = Configuration["Weather:Latitude"] ?? "14.5995";
    var weatherLongitude = Configuration["Weather:Longitude"] ?? "120.9842";
    var weatherTimezone = Configuration["Weather:Timezone"] ?? "Asia/Manila";
}

<div class="dashboard-page">

    <!-- ================= HEADER ================= -->
    <div class="dashboard-header">
        <div>
            <div class="dashboard-title">
                <div class="title-icon">
                    <i class="bi bi-speedometer2"></i>
                </div>

                <div>
                    <h1>Dashboard</h1>
                    <p>Welcome to your FoodSupply ERP dashboard.</p>
                </div>
            </div>
        </div>

        <div class="dashboard-date">
            <i class="bi bi-calendar3"></i>
            @DateTime.Now.ToString("MMMM dd, yyyy")
        </div>
    </div>


    <!-- ================= WEATHER ================= -->
    <div class="weather-card"
         id="weather-card"
         data-location="@weatherLocation"
         data-latitude="@weatherLatitude"
         data-longitude="@weatherLongitude"
         data-timezone="@weatherTimezone">

        <div class="weather-header">
            <div>
                <h5>
                    <i class="bi bi-cloud-sun"></i>
                    Weather
                </h5>

                <span id="weather-updated">
                    Loading current conditions...
                </span>
            </div>

            <button type="button"
                    class="weather-refresh"
                    id="refresh-weather"
                    aria-label="Refresh weather">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
        </div>

        <div id="weather-content" class="weather-content">
            <div class="text-muted small">
                Retrieving forecast...
            </div>
        </div>
    </div>


    <!-- ================= OVERVIEW ================= -->
    <div class="section-heading">
        <div>
            <span class="section-label">OVERVIEW</span>
            <h4>Business Overview</h4>
        </div>
    </div>

    <div class="overview-grid">

        <!-- PRODUCTS -->
        <a asp-controller="Products"
           asp-action="Index"
           class="overview-card">

            <div class="overview-icon blue">
                <i class="bi bi-box-seam"></i>
            </div>

            <div class="overview-info">
                <span>Total Products</span>
                <strong>@Model.TotalProducts</strong>
                <small>View products <i class="bi bi-arrow-right"></i></small>
            </div>
        </a>


        <!-- CUSTOMERS -->
        <a asp-controller="Customers"
           asp-action="Index"
           class="overview-card">

            <div class="overview-icon green">
                <i class="bi bi-people"></i>
            </div>

            <div class="overview-info">
                <span>Customers</span>
                <strong>@Model.TotalCustomers</strong>
                <small>View customers <i class="bi bi-arrow-right"></i></small>
            </div>
        </a>


        <!-- SUPPLIERS -->
        <a asp-controller="Suppliers"
           asp-action="Index"
           class="overview-card">

            <div class="overview-icon orange">
                <i class="bi bi-truck"></i>
            </div>

            <div class="overview-info">
                <span>Suppliers</span>
                <strong>@Model.TotalSuppliers</strong>
                <small>View suppliers <i class="bi bi-arrow-right"></i></small>
            </div>
        </a>


        <!-- CATEGORIES -->
        <a asp-controller="Categories"
           asp-action="Index"
           class="overview-card">

            <div class="overview-icon cyan">
                <i class="bi bi-tags"></i>
            </div>

            <div class="overview-info">
                <span>Categories</span>
                <strong>@Model.TotalCategories</strong>
                <small>View categories <i class="bi bi-arrow-right"></i></small>
            </div>
        </a>


        <!-- USERS -->
        <a asp-controller="Users"
           asp-action="Index"
           class="overview-card">

            <div class="overview-icon purple">
                <i class="bi bi-person-gear"></i>
            </div>

            <div class="overview-info">
                <span>System Users</span>
                <strong>@Model.TotalUsers</strong>
                <small>Manage users <i class="bi bi-arrow-right"></i></small>
            </div>
        </a>

    </div>


    <!-- ================= FINANCIAL ================= -->
    <div class="section-heading financial-heading">
        <div>
            <span class="section-label">FINANCIAL</span>
            <h4>Financial Summary</h4>
        </div>
    </div>

    <div class="financial-grid">

        <!-- TOTAL SALES -->
        <div class="financial-card sales-card">

            <div class="financial-top">
                <div class="financial-icon blue">
                    <i class="bi bi-cash-stack"></i>
                </div>

                <span>Delivered order value</span>
            </div>

            <div class="financial-value">
                ₱@Model.TotalSales.ToString("N2")
            </div>

            <div class="financial-footer">
                <span>
                    <i class="bi bi-graph-up"></i>
                    All active sales orders
                </span>
            </div>

        </div>


        <!-- TOTAL PAID -->
        <div class="financial-card paid-card">

            <div class="financial-top">
                <div class="financial-icon green">
                    <i class="bi bi-check-circle"></i>
                </div>

                <span>Total Paid</span>
            </div>

            <div class="financial-value">
                ₱@Model.TotalPaid.ToString("N2")
            </div>

            <div class="financial-footer success">
                <i class="bi bi-arrow-up"></i>
                Payments received
            </div>

        </div>


        <!-- OUTSTANDING -->
        <a asp-controller="Billings"
           asp-action="Index"
           class="financial-card outstanding-card">

            <div class="financial-top">
                <div class="financial-icon red">
                    <i class="bi bi-exclamation-circle"></i>
                </div>

                <span>Outstanding Balance</span>
            </div>

            <div class="financial-value">
                ₱@Model.OutstandingBalance.ToString("N2")
            </div>

            <div class="financial-footer danger">
                View invoices
                <i class="bi bi-arrow-right"></i>
            </div>

        </a>

    </div>


    <!-- ================= OPERATIONS ================= -->
    <div class="section-heading">
        <div>
            <span class="section-label">OPERATIONS</span>
            <h4>Current Status</h4>
        </div>
    </div>

    <div class="operations-grid">

        <!-- INVENTORY -->
        <div class="status-card">

            <div class="status-icon red">
                <i class="bi bi-boxes"></i>
            </div>

            <div>
                <span>Inventory</span>

                <strong class="danger-number">
                    @Model.LowStockProducts
                </strong>

                <small>Low-stock products</small>
            </div>

        </div>


        <!-- SALES ORDERS -->
        <div class="status-card">

            <div class="status-icon orange">
                <i class="bi bi-cart"></i>
            </div>

            <div>
                <span>Sales Orders</span>

                <strong class="warning-number">
                    @Model.PendingSalesOrders
                </strong>

                <small>Pending / processing</small>
            </div>

        </div>


        <!-- DELIVERIES -->
        <div class="status-card">

            <div class="status-icon blue">
                <i class="bi bi-truck"></i>
            </div>

            <div>
                <span>Deliveries</span>

                <strong class="blue-number">
                    @Model.PendingDeliveries
                </strong>

                <small>Pending deliveries</small>
            </div>

        </div>


        <!-- INVOICES -->
        <div class="status-card">

            <div class="status-icon red">
                <i class="bi bi-receipt"></i>
            </div>

            <div>
                <span>Invoices</span>

                <strong class="danger-number">
                    @Model.UnpaidInvoices
                </strong>

                <small>Unpaid invoices</small>
            </div>

        </div>

    </div>


    <!-- ================= RECENT ACTIVITY ================= -->
    <div class="section-heading activity-heading">
        <div>
            <span class="section-label">RECENT ACTIVITY</span>
            <h4>Latest Transactions</h4>
        </div>
    </div>


    <div class="activity-grid">

        <!-- RECENT SALES ORDERS -->
        <div class="activity-card">

            <div class="activity-header">

                <div class="activity-title">
                    <div class="activity-icon blue">
                        <i class="bi bi-cart-check"></i>
                    </div>

                    <div>
                        <h5>Recent Sales Orders</h5>
                        <span>Latest customer orders</span>
                    </div>
                </div>

                <a asp-controller="SalesOrders"
                   asp-action="Index"
                   class="view-button">
                    View All
                </a>

            </div>


            <div class="table-wrapper">

                @if (Model.RecentSalesOrders.Any())
                {
                    <table class="dashboard-table">

                        <thead>
                            <tr>
                                <th>ORDER</th>
                                <th>CUSTOMER</th>
                                <th>DATE</th>
                                <th>STATUS</th>
                                <th class="text-end">TOTAL</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var order in Model.RecentSalesOrders)
                            {
                                <tr>

                                    <td>
                                        <strong>#@order.Id</strong>
                                    </td>

                                    <td>
                                        @(order.Customer?.CustomerName ?? "N/A")
                                    </td>

                                    <td>
                                        @order.OrderDate.ToString("MMM dd, yyyy")
                                    </td>

                                    <td>

                                        @if (order.Status == "Delivered")
                                        {
                                            <span class="status-badge success">
                                                Delivered
                                            </span>
                                        }
                                        else if (order.Status == "Processing")
                                        {
                                            <span class="status-badge warning">
                                                Processing
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge neutral">
                                                @order.Status
                                            </span>
                                        }

                                    </td>

                                    <td class="text-end">
                                        <strong>
                                            ₱@order.TotalAmount.ToString("N2")
                                        </strong>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-cart-x"></i>
                        <p>No sales orders yet.</p>
                    </div>
                }

            </div>

        </div>


        <!-- RECENT INVOICES -->
        <div class="activity-card">

            <div class="activity-header">

                <div class="activity-title">
                    <div class="activity-icon green">
                        <i class="bi bi-receipt"></i>
                    </div>

                    <div>
                        <h5>Recent Invoices</h5>
                        <span>Latest billing activity</span>
                    </div>
                </div>

                <a asp-controller="Billings"
                   asp-action="Index"
                   class="view-button green-button">
                    View All
                </a>

            </div>


            <div class="invoice-list">

                @if (Model.RecentBillings.Any())
                {
                    foreach (var billing in Model.RecentBillings)
                    {
                        <div class="invoice-item">

                            <div class="invoice-info">

                                <strong>
                                    @billing.InvoiceNumber
                                </strong>

                                <span>
                                    @billing.InvoiceDate.ToString("MMM dd, yyyy")
                                </span>

                            </div>


                            <div class="invoice-right">

                                <strong>
                                    ₱@billing.TotalAmount.ToString("N2")
                                </strong>

                                @if (billing.PaymentStatus == "Paid")
                                {
                                    <span class="status-badge success">
                                        Paid
                                    </span>
                                }
                                else if (billing.PaymentStatus == "Partially Paid")
                                {
                                    <span class="status-badge warning">
                                        Partially Paid
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge danger">
                                        Unpaid
                                    </span>
                                }

                            </div>

                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-receipt"></i>
                        <p>No invoices yet.</p>
                    </div>
                }

            </div>

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- DASHBOARD CSS -->
<!-- ========================================================= -->

<style>

    /* ---------- PAGE ---------- */

    .dashboard-page {
        padding: 8px 4px 30px;
        color: #1f2937;
    }


    /* ---------- HEADER ---------- */

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

    .dashboard-title {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .title-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: #eff6ff;
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }

    .dashboard-header h1 {
        font-size: 28px;
        font-weight: 700;
        margin: 0;
        letter-spacing: -0.5px;
    }

    .dashboard-header p {
        margin: 3px 0 0;
        color: #6b7280;
        font-size: 14px;
    }

    .dashboard-date {
        display: flex;
        align-items: center;
        gap: 7px;
        color: #6b7280;
        font-size: 13px;
    }


    /* ---------- WEATHER ---------- */

    .weather-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        padding: 18px 20px;
        margin-bottom: 28px;
        box-shadow: 0 2px 8px rgba(0,0,0,.04);
    }

    .weather-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .weather-header h5 {
        font-size: 15px;
        font-weight: 700;
        margin: 0;
    }

    .weather-header h5 i {
        color: #2563eb;
        margin-right: 7px;
    }

    .weather-header span {
        color: #9ca3af;
        font-size: 12px;
    }

    .weather-refresh {
        width: 34px;
        height: 34px;
        border: 1px solid #dbeafe;
        background: #f8fbff;
        color: #2563eb;
        border-radius: 8px;
    }

    .weather-refresh:hover {
        background: #eff6ff;
    }

    .weather-content {
        display: flex;
        align-items: center;
        margin-top: 14px;
    }

    .weather-temperature {
        font-size: 28px;
        font-weight: 700;
        line-height: 1;
    }

    .weather-day {
        padding: 0 18px;
        text-align: center;
    }

    .weather-day + .weather-day {
        border-left: 1px solid #e5e7eb;
    }


    /* ---------- SECTION HEADINGS ---------- */

    .section-heading {
        margin: 0 0 13px;
    }

    .section-label {
        display: block;
        color: #2563eb;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1px;
        margin-bottom: 2px;
    }

    .section-heading h4 {
        font-size: 17px;
        font-weight: 700;
        margin: 0;
        color: #111827;
    }

    .financial-heading,
    .activity-heading {
        margin-top: 28px;
    }


    /* ---------- OVERVIEW ---------- */

    .overview-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 14px;
    }

    .overview-card {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 17px;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        text-decoration: none;
        color: inherit;
        transition: .2s ease;
    }

    .overview-card:hover {
        transform: translateY(-2px);
        border-color: #bfdbfe;
        box-shadow: 0 5px 15px rgba(0,0,0,.06);
    }

    .overview-icon,
    .financial-icon,
    .status-icon,
    .activity-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .overview-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        font-size: 19px;
    }

    .overview-info {
        min-width: 0;
    }

    .overview-info span {
        display: block;
        color: #6b7280;
        font-size: 12px;
        margin-bottom: 2px;
    }

    .overview-info strong {
        display: block;
        font-size: 22px;
        color: #111827;
        line-height: 1.1;
    }

    .overview-info small {
        display: block;
        color: #2563eb;
        margin-top: 4px;
        font-size: 11px;
    }


    /* ---------- COLORS ---------- */

    .blue {
        background: #eff6ff;
        color: #2563eb;
    }

    .green {
        background: #ecfdf5;
        color: #059669;
    }

    .orange {
        background: #fff7ed;
        color: #ea580c;
    }

    .cyan {
        background: #ecfeff;
        color: #0891b2;
    }

    .purple {
        background: #f5f3ff;
        color: #7c3aed;
    }

    .red {
        background: #fef2f2;
        color: #dc2626;
    }


    /* ---------- FINANCIAL ---------- */

    .financial-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
    }

    .financial-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 19px;
        text-decoration: none;
        color: inherit;
        transition: .2s ease;
    }

    .financial-card:hover {
        box-shadow: 0 5px 15px rgba(0,0,0,.06);
    }

    .financial-top {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #6b7280;
        font-size: 13px;
        font-weight: 500;
    }

    .financial-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        font-size: 17px;
    }

    .financial-value {
        font-size: 25px;
        font-weight: 700;
        margin: 12px 0 8px;
        color: #111827;
    }

    .financial-footer {
        color: #6b7280;
        font-size: 12px;
    }

    .financial-footer.success {
        color: #059669;
    }

    .financial-footer.danger {
        color: #dc2626;
    }


    /* ---------- OPERATIONS ---------- */

    .operations-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
    }

    .status-card {
        display: flex;
        align-items: center;
        gap: 13px;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 16px;
    }

    .status-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        font-size: 17px;
    }

    .status-card span {
        display: block;
        color: #6b7280;
        font-size: 12px;
    }

    .status-card strong {
        display: block;
        font-size: 22px;
        line-height: 1.2;
    }

    .status-card small {
        display: block;
        color: #9ca3af;
        font-size: 11px;
    }

    .danger-number {
        color: #dc2626;
    }

    .warning-number {
        color: #d97706;
    }

    .blue-number {
        color: #2563eb;
    }


    /* ---------- ACTIVITY ---------- */

    .activity-grid {
        display: grid;
        grid-template-columns: 1.45fr 1fr;
        gap: 14px;
    }

    .activity-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        overflow: hidden;
    }

    .activity-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 18px;
        border-bottom: 1px solid #f1f5f9;
    }

    .activity-title {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .activity-icon {
        width: 38px;
        height: 38px;
        border-radius: 9px;
        font-size: 16px;
    }

    .activity-title h5 {
        margin: 0;
        font-size: 14px;
        font-weight: 700;
    }

    .activity-title span {
        color: #9ca3af;
        font-size: 11px;
    }

    .view-button {
        border: 1px solid #bfdbfe;
        color: #2563eb;
        background: #f8fbff;
        padding: 6px 11px;
        border-radius: 7px;
        text-decoration: none;
        font-size: 11px;
        font-weight: 600;
    }

    .view-button:hover {
        background: #eff6ff;
    }

    .green-button {
        border-color: #bbf7d0;
        color: #059669;
        background: #f0fdf4;
    }


    /* ---------- TABLE ---------- */

    .table-wrapper {
        overflow-x: auto;
    }

    .dashboard-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 12px;
    }

    .dashboard-table th {
        padding: 11px 15px;
        background: #f8fafc;
        color: #64748b;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .4px;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .dashboard-table td {
        padding: 12px 15px;
        border-top: 1px solid #f1f5f9;
        color: #475569;
        white-space: nowrap;
    }

    .dashboard-table tr:hover td {
        background: #fafcff;
    }


    /* ---------- BADGES ---------- */

    .status-badge {
        display: inline-block;
        padding: 4px 8px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 600;
        white-space: nowrap;
    }

    .status-badge.success {
        background: #dcfce7;
        color: #15803d;
    }

    .status-badge.warning {
        background: #fef3c7;
        color: #a16207;
    }

    .status-badge.danger {
        background: #fee2e2;
        color: #b91c1c;
    }

    .status-badge.neutral {
        background: #f1f5f9;
        color: #64748b;
    }


    /* ---------- INVOICES ---------- */

    .invoice-list {
        padding: 0 18px;
    }

    .invoice-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 14px 0;
        border-bottom: 1px solid #f1f5f9;
        gap: 15px;
    }

    .invoice-item:last-child {
        border-bottom: none;
    }

    .invoice-info strong {
        display: block;
        color: #334155;
        font-size: 12px;
    }

    .invoice-info span {
        display: block;
        color: #94a3b8;
        font-size: 11px;
        margin-top: 3px;
    }

    .invoice-right {
        text-align: right;
        flex-shrink: 0;
    }

    .invoice-right strong {
        display: block;
        color: #334155;
        font-size: 12px;
        margin-bottom: 4px;
    }


    /* ---------- EMPTY STATE ---------- */

    .empty-state {
        text-align: center;
        padding: 35px 20px;
        color: #94a3b8;
    }

    .empty-state i {
        font-size: 30px;
        display: block;
        margin-bottom: 8px;
    }

    .empty-state p {
        margin: 0;
        font-size: 12px;
    }


    /* ---------- RESPONSIVE ---------- */

    @@media (max-width: 1200px) {

        .overview-grid {
            grid-template-columns: repeat(3, 1fr);
        }

        .operations-grid {
            grid-template-columns: repeat(2, 1fr);
        }

    }


    @@media (max-width: 992px) {

        .financial-grid {
