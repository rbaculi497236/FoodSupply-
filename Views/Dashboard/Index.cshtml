</style>


@section Scripts {

<script>

    (() => {

        const card = document.getElementById('weather-card');
        const content = document.getElementById('weather-content');
        const updated = document.getElementById('weather-updated');
        const refreshButton = document.getElementById('refresh-weather');

        const weatherDescriptions = {

            0: ['Clear sky', 'bi-sun'],
            1: ['Mainly clear', 'bi-sun'],
            2: ['Partly cloudy', 'bi-cloud-sun'],
            3: ['Overcast', 'bi-cloud'],
            45: ['Foggy', 'bi-cloud-fog2'],
            48: ['Rime fog', 'bi-cloud-fog2'],
            51: ['Light drizzle', 'bi-cloud-drizzle'],
            53: ['Drizzle', 'bi-cloud-drizzle'],
            55: ['Heavy drizzle', 'bi-cloud-drizzle'],
            61: ['Light rain', 'bi-cloud-rain'],
            63: ['Rain', 'bi-cloud-rain'],
            65: ['Heavy rain', 'bi-cloud-rain-heavy'],
            71: ['Light snow', 'bi-snow'],
            73: ['Snow', 'bi-snow'],
            75: ['Heavy snow', 'bi-snow'],
            80: ['Rain showers', 'bi-cloud-rain'],
            81: ['Rain showers', 'bi-cloud-rain'],
            82: ['Heavy showers', 'bi-cloud-rain-heavy'],
            95: ['Thunderstorm', 'bi-cloud-lightning-rain'],
            96: ['Thunderstorm with hail', 'bi-cloud-lightning-rain'],
            99: ['Thunderstorm with hail', 'bi-cloud-lightning-rain']

        };


        function getWeather(code) {

            return weatherDescriptions[code]
                ?? ['Unknown conditions', 'bi-cloud'];

        }


        async function loadWeather() {

            refreshButton.disabled = true;

            content.innerHTML = `
                <div class="text-muted small">
                    Retrieving forecast...
                </div>
            `;


            const parameters = new URLSearchParams({

                latitude: card.dataset.latitude,

                longitude: card.dataset.longitude,

                timezone: card.dataset.timezone,

                forecast_days: '3',

                current:
                    'temperature_2m,relative_humidity_2m,apparent_temperature,precipitation,weather_code,wind_speed_10m',

                daily:
                    'weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max'

            });


            try {

                const response =
                    await fetch(
                        `https://api.open-meteo.com/v1/forecast?${parameters}`
                    );


                if (!response.ok) {

                    throw new Error(
                        'Weather service unavailable'
                    );

                }


                const data = await response.json();

                const current = data.current;

                const daily = data.daily;


                const [description, icon] =
                    getWeather(current.weather_code);


                const currentTime =
                    new Date(current.time)
                        .toLocaleString([], {
                            dateStyle: 'medium',
                            timeStyle: 'short'
                        });


                const forecast =
                    daily.time.map((date, index) => {

                        const [dayDescription, dayIcon] =
                            getWeather(
                                daily.weather_code[index]
                            );


                        const dayName =
                            new Date(`${date}T12:00:00`)
                                .toLocaleDateString([], {
                                    weekday: 'short'
                                });


                        return `
                            <div class="weather-day">

                                <div class="fw-semibold small">
                                    ${dayName}
                                </div>

                                <i
                                    class="bi ${dayIcon} fs-5 text-primary"
                                    aria-hidden="true">
                                </i>

                                <div class="small">
                                    ${Math.round(
                                        daily.temperature_2m_max[index]
                                    )}°
                                    /
                                    ${Math.round(
                                        daily.temperature_2m_min[index]
                                    )}°
                                </div>

                                <div class="small text-muted">
                                    <i class="bi bi-droplet"></i>
                                    ${daily.precipitation_probability_max[index]}%
                                </div>

                                <span class="visually-hidden">
                                    ${dayDescription}
                                </span>

                            </div>
                        `;

                    }).join('');


                content.innerHTML = `

                    <div class="d-flex align-items-center me-auto">

                        <i
                            class="bi ${icon} display-6 text-primary me-3"
                            aria-hidden="true">
                        </i>

                        <div>

                            <div class="weather-temperature">
                                ${Math.round(current.temperature_2m)}°C
                            </div>

                            <div class="text-muted small">
                                ${description}
                            </div>

                        </div>

                    </div>


                    <div class="d-flex align-items-center gap-3 small">

                        <span>
                            <i class="bi bi-thermometer-half text-danger"></i>
                            Feels ${Math.round(current.apparent_temperature)}°C
                        </span>

                        <span>
                            <i class="bi bi-droplet text-primary"></i>
                            ${current.relative_humidity_2m}%
                        </span>

                        <span>
                            <i class="bi bi-wind text-secondary"></i>
                            ${Math.round(current.wind_speed_10m)} km/h
                        </span>

                    </div>


                    <div class="d-flex ms-auto">

                        ${forecast}

                    </div>

                `;


                updated.textContent =
                    `Updated: ${currentTime}`;

            }

            catch (error) {

                content.innerHTML = `
                    <div class="text-danger small">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        Weather is unavailable.
                    </div>
                `;

                updated.textContent =
                    'Unable to refresh weather';

            }

            finally {

                refreshButton.disabled = false;

            }

        }


        refreshButton.addEventListener(
            'click',
            loadWeather
        );


        loadWeather();

    })();

</script>

}